---
import type { CountrySlug } from '@data/countries';
import { getDict } from '@i18n/index';

interface Props { slug: CountrySlug }
const { slug } = Astro.props;
const dict = getDict(slug);

const ICONS = ['📅', '⏰', '✅', '📝', '💰', '🛒', '💵', '📊', '🧾', '💳', '📩', '📨', '🌍', '🌤️', '💱', '🪙', '🎙️', '📸', '📄', '🔍', '🌐', '🧠', '📍', '🆔', '🗂️', '🚨', '📈', '✨'];
const TOOLS = (dict.tools?.labels ?? []).map((label: string, i: number) => ({ icon: ICONS[i] ?? '✨', label }));
const SEQ = [...TOOLS, ...TOOLS]; // duplicate for seamless loop
---
<section class="bg-ink text-paper py-24 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-12">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full liquid-glass text-turquesa-light text-xs font-bold uppercase tracking-widest">{dict.tools?.eyebrow ?? '100+ tools'}</span>
      <h2 class="mt-4 font-display text-4xl md:text-5xl font-bold tracking-tightest">{dict.tools?.title ?? 'All inside WhatsApp'}</h2>
      <p class="mt-3 text-paper/60 max-w-xl mx-auto">{dict.tools?.subtitle ?? ''}</p>
    </div>
  </div>

  <!-- Marquee row 1 -->
  <div class="tc-marquee" aria-hidden="false" role="list">
    <div class="tc-track tc-track-fwd">
      {SEQ.map((t) => (
        <div class="tc-item liquid-glass" role="listitem">
          <span class="tc-emoji" aria-hidden="true">{t.icon}</span>
          <span class="tc-label">{t.label}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Marquee row 2 (reverse) -->
  <div class="tc-marquee mt-4" aria-hidden="true">
    <div class="tc-track tc-track-rev">
      {SEQ.slice().reverse().map((t) => (
        <div class="tc-item liquid-glass">
          <span class="tc-emoji">{t.icon}</span>
          <span class="tc-label">{t.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .tc-marquee {
    position: relative;
    width: 100%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent 0, black 8%, black 92%, transparent 100%);
            mask-image: linear-gradient(to right, transparent 0, black 8%, black 92%, transparent 100%);
  }
  .tc-track {
    display: inline-flex;
    gap: 0.75rem;
    padding: 0 0.5rem;
    white-space: nowrap;
    will-change: transform;
  }
  .tc-track-fwd { animation: tc-scroll 50s linear infinite; }
  .tc-track-rev { animation: tc-scroll-rev 60s linear infinite; }
  @keyframes tc-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @keyframes tc-scroll-rev {
    from { transform: translateX(-50%); }
    to   { transform: translateX(0); }
  }
  .tc-marquee:hover .tc-track { animation-play-state: paused; }
  .tc-item {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.85rem 1.25rem;
    border-radius: 999px;
    flex-shrink: 0;
    transition: transform 0.4s var(--ease-spring), border-color 0.25s var(--ease-out-expo);
    will-change: transform;
  }
  .tc-item:hover { transform: translateY(-3px) scale(1.04); }
  @media (prefers-reduced-motion: reduce) {
    .tc-item, .tc-item:hover { transition: none; transform: none !important; }
  }
  .tc-emoji { font-size: 1.5rem; line-height: 1; }
  .tc-label {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #FAFBFF;
  }
  @media (prefers-reduced-motion: reduce) {
    .tc-track-fwd, .tc-track-rev { animation: none; }
    .tc-marquee { overflow-x: auto; -webkit-mask-image: none; mask-image: none; }
  }
</style>
