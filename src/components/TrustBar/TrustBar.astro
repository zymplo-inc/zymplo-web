---
import type { CountrySlug } from '@data/countries';
import type { Dict } from '@i18n/index';
interface Props { slug: CountrySlug; dict: Dict }
const { dict } = Astro.props;
const tb = (dict as any).trust_bar ?? {};
// R93 (2026-05-02): warm copy + no setup-time claim · works from first message
const items: Array<{ icon: string; text: string }> = tb.items ?? [
  { icon: '🌎', text: '14 countries · 3 languages' },
  { icon: '⚡', text: 'No app · no signup' },
  { icon: '🛡️', text: '100% safe & free' },
  { icon: '💚', text: 'Just WhatsApp' },
  { icon: '🧾', text: 'Receipts in seconds' },
  { icon: '⏱️', text: 'Ready in 3 minutes' },
];
// Triple the array so the marquee loops seamlessly
const looped = [...items, ...items, ...items];
---
<section class="relative bg-white border-y border-ink/8 overflow-hidden" aria-label="Live stats">
  <!-- Mobile (<640px): STATIC grid 2-col · NO scroll horizontal · todo legible · sin movimiento -->
  <div class="trust-mobile-stack sm:hidden grid grid-cols-2 gap-x-4 gap-y-2 px-5 py-3.5 max-w-md mx-auto">
    {items.map((it) => (
      <div class="flex items-center gap-1.5 text-[12px] text-slate font-semibold leading-tight">
        <span class="text-sm shrink-0">{it.icon}</span>
        <span class="truncate">{it.text}</span>
      </div>
    ))}
  </div>

  <!-- Desktop (≥640px): ticker animado infinite -->
  <div class="trust-marquee hidden sm:flex gap-10 whitespace-nowrap py-3.5 will-change-transform">
    {looped.map((it, i) => (
      <div class="flex items-center gap-2.5 text-sm text-slate font-semibold shrink-0" aria-hidden={i >= items.length}>
        <span class="text-base leading-none">{it.icon}</span>
        <span>{it.text}</span>
        <span class="text-mute/50 ml-3">·</span>
      </div>
    ))}
  </div>

  <!-- Edge fades · solo desktop (mobile no usa marquee) -->
  <div class="pointer-events-none absolute inset-y-0 left-0 w-24 bg-gradient-to-r from-white to-transparent hidden sm:block" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-y-0 right-0 w-24 bg-gradient-to-l from-white to-transparent hidden sm:block" aria-hidden="true"></div>

  <style>
    @keyframes trust-marquee {
      from { transform: translate3d(0,0,0); }
      to   { transform: translate3d(-33.3333%,0,0); }
    }
    .trust-marquee {
      animation: trust-marquee 38s linear infinite;
    }
    .trust-marquee:hover { animation-play-state: paused; }
    @media (prefers-reduced-motion: reduce) {
      .trust-marquee {
        animation: none;
        flex-wrap: wrap;
        white-space: normal;
        justify-content: center;
      }
    }
  </style>
</section>
