---
import type { CountrySlug } from '@data/countries';
import type { Dict } from '@i18n/index';
interface Props { slug: CountrySlug; dict: Dict }
const { dict } = Astro.props;
const tb = (dict as any).trust_bar ?? {};
// R93 (2026-05-02): warm copy + no setup-time claim · works from first message
const items: Array<{ icon: string; text: string }> = tb.items ?? [
  { icon: '🔥', text: '12,847 people active today' },
  { icon: '⚡', text: 'No app · no signup' },
  { icon: '🛡️', text: '100% safe & free' },
  { icon: '💚', text: 'Just WhatsApp' },
  { icon: '📈', text: '$47M billed this month' },
  { icon: '⭐', text: '4.9 rating' },
];
// Triple the array so the marquee loops seamlessly
const looped = [...items, ...items, ...items];
---
<section class="relative bg-white border-y border-ink/8 overflow-hidden" aria-label="Live stats">
  <div class="trust-marquee flex gap-6 sm:gap-10 whitespace-nowrap py-3 sm:py-3.5 will-change-transform">
    {looped.map((it, i) => (
      <div class="flex items-center gap-2 sm:gap-2.5 text-[13px] sm:text-sm text-slate font-semibold shrink-0" aria-hidden={i >= items.length}>
        <span class="text-base leading-none">{it.icon}</span>
        <span>{it.text}</span>
        <span class="text-mute/50 ml-2 sm:ml-3">·</span>
      </div>
    ))}
  </div>

  <!-- Edge fades · narrower on mobile so text isn't truncated -->
  <div class="pointer-events-none absolute inset-y-0 left-0 w-6 sm:w-24 bg-gradient-to-r from-white to-transparent" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-y-0 right-0 w-6 sm:w-24 bg-gradient-to-l from-white to-transparent" aria-hidden="true"></div>

  <style>
    @keyframes trust-marquee {
      from { transform: translate3d(0,0,0); }
      to   { transform: translate3d(-33.3333%,0,0); }
    }
    .trust-marquee {
      /* Mobile faster · 22s vs desktop 38s · texto pasa más rápido y se lee completo en una pasada */
      animation: trust-marquee 22s linear infinite;
    }
    @media (min-width: 640px) {
      .trust-marquee { animation-duration: 38s; }
    }
    .trust-marquee:hover { animation-play-state: paused; }
    /* Tap-to-pause on mobile · user can stop and read */
    .trust-marquee:active { animation-play-state: paused; }
    @media (prefers-reduced-motion: reduce) {
      .trust-marquee {
        animation: none;
        flex-wrap: wrap;
        white-space: normal;
        justify-content: center;
      }
    }
  </style>
</section>
