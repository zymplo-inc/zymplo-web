<header>
  <a href="https://zymplo.com/"><img src="https://sims.zymplo.com/brand/isotipo.svg" alt="Zymplo" /></a>
  <h1>Política de cookies</h1>
  <p class="meta">Última actualización: {meta.lastUpdated}</p>
  <p class="meta">Español · <a href="https://zymplo.com/pt/legal/cookies/">Português</a> · <a href="https://zymplo.com/en/legal/cookies/">English</a></p>
