---
// Conteúdo legal PT-BR · Conformidade regulatória · copiado verbatim de src/pages/pt/legal/compliance.astro
export const meta = {
  title: 'Conformidade regulatória · Zymplo',
  description: 'Conformidade regulatória do Zymplo em cada país de operação: LGPD · GDPR · CCPA · LFPDPPP · etc.',
  lastUpdated: '2026-11-02',
};
// OPS fix(links): `base` es el prefijo (país o idioma) del contexto donde
// se renderiza este documento — '' en el apex ES, '/en' o '/pt' en el apex
// de idioma, '/{slug}' bajo /[country]/legal/*. Todo link interno "mismo
// contexto, otro documento" tiene que pasar por acá — un valor fijo tipo
// '/legal/...' ignora el contexto y manda siempre al documento en español
// del apex (medido 2026-08-18: br.zymplo.com/legal/privacy/ → lang=es).
export interface Props { base: string }
const { base } = Astro.props;

---
<header>
  <a href="https://zymplo.com/"><img src="/brand/isotipo.svg" alt="Zymplo" /></a>
  <h1>Conformidade regulatória</h1>
  <p class="meta">Última atualização: {meta.lastUpdated}</p>
  <p class="meta"><a href="https://zymplo.com/legal/compliance/">Español</a> · Português · <a href="https://zymplo.com/en/legal/compliance/">English</a></p>
</header>

<p>O Zymplo opera em 13 países. Aqui estão as leis de proteção de dados e de faturamento que usamos como referência em cada um.</p>

<h2>1. Estrutura corporativa</h2>
<ul>
  <li><strong>Zymplo Inc.</strong> · Delaware USA · EIN 30-1486305 · DUNS 145007664</li><li><strong>Zymplo Brasil LTDA</strong> · CNPJ 66.667.634/0001-00 · Fortaleza CE · subsidiária operacional Brasil</li><li><strong>Zymplo S.A.</strong> · RUC 80170149-0 · San Lorenzo · empresa operacional Paraguai</li><li>Banking principal: Mercury Bank (USA)</li>
  <li>Processamento de pagamentos: Stripe Atlas (USA) · Stripe Brasil (BR) · Mercado Pago (LATAM)</li>
</ul>

<h2>2. Leis de referência por país</h2>
<table>
  <thead><tr><th>País</th><th>Privacidade</th><th>Tributário / faturamento</th></tr></thead>
  <tbody>
    <tr><td>🇧🇷 Brasil</td><td>LGPD (Lei 13.709/2018) · ANPD</td><td>NFS-e municipal · MEI · DAS · CPF/CNPJ</td></tr>
    <tr><td>🇲🇽 México</td><td>LFPDPPP · INAI</td><td>RESICO · CFDI · RFC/CURP</td></tr>
    <tr><td>🇺🇸 USA</td><td>CCPA (Califórnia) · COPPA · diversas leis estaduais</td><td>EIN · Sole Prop · LLC · Sched-C</td></tr>
    <tr><td>🇨🇴 Colômbia</td><td>Lei 1581 / 2012 · SIC</td><td>Régimen Simple (RST) · NIT/Cédula/RUT</td></tr>
    <tr><td>🇪🇸 Espanha</td><td>RGPD (UE) · LOPDGDD · AEPD</td><td>Autônomos (RETA) · NIF/NIE/DNI</td></tr>
    <tr><td>🇦🇷 Argentina</td><td>Lei 25.326 · AAIP</td><td>Monotributo (A-K) · DNI/CUIT</td></tr>
    <tr><td>🇵🇾 Paraguai</td><td>Lei 1682/01 · Lei 6534/20 · MITIC</td><td>RIRE · RUC/Cédula · SET</td></tr>
    <tr><td>🇵🇪 Peru</td><td>Lei 29733 · ANPD-Peru</td><td>RUS / Nuevo RUS / MYPE · RUC/DNI · SUNAT</td></tr>
    <tr><td>🇪🇨 Equador</td><td>Lei Orgânica de Proteção de Dados · SPDP</td><td>RIMPE Emprendedor · RUC/Cédula · SRI</td></tr>
    <tr><td>🇨🇱 Chile</td><td>Lei 19.628 · CPLT</td><td>Pro PyME / 14 ter · RUT chileno · SII</td></tr>
    <tr><td>🇺🇾 Uruguai</td><td>Lei 18.331 · URCDP</td><td>Monotributo Social MIDES · RUT/Cédula · DGI</td></tr>
    <tr><td>🇧🇴 Bolívia</td><td>Lei 1928 · ATT</td><td>RTS Simplificado · NIT/Cédula · SIN</td></tr>
