const wa = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent('Hi! I need help with Zymplo.')}`;
---
<header>
  <a href="https://zymplo.com/"><img src="/brand/isotipo.svg" alt="Zymplo" /></a>
