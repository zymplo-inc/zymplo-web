---
interface Props { name: string; size?: number; }
const { name, size = 80 } = Astro.props;

// Modern 3D rendered icons · Microsoft Fluent UI Emoji 3D · MIT license
// Self-hosted /public/emoji/*.png · CF Polish auto-converts to WebP at edge for compatible browsers
const IMAGES: Record<string, { src: string; alt: string }> = {
  money:    { src: '/emoji/money.png',    alt: 'Cobranças' },
  receipt:  { src: '/emoji/receipt.png',  alt: 'NFS-e' },
  chart:    { src: '/emoji/chart.png',    alt: 'Resumo financeiro' },
  calendar: { src: '/emoji/calendar.png', alt: 'Agenda' },
  pix:      { src: '/emoji/pix.png',      alt: 'Pix' },
  bell:     { src: '/emoji/bell.png',     alt: 'Lembretes' },
  rocket:   { src: '/emoji/rocket.png',   alt: 'Rápido' },
  shield:   { src: '/emoji/shield.png',   alt: 'Seguro' },
  check:    { src: '/emoji/check.png',    alt: 'Listo' },
  star:     { src: '/emoji/star.png',     alt: 'Top' },
};

const img = IMAGES[name] ?? IMAGES.money;
---
<div class="zymplo-feature-icon" style={`width:${size}px;height:${size}px`}>
  <img src={img.src} alt={img.alt} width={size} height={size} loading="lazy" decoding="async" />
</div>

<style>
  .zymplo-feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    filter: drop-shadow(0 6px 18px rgba(20, 184, 166, 0.18));
    transition: transform 0.4s var(--ease-spring), filter 0.3s var(--ease-out-expo);
    will-change: transform;
  }
  .zymplo-feature-icon:hover {
    transform: translateY(-3px) scale(1.06) rotate(-1.5deg);
    filter: drop-shadow(0 12px 28px rgba(20, 184, 166, 0.32));
  }
  @media (prefers-reduced-motion: reduce) {
    .zymplo-feature-icon { transition: none; }
    .zymplo-feature-icon:hover { transform: none; }
  }
  .zymplo-feature-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
</style>
