---
interface Props { name: string; size?: number; }
const { name, size = 80 } = Astro.props;

// Modern 3D rendered icons · Microsoft Fluent UI Emoji 3D · friendly + cercano + confiable
// CDN: jsdelivr · github.com/microsoft/fluentui-emoji · MIT license · production-ready
const CDN = 'https://cdn.jsdelivr.net/gh/microsoft/fluentui-emoji@main/assets';
const IMAGES: Record<string, { src: string; alt: string }> = {
  money:    { src: `${CDN}/Money%20bag/3D/money_bag_3d.png`,                  alt: 'Cobranças' },
  receipt:  { src: `${CDN}/Receipt/3D/receipt_3d.png`,                        alt: 'NFS-e' },
  chart:    { src: `${CDN}/Chart%20increasing/3D/chart_increasing_3d.png`,    alt: 'Resumo financeiro' },
  calendar: { src: `${CDN}/Spiral%20calendar/3D/spiral_calendar_3d.png`,      alt: 'Agenda' },
  pix:      { src: `${CDN}/Money%20with%20wings/3D/money_with_wings_3d.png`,  alt: 'Pix' },
  bell:     { src: `${CDN}/Bell/3D/bell_3d.png`,                              alt: 'Lembretes' },
  rocket:   { src: `${CDN}/Rocket/3D/rocket_3d.png`,                          alt: 'Rápido' },
  shield:   { src: `${CDN}/Shield/3D/shield_3d.png`,                          alt: 'Seguro' },
  check:    { src: `${CDN}/Check%20mark%20button/3D/check_mark_button_3d.png`, alt: 'Listo' },
  star:     { src: `${CDN}/Star/3D/star_3d.png`,                              alt: 'Top' },
};

const img = IMAGES[name] ?? IMAGES.money;
---
<div class="zymplo-feature-icon" style={`width:${size}px;height:${size}px`}>
  <img src={img.src} alt={img.alt} width={size} height={size} loading="lazy" decoding="async" />
</div>

<style>
  .zymplo-feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    filter: drop-shadow(0 6px 18px rgba(20, 184, 166, 0.18));
    transition: transform 0.4s var(--ease-spring), filter 0.3s var(--ease-out-expo);
    will-change: transform;
  }
  .zymplo-feature-icon:hover {
    transform: translateY(-3px) scale(1.06) rotate(-1.5deg);
    filter: drop-shadow(0 12px 28px rgba(20, 184, 166, 0.32));
  }
  @media (prefers-reduced-motion: reduce) {
    .zymplo-feature-icon { transition: none; }
    .zymplo-feature-icon:hover { transform: none; }
  }
  .zymplo-feature-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
</style>
