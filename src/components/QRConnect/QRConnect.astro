---
import type { CountrySlug } from '@data/countries';
import type { Dict } from '@i18n/index';
interface Props { slug: CountrySlug; dict: Dict }
const { dict } = Astro.props;
const q = (dict as any).qr_connect ?? {};
const eyebrow = q.app_eyebrow ?? q.eyebrow ?? 'Mobile app';
const title = q.app_title ?? 'Native apps · iOS · Android';
const subtitle = q.app_intro ?? 'For now, your account lives inside WhatsApp · the apps add notifications, dashboard and offline mode.';
const app = q.app_label ?? 'Mobile app';
const appSub = q.app_sub ?? 'Coming soon';
const soonLabel = q.soon_label ?? 'Coming soon';
const notify = q.notify_label ?? 'Notify me when launched';
const notifyHelp = q.notify_help ?? "We'll send a one-time WhatsApp message when iOS / Android launch.";
---
<section id="apps" class="bg-paper py-16 md:py-20 border-y border-ink/5">
  <div class="max-w-5xl mx-auto px-6">
    <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-center">
      <!-- Left · text -->
      <div>
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-warning/15 text-warning text-[11px] font-bold uppercase tracking-widest">
          {soonLabel}
        </span>
        <h2 class="mt-4 font-display text-3xl md:text-5xl font-bold tracking-tightest leading-[0.98]">{title}</h2>
        <p class="mt-3 text-base md:text-lg text-slate leading-relaxed max-w-md">{subtitle}</p>

        <div class="mt-6 flex flex-wrap gap-3">
          <span class="inline-flex items-center gap-2 bg-ink text-white text-sm font-semibold px-5 py-3 rounded-2xl select-none opacity-80">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.05 12.04c0-2.4 1.97-3.55 2.06-3.61-1.12-1.65-2.87-1.87-3.5-1.9-1.49-.15-2.91.88-3.66.88-.77 0-1.93-.86-3.18-.83-1.63.02-3.14.95-3.98 2.4-1.7 2.95-.43 7.3 1.21 9.69.81 1.17 1.76 2.48 3.01 2.43 1.21-.05 1.67-.78 3.13-.78 1.45 0 1.87.78 3.15.75 1.3-.02 2.12-1.18 2.91-2.36.92-1.36 1.3-2.69 1.32-2.76-.03-.01-2.51-.96-2.54-3.81zm-2.4-7c.66-.81 1.11-1.93 1-3.04-.95.04-2.11.64-2.8 1.44-.61.71-1.15 1.85-1.01 2.94 1.06.08 2.14-.54 2.81-1.34z"/></svg>
            <div class="text-left leading-tight">
              <div class="text-[10px] uppercase tracking-widest opacity-70">Download on</div>
              <div>App Store</div>
            </div>
          </span>
          <span class="inline-flex items-center gap-2 bg-ink text-white text-sm font-semibold px-5 py-3 rounded-2xl select-none opacity-80">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M3.609 1.814L13.792 12 3.61 22.186a1 1 0 01-.61-.92V2.734a1 1 0 01.61-.92zM14.499 12.708l2.43 2.43-11.155 6.343zM17.847 8.916l2.952 1.68a1 1 0 010 1.808l-2.952 1.68L15.207 12zM5.774 1.814l11.155 6.343-2.43 2.43z"/></svg>
            <div class="text-left leading-tight">
              <div class="text-[10px] uppercase tracking-widest opacity-70">Get it on</div>
              <div>Google Play</div>
            </div>
          </span>
        </div>

        <p class="mt-5 text-xs text-mute max-w-md">{notifyHelp}</p>
      </div>

      <!-- Right · phone mockup placeholder -->
      <div class="flex justify-center md:justify-end">
        <div class="relative w-[260px] h-[420px] md:w-[300px] md:h-[480px] bg-ink rounded-[40px] p-3 shadow-2xl">
          <div class="w-full h-full bg-gradient-to-br from-turquesa via-turquesa-dark to-azul rounded-[28px] overflow-hidden flex flex-col items-center justify-center text-white p-6 text-center">
            <div class="text-3xl mb-2">📱</div>
            <div class="font-display text-2xl font-bold">{app}</div>
            <div class="mt-1.5 text-sm font-semibold opacity-90">{appSub}</div>
            <img src="https://sims.zymplo.com/brand/isotipo-blanco.svg" alt="" class="mt-6 w-12 h-12 opacity-90" />
          </div>
          <!-- Notch -->
          <div class="absolute top-3 left-1/2 -translate-x-1/2 w-24 h-5 bg-ink rounded-b-2xl"></div>
        </div>
      </div>
    </div>
  </div>
</section>
