---
import { COUNTRIES, COUNTRY_SLUGS, SOCIAL, LEGAL, legalLinks, BRAND, type CountrySlug } from '@data/countries';
import { getContent } from '@data/content';
interface Props { slug: CountrySlug }
const { slug } = Astro.props;
const c = COUNTRIES[slug];
const dict = getContent(slug); // typed ContentSchema · Path C migration
const f = dict.footer;
const year = new Date().getFullYear();
// FUEGO 5 (2026-08-18): los 5 links legales van con prefijo de país — ver el
// porqué medido en el comentario de `legalLinks` en @data/countries.
const legal = legalLinks(slug);

// R93l · footer rebuilt world-class · 3/3 LLM convergence (Stripe+Linear+Vercel hybrid)
const socials: Array<{ name: string; href: string; svg: string }> = [
  { name: 'Instagram', href: SOCIAL.instagram, svg: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>' },
  { name: 'TikTok', href: SOCIAL.tiktok, svg: '<path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64 2.93 2.93 0 01.88.13V9.4a6.84 6.84 0 00-1-.05A6.33 6.33 0 005.8 20.1a6.34 6.34 0 0010.86-4.43v-7a8.16 8.16 0 004.77 1.52v-3.4a4.85 4.85 0 01-1.84-.1z" fill="currentColor" stroke="none"/>' },
  { name: 'Facebook', href: SOCIAL.facebook, svg: '<path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>' },
  { name: 'X', href: SOCIAL.x, svg: '<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" fill="currentColor" stroke="none"/>' },
  { name: 'YouTube', href: SOCIAL.youtube, svg: '<path d="M22.54 6.42a2.78 2.78 0 00-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 00-1.94 2A29 29 0 001 11.75a29 29 0 00.46 5.33A2.78 2.78 0 003.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 001.94-2 29 29 0 00.46-5.25 29 29 0 00-.46-5.33z"/><path d="M9.75 15.02l5.75-3.27-5.75-3.27v6.54z" fill="currentColor" stroke="none"/>' },
  { name: 'LinkedIn', href: SOCIAL.linkedin, svg: '<path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-4 0v7h-4v-7a6 6 0 016-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>' },
];
---
<footer class="bg-ink text-paper/70 border-t border-white/5" role="contentinfo" data-zymplo-footer>
  <!-- Top section · R93q · brand 3 cols + link wrapper 9 cols con grid interno 5-col equal (Stripe/Vercel/Linear/Notion top unicorn pattern) -->
  <div class="max-w-7xl mx-auto px-6 pt-16 pb-10 grid gap-10 md:gap-x-12 md:grid-cols-12">
    <!-- Brand · 3 cols -->
    <div class="md:col-span-3">
      <a href="/" class="inline-flex items-center gap-2.5 group">
        <img src={BRAND.logoIso} alt="Zymplo" class="h-8 w-8" width="32" height="32" />
        <span class="font-display font-bold text-xl text-turquesa tracking-tighter">zymplo</span>
      </a>
      <p class="mt-5 text-[17px] leading-snug font-semibold text-paper max-w-xs">
        <span class="block">{f.tagline_v2_line1 ?? 'Tu vida, más simple.'}</span>
        <span class="block">{f.tagline_v2_line2 ?? 'Solo conversando.'}</span>
      </p>
      <p class="mt-3 text-sm text-paper/60 leading-relaxed max-w-xs">{f.subline_v2 ?? 'Sin app · sin registro · todo desde WhatsApp.'}</p>
      <p class="mt-4 text-xs text-paper/40">💛 {f.warm_made ?? 'hecho con calidez en LATAM'}</p>
    </div>

    <!-- Link wrapper · 9 cols con 4-col equal grid interno (responsive: 2/3/4).
         Sólo links a páginas que EXISTEN: el footer viejo linkeaba 9 rutas
         inexistentes (/about/ /blog/ /careers/ …) y Google juntó 49 URLs en 404
         (GSC 7-ago). El candado check-seo se pone rojo si vuelve una. -->
    <div class="md:col-span-9 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-6 gap-y-10">
      <!-- Producto -->
      <div>
        <div class="text-[11px] font-bold uppercase tracking-widest text-paper/90 mb-4">{f.section_product ?? 'Producto'}</div>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/" class="text-paper/65 hover:text-turquesa-light transition">{f.link_home ?? 'Inicio'}</a></li>
          <li><a href="#features" class="text-paper/65 hover:text-turquesa-light transition">{f.link_features ?? 'Funciones'}</a></li>
          <li><a href="#pricing" class="text-paper/65 hover:text-turquesa-light transition">{f.link_pricing ?? 'Precios'}</a></li>
          <li><a href="/onboarding/" class="text-paper/65 hover:text-turquesa-light transition">{f.link_onboarding ?? 'Onboarding'}</a></li>
        </ul>
      </div>

      <!-- Empresa -->
      <div>
        <div class="text-[11px] font-bold uppercase tracking-widest text-paper/90 mb-4">{f.section_company ?? 'Empresa'}</div>
        <ul class="space-y-2.5 text-sm">
          <li><a href={LEGAL.press} class="text-paper/65 hover:text-turquesa-light transition">{f.link_press ?? 'Prensa'}</a></li>
          <li><a href={LEGAL.contact} class="text-paper/65 hover:text-turquesa-light transition">{f.link_contact ?? 'Contacto'}</a></li>
        </ul>
      </div>

      <!-- Soporte -->
      <div>
        <div class="text-[11px] font-bold uppercase tracking-widest text-paper/90 mb-4">{f.section_support ?? 'Soporte'}</div>
        <ul class="space-y-2.5 text-sm">
          <li><a href={LEGAL.support} class="text-paper/65 hover:text-turquesa-light transition">{f.link_help ?? 'Centro de ayuda'}</a></li>
          <li><a href="/precios/" class="text-paper/65 hover:text-turquesa-light transition">{f.link_pricing ?? 'Precios'}</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <div class="text-[11px] font-bold uppercase tracking-widest text-paper/90 mb-4">{f.section_legal ?? 'Legal'}</div>
        <ul class="space-y-2.5 text-sm">
          <li><a href={legal.terms} class="text-paper/65 hover:text-turquesa-light transition">{f.legal_terms ?? 'Términos'}</a></li>
          <li><a href={legal.privacy} class="text-paper/65 hover:text-turquesa-light transition">{f.legal_privacy ?? 'Privacidad'}</a></li>
          <li><a href={legal.cookies} class="text-paper/65 hover:text-turquesa-light transition">{f.legal_cookies ?? 'Cookies'}</a></li>
          <li><a href={legal.compliance} class="text-paper/65 hover:text-turquesa-light transition">{f.legal_compliance ?? 'Cumplimiento'}</a></li>
          <li><a href={legal.delete_account} class="text-paper/65 hover:text-turquesa-light transition">{f.legal_delete_account ?? 'Eliminar cuenta'}</a></li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom row · R93q · socials LEFT (escape widget zone) + country pill RIGHT (Stripe/Linear/Vercel pattern) -->
  <div class="border-t border-white/8">
    <div class="max-w-7xl mx-auto px-6 py-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 text-xs">
      <!-- Left: copyright + tiny socials (movidos aquí · escape widget bottom-right) -->
      <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-5">
        <span class="text-paper/45">© {year} Zymplo Inc.{slug === 'br' ? ' · Zymplo Brasil LTDA · CNPJ 66.667.634/0001-00' : ''} {f.rights ?? 'Todos los derechos reservados.'}</span>
        <ul class="flex items-center gap-3.5">
          {socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                aria-label={s.name}
                class="text-paper/45 hover:text-turquesa-light transition inline-block"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={s.svg} />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Right: region selector pill (zona widget · widget shrink IO mantiene tappable) -->
      <button
        type="button"
        class="inline-flex items-center gap-1.5 text-paper/60 hover:text-paper transition rounded-full bg-white/[0.04] hover:bg-white/[0.08] border border-white/8 hover:border-white/15 px-3 py-1.5 text-[11px] font-semibold self-start sm:self-auto"
        data-country-pill
        aria-haspopup="listbox"
      >
        <span class="text-sm leading-none">{c.flag}</span>
        <span class="hidden sm:inline">{c.name}</span>
        <span class="text-paper/35">·</span>
        <span>{c.locale}</span>
        <span class="text-paper/35">·</span>
        <span>{c.currency.symbol} {c.currency.code}</span>
        <svg class="w-3 h-3 text-paper/45 ml-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
      </button>
    </div>
  </div>
</footer>
