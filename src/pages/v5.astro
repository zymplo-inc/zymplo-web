let lang='pt';
function esc(s){return s;}
function fillChat(el, msgs, docText){
  el.innerHTML='';
  msgs.forEach((m,i)=>{
    const [who,txt,time]=m;
    const d=document.createElement('div');
    d.className='msg '+(who==='me'?'me':'bot');
    d.style.animationDelay=(0.15*i+0.2)+'s';
    if(txt==='audio'){d.className+=' audio';d.innerHTML='<span>▶</span><span class="wv"></span><span class="t">'+time+'</span>';}
    else if(txt==='doc'){d.className+=' doc';d.innerHTML='<span class="ic">📄</span><span>'+docText+'<span class="t">'+time+'</span></span>';}
    else{d.innerHTML=txt+'<span class="t">'+time+'</span>';}
    el.appendChild(d);
  });
}
function render(){
  const t=I18N[lang];
  document.documentElement.lang = lang==='pt'?'pt-BR':(lang==='es'?'es':'en');
  document.querySelectorAll('[data-i18n]').forEach(el=>{
    const k=el.getAttribute('data-i18n'); if(t[k]!=null) el.innerHTML=t[k];
  });
  document.querySelectorAll('.wa').forEach(a=>a.setAttribute('href',WA[lang]));
  // cards
  const cw=document.getElementById('cards'); cw.innerHTML='';
  t.cards.forEach((c,i)=>{cw.insertAdjacentHTML('beforeend',
    '<div class="card reveal '+(i%4===1?'d2':i%4===2?'d3':i%4===3?'d4':'d1')+'"><div class="ic">'+c[0]+'</div><h3>'+c[1]+'</h3><p>'+c[2]+'</p></div>');});
  // personas
  const pc=document.getElementById('pcards'); pc.innerHTML='';
  const slug=['diego-silva','luana-oliveira','raimundo-costa'];
  t.pers.forEach((p,i)=>{pc.insertAdjacentHTML('beforeend',
    '<div class="pcard reveal '+(i===1?'d2':i===2?'d3':'d1')+'"><span class="tag">'+t.p_disc.replace('* ','').split(' —')[0]+'</span><h3>'+p[0]+'</h3><div class="role">'+p[1]+'</div><p class="q">'+p[2]+'</p><p style="margin-top:14px"><a style="color:var(--turquesa-deeper);font-weight:700;font-size:13px" href="https://vitrine.zymplo.com/'+slug[i]+'" target="_blank" rel="noopener">vitrine.zymplo.com/'+slug[i]+' →</a></p></div>');});
  // plans
  const pl=document.getElementById('plans'); pl.innerHTML='';
  R147_INTERIM_BR.forEach(p=>{
    const best=p.best?'<span class="best">'+(lang==='pt'?'Mais escolhido':lang==='es'?'Más elegido':'Most picked')+'</span>':'';
    const lis=p.feat[lang].map(f=>'<li>'+f+'</li>').join('');
    pl.insertAdjacentHTML('beforeend',
      '<div class="plan reveal '+(p.best?'pro':'')+' '+(p.id==='free'?'free':'')+'">'+best+
      '<div class="pname">'+p.emoji+' '+p.name+'</div><div class="price">'+p.price+' <small>'+p.per+'</small></div>'+
      '<ul>'+lis+'</ul><a class="cta wa" href="'+WA[lang]+'">'+t.nav_cta+'</a></div>');
  });
  document.querySelectorAll('.wa').forEach(a=>a.setAttribute('href',WA[lang]));
  // faq
  const fq=document.getElementById('faq'); fq.innerHTML='';
  t.faq.forEach((q,i)=>{fq.insertAdjacentHTML('beforeend',
    '<div class="qa reveal"><button>'+q[0]+'</button><div class="a"><p>'+q[1]+'</p></div></div>');});
  fq.querySelectorAll('.qa button').forEach(b=>b.addEventListener('click',()=>b.parentElement.classList.toggle('open')));
  // chats
  fillChat(document.getElementById('chat'), t.chat, t.doc);
  fillChat(document.getElementById('chat2'), t.chat2, t.doc);
  observe();
}
function setLang(l){lang=l;document.querySelectorAll('#langs button').forEach(b=>b.classList.toggle('on',b.dataset.lang===l));render();}
document.querySelectorAll('#langs button').forEach(b=>b.addEventListener('click',()=>setLang(b.dataset.lang)));

// scroll reveals
let io;
function observe(){
  if(io) io.disconnect();
  io=new IntersectionObserver((es)=>{es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}})},{threshold:.14,rootMargin:'0px 0px -8% 0px'});
  document.querySelectorAll('.reveal:not(.in)').forEach(el=>io.observe(el));
}
// progress
addEventListener('scroll',()=>{const h=document.documentElement;document.getElementById('bar').style.width=(h.scrollTop/(h.scrollHeight-h.clientHeight)*100)+'%';},{passive:true});
render();
</script>
</body>
</html>
