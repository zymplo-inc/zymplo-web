---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="https://sims.zymplo.com/brand/isotipo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Sora:wght@400;500;600;700;800&display=swap" />
    <style is:inline>
      :root { --turquesa: #14B8A6; --turquesa-light: #5EEAD4; --turquesa-deeper: #0B6B62; --ink: #0A0B14; --paper: #FAFBFF; --slate: #1F2937; --mute: #6B7280; --warning: #F59E0B; --error: #EF4444; --purple: #623AE6; }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: 'Manrope', sans-serif; background: var(--ink); color: var(--paper); line-height: 1.5; min-height: 100vh; }
      .container { max-width: 1280px; margin: 0 auto; padding: 0 24px; }

      .top-nav { position: sticky; top: 0; background: rgba(10,11,20,0.92); backdrop-filter: blur(10px); border-bottom: 1px solid rgba(255,255,255,0.08); z-index: 10; }
      .top-nav .inner { display: flex; align-items: center; justify-content: space-between; padding: 12px 24px; max-width: 1280px; margin: 0 auto; gap: 12px; flex-wrap: wrap; }
      .top-nav a.brand { display: flex; align-items: center; gap: 8px; text-decoration: none; color: var(--paper); font-weight: 800; }
      .top-nav a.brand img { height: 28px; }
      .top-nav a.brand span.wm { color: var(--turquesa); font-family: 'Sora', sans-serif; }
      .top-nav .switch { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
      .top-nav .switch a { padding: 6px 12px; border-radius: 999px; font-weight: 700; font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; text-decoration: none; }
      .top-nav .switch a.on { background: linear-gradient(135deg, var(--purple), var(--turquesa)); color: white; }
      .top-nav .switch a.off { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.15); color: rgba(255,255,255,0.7); }

      header { padding: 56px 0 32px; border-bottom: 1px solid rgba(255,255,255,0.08); position: relative; overflow: hidden; }
      header::before { content: ''; position: absolute; top: -150px; left: -100px; width: 500px; height: 500px; background: radial-gradient(circle, var(--purple) 0%, transparent 70%); opacity: 0.25; filter: blur(60px); }
      header::after { content: ''; position: absolute; top: -100px; right: -100px; width: 500px; height: 500px; background: radial-gradient(circle, var(--turquesa) 0%, transparent 70%); opacity: 0.25; filter: blur(60px); }
      header h1 { font-family: 'Sora', sans-serif; font-size: 80px; font-weight: 800; letter-spacing: -0.05em; line-height: 0.92; position: relative; }
      header h1 .accent { background: linear-gradient(120deg, var(--turquesa-light), var(--purple)); -webkit-background-clip: text; background-clip: text; color: transparent; }
      header p { margin-top: 24px; color: rgba(255,255,255,0.7); font-size: 18px; max-width: 800px; position: relative; }
      .badge { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; background: rgba(245,158,11,0.15); color: var(--warning); border: 1px solid rgba(245,158,11,0.4); border-radius: 999px; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; }

      .top5 { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; margin-top: 36px; position: relative; }
      .top5 .item { background: linear-gradient(135deg, rgba(20,184,166,0.1), rgba(98,58,230,0.1)); border: 1px solid rgba(20,184,166,0.3); border-radius: 14px; padding: 16px 18px; font-size: 14px; color: rgba(255,255,255,0.92); font-weight: 600; }

      .section-h { padding: 56px 0 24px; }
      .section-h h2 { font-family: 'Sora', sans-serif; font-size: 48px; font-weight: 800; letter-spacing: -0.04em; line-height: 1; }
      .section-h .sub { color: rgba(255,255,255,0.6); margin-top: 12px; font-size: 16px; max-width: 720px; }

      .brave-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 16px; }
      .brave-card { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 18px; padding: 24px 26px; transition: transform 0.2s, border-color 0.2s; position: relative; overflow: hidden; }
      .brave-card:hover { transform: translateY(-3px); border-color: rgba(245,158,11,0.4); }
      .brave-card::before { content: '🔥'; position: absolute; top: -24px; right: -10px; font-size: 80px; opacity: 0.06; }
      .brave-card .meta { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 12px; }
      .brave-card .meta .by { color: rgba(255,255,255,0.45); font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; }
      .brave-card .meta .impact { background: rgba(245,158,11,0.15); border: 1px solid rgba(245,158,11,0.3); color: var(--warning); padding: 4px 10px; border-radius: 999px; font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; }
      .brave-card h3 { font-family: 'Sora', sans-serif; font-size: 22px; font-weight: 700; line-height: 1.15; letter-spacing: -0.025em; color: var(--paper); }
      .brave-card .desc { margin-top: 10px; color: rgba(255,255,255,0.7); font-size: 14px; line-height: 1.55; }

      .platform-section { margin-top: 48px; padding-bottom: 32px; border-bottom: 1px solid rgba(255,255,255,0.06); }
      .platform-header { display: flex; align-items: center; gap: 16px; padding: 16px 0; }
      .platform-header .ic { width: 56px; height: 56px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 28px; color: white; }
      .platform-header h2 { font-family: 'Sora', sans-serif; font-size: 32px; font-weight: 800; letter-spacing: -0.02em; color: var(--paper); }

      .templates-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; margin-top: 16px; }
      .template-card { border: 1px solid rgba(255,255,255,0.08); border-radius: 18px; overflow: hidden; background: rgba(255,255,255,0.02); transition: transform 0.2s, border-color 0.2s; }
      .template-card:hover { transform: translateY(-2px); border-color: rgba(20,184,166,0.4); }
      .template-meta { padding: 16px 18px 18px; background: rgba(0,0,0,0.3); }
      .template-meta .size { font-size: 11px; font-weight: 700; color: var(--turquesa-light); text-transform: uppercase; letter-spacing: 0.12em; }
      .template-meta .copy { color: rgba(255,255,255,0.6); font-size: 13px; line-height: 1.45; margin-top: 4px; }

      .template-preview { padding: 36px 28px; min-height: 320px; display: flex; flex-direction: column; justify-content: center; position: relative; }
      .template-preview.r-9-16 { aspect-ratio: 9/16; min-height: 380px; }
      .template-preview.r-1-1 { aspect-ratio: 1/1; min-height: 320px; }
      .template-preview.r-16-9 { aspect-ratio: 16/9; min-height: 220px; }
      .template-preview .hook { font-family: 'Sora', sans-serif; font-weight: 800; line-height: 1.05; letter-spacing: -0.03em; font-size: 30px; white-space: pre-wrap; }
      .template-preview .iso { position: absolute; bottom: 14px; right: 14px; opacity: 0.85; }
      .template-preview .badge-zy { position: absolute; bottom: 16px; left: 16px; font-size: 10px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; opacity: 0.55; }

      footer { padding: 64px 0 96px; color: rgba(255,255,255,0.5); font-size: 13px; }

      @media (max-width: 768px) {
        header h1 { font-size: 44px; }
        .platform-header h2, .section-h h2 { font-size: 28px; }
        .template-preview .hook { font-size: 22px; }
      }
    </style>
  </head>
  <body>
    <nav class="top-nav">
      <div class="inner">
        <a class="brand" href="https://br.zymplo.com/v3/">
          <img src="https://sims.zymplo.com/brand/isotipo.svg" alt="Zymplo" />
          <span class="wm">zymplo</span>
          <span style="color: rgba(255,255,255,0.4); font-weight: 500;">/ social · C RADICAL</span>
        </a>
        <div class="switch">
          <a class="off" href="https://sims.zymplo.com/web/social/">A · Warm</a>
          <a class="off" href="https://sims.zymplo.com/web/social/c/">C · Bold</a>
          <a class="on">🔥 C · RADICAL</a>
        </div>
      </div>
    </nav>

    <div class="container">
      <header>
        <span class="badge">⚡ 8 LLMs · brave ideas · 10M users playbook</span>
        <h1 style="margin-top: 16px;">10 millones <span class="accent">en menos<br/>de 1 año.</span></h1>
        <p>Lo que harían los founders más exitosos de 2026 si tuvieran que escalar Zymplo a 10M usuarios. Consensus 8 LLMs (Claude · GPT · Grok · Qwen · Llama 3.3 · TikTok creator · Cal.com growth lead · VC Stripe/Bessemer · MEI influencer BR).</p>

        <div class="top5">
          {TOP_5_RADICAL.map((t) => <div class="item">{t}</div>)}
        </div>
      </header>

      <div class="section-h">
        <span class="badge" style="background: rgba(98,58,230,0.15); color: #a594ff; border-color: rgba(98,58,230,0.4);">⚡ uniquely brave ideas</span>
        <h2 style="margin-top: 16px;">Lo que <span style="color: var(--warning);">nadie más</span><br/>se animaría a hacer.</h2>
        <p class="sub">8 ideas radicales · una por LLM perspective · ratificable cada una con expected impact.</p>
      </div>

      <div class="brave-grid">
        {BRAVE_IDEAS.map((b) => (
          <div class="brave-card">
            <div class="meta">
              <span class="by">{b.by}</span>
              <span class="impact">{b.impact}</span>
            </div>
            <h3>{b.title}</h3>
            <p class="desc">{b.desc}</p>
          </div>
        ))}
      </div>

      <div class="section-h" style="margin-top: 48px;">
        <span class="badge">📱 viral creatives radical</span>
        <h2 style="margin-top: 16px;">Hooks que detienen<br/><span class="accent">el scroll del país.</span></h2>
        <p class="sub">Creatives ratificados por debate · push boundaries · drives organic reach · diseñados para K-factor ≥1.0.</p>
      </div>

      {CREATIVES_RADICAL.map((t) => (
        <section class="platform-section">
          <div class="platform-header">
            <div class="ic" style={`background: ${t.gradient};`}>{t.icon}</div>
            <h2>{t.platform}</h2>
          </div>
          <div class="templates-grid">
            {t.formats.map((f) => (
              <div class="template-card">
                <div class={`template-preview r-${f.ratio}`} style={`background: ${f.bg}; color: ${f.text};`}>
                  <div class="badge-zy" style={`color: ${f.text};`}>zymplo</div>
                  <div class="hook" style={`color: ${f.text};`}>{f.hook}</div>
                  <div class="iso">
                    <svg width="36" height="36" viewBox="0 0 96 96">
                      <g fill="none" stroke={f.accent} stroke-width="10" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M26 44 L40 28 L54 44 L72 22"/>
                        <path d="M22 56 Q48 86 74 56"/>
                      </g>
                    </svg>
                  </div>
                </div>
                <div class="template-meta">
                  <span class="size">{f.size}</span>
                  <div class="copy">{f.copy}</div>
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}

      <footer>
        <p>Zymplo · Social C RADICAL · 8 LLMs viral playbook · 2026-04-30</p>
        <p style="margin-top: 8px;">Target: 10M users en &lt;1 año · K-factor ≥1.0 · CAC tendiendo a $0 · 100% organic + paid hybrid</p>
      </footer>
    </div>
  </body>
</html>
