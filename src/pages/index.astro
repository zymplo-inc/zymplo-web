---
import BaseLayout from '~/layouts/BaseLayout.astro';

const features = [
  {
    icon: 'whatsapp',
    title: 'Direto no WhatsApp',
    text: 'Sem app novo, sem login, sem treinamento. O Zymplo trabalha onde você já trabalha — no seu WhatsApp.',
  },
  {
    icon: 'lightning',
    title: 'Não perde mais cliente',
    text: 'Quando alguém chama, o Zymplo responde em menos de 30 segundos por você — mesmo se você está na obra, atendendo, ou dormindo.',
  },
  {
    icon: 'organize',
    title: 'Organiza o seu negócio',
    text: 'Cobranças, contas, clientes, agenda — tudo num lugar só. Sem planilha, sem caderninho, sem dor de cabeça.',
  },
];

const personas = [
  { ofício: 'Eletricista', nome: 'Diego', cidade: 'São Paulo' },
  { ofício: 'Cabeleireira', nome: 'Luana', cidade: 'Belo Horizonte' },
  { ofício: 'Encanador', nome: 'Raimundo', cidade: 'Recife' },
];
---

<BaseLayout title="Zymplo">
  <!-- HERO -->
  <section class="bg-gradient-to-b from-zymplo-50 via-white to-white">
    <div class="max-w-6xl mx-auto px-6 pt-16 pb-20 md:pt-24 md:pb-28 text-center">
      <p class="inline-block px-3 py-1 bg-zymplo-100 text-zymplo-700 text-xs font-bold rounded-full mb-6 uppercase tracking-wider">
        Para microempreendedores brasileiros
      </p>
      <h1 class="text-4xl md:text-6xl font-extrabold leading-tight tracking-tight mb-6 text-ink">
        Seu negócio organizado.<br />
        <span class="text-zymplo-600">Direto no WhatsApp.</span>
      </h1>
      <p class="text-lg md:text-xl text-zinc-600 max-w-2xl mx-auto mb-10 leading-relaxed">
        Capte clientes, responda em segundos, cobre sem esquecer e saiba quanto entrou no mês —
        tudo onde você já trabalha. Sem planilha. Sem app complicado. Sem tempo perdido.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center" id="cta">
        <a href="#produto" class="btn-primary">Quero o Zymplo</a>
        <a href="#como-funciona" class="btn-secondary">Como funciona</a>
      </div>
      <p class="text-xs text-zinc-500 mt-6">Lançamento julho de 2026 · grátis para começar</p>
    </div>
  </section>

  <!-- FEATURES -->
  <section id="produto" class="max-w-6xl mx-auto px-6 py-20">
    <div class="text-center mb-14">
      <h2 class="text-3xl md:text-4xl font-extrabold mb-4 text-ink">O que o Zymplo faz por você</h2>
      <p class="text-zinc-600 max-w-2xl mx-auto">
        Três coisas que mudam o jogo do seu negócio · sem complicar.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {features.map((f) => (
        <div class="bg-white border border-zinc-200 rounded-2xl p-6 hover:border-zymplo-400 hover:shadow-md transition-all">
          <div class="w-12 h-12 bg-zymplo-100 rounded-xl flex items-center justify-center mb-4 text-zymplo-600">
            {f.icon === 'whatsapp' && (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                <path d="M20.52 3.48A11.93 11.93 0 0 0 12.04.5C5.74.5.65 5.59.65 11.89c0 2.1.55 4.14 1.6 5.95L.5 23.5l5.79-1.71a11.4 11.4 0 0 0 5.74 1.55h.01c6.3 0 11.39-5.09 11.39-11.39 0-3.04-1.18-5.9-3.34-8.06l-1.57-1.41Z M16.6 14.36c-.27-.13-1.6-.79-1.85-.88-.25-.09-.43-.13-.6.13-.18.27-.7.88-.86 1.06-.16.18-.32.2-.59.07-.27-.13-1.13-.42-2.16-1.33-.8-.71-1.34-1.6-1.5-1.86-.16-.27-.02-.41.12-.55.12-.12.27-.32.4-.48.13-.16.18-.27.27-.45.09-.18.04-.34-.02-.48-.07-.13-.6-1.45-.83-1.99-.22-.52-.44-.45-.6-.46l-.51-.01c-.18 0-.45.07-.69.34-.24.27-.91.89-.91 2.17 0 1.28.93 2.52 1.06 2.7.13.18 1.83 2.79 4.43 3.91.62.27 1.1.43 1.48.55.62.2 1.18.17 1.63.1.5-.07 1.6-.65 1.83-1.28.23-.63.23-1.17.16-1.28-.07-.12-.25-.18-.52-.32Z" />
              </svg>
            )}
            {f.icon === 'lightning' && (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                <path d="M13 2 4 14h7l-2 8 9-12h-7l2-8Z" />
              </svg>
            )}
            {f.icon === 'organize' && (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                <path d="M3 4h18v4H3V4Zm0 6h18v4H3v-4Zm0 6h18v4H3v-4Z" />
              </svg>
            )}
          </div>
          <h3 class="text-xl font-bold text-ink mb-2">{f.title}</h3>
          <p class="text-zinc-600 leading-relaxed">{f.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- COMO FUNCIONA -->
  <section id="como-funciona" class="bg-zinc-50 border-y border-zinc-100">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-4xl font-extrabold mb-4 text-ink">Como funciona</h2>
        <p class="text-zinc-600 max-w-2xl mx-auto">
          Em três passos. Sem manual, sem instalar nada complicado.
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-3 max-w-4xl mx-auto">
        <div class="text-center">
          <div class="w-14 h-14 bg-zymplo-500 text-white text-2xl font-bold rounded-full flex items-center justify-center mx-auto mb-4">1</div>
          <h3 class="font-bold text-ink mb-2">Você se cadastra</h3>
          <p class="text-sm text-zinc-600">Conta o ofício, conecta o WhatsApp do seu negócio. Pronto.</p>
        </div>
        <div class="text-center">
          <div class="w-14 h-14 bg-zymplo-500 text-white text-2xl font-bold rounded-full flex items-center justify-center mx-auto mb-4">2</div>
          <h3 class="font-bold text-ink mb-2">Cliente chama</h3>
          <p class="text-sm text-zinc-600">Quando alguém manda mensagem, o Zymplo responde por você na hora — pergunta o serviço, anota tudo.</p>
        </div>
        <div class="text-center">
          <div class="w-14 h-14 bg-zymplo-500 text-white text-2xl font-bold rounded-full flex items-center justify-center mx-auto mb-4">3</div>
          <h3 class="font-bold text-ink mb-2">Você assume</h3>
          <p class="text-sm text-zinc-600">Quando você puder, abre o WhatsApp e já tem todo o contexto. Só fechar negócio.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PARA QUEM -->
  <section id="para-quem" class="max-w-6xl mx-auto px-6 py-20">
    <div class="text-center mb-14">
      <h2 class="text-3xl md:text-4xl font-extrabold mb-4 text-ink">Feito para você que trabalha duro</h2>
      <p class="text-zinc-600 max-w-2xl mx-auto">
        Eletricista, encanadora, cabeleireira, pintor, marceneiro, manicure, mototaxista,
        técnico, marmiteira, fotógrafo, pet groomer, costureira... Se você é MEI, é pra você.
      </p>
    </div>

    <div class="grid gap-4 md:grid-cols-3 max-w-3xl mx-auto">
      {personas.map((p) => (
        <div class="bg-white border border-zinc-200 rounded-xl p-5 text-center hover:border-zymplo-300 transition-all">
          <div class="text-3xl mb-2">👷‍♂️</div>
          <div class="font-bold text-ink">{p.nome}</div>
          <div class="text-sm text-zinc-600">{p.ofício} · {p.cidade}</div>
        </div>
      ))}
    </div>

    <p class="text-center text-zinc-500 text-sm mt-8 italic">
      * Personagens ilustrativos · representam o nosso usuário típico.
    </p>
  </section>

  <!-- CTA FINAL -->
  <section class="bg-gradient-to-br from-zymplo-500 to-zymplo-700 text-white">
    <div class="max-w-4xl mx-auto px-6 py-20 text-center">
      <h2 class="text-3xl md:text-4xl font-extrabold mb-4">Comece quando o Zymplo lançar</h2>
      <p class="text-lg text-white/90 mb-8 max-w-2xl mx-auto">
        Estamos preparando o lançamento para julho de 2026. Deixe seu contato para
        ser dos primeiros a usar — e ganhar 3 meses grátis no plano completo.
      </p>
      <a href="mailto:info@zymplo.com?subject=Quero%20ser%20avisado%20do%20lan%C3%A7amento%20Zymplo&body=Nome%3A%0AOf%C3%ADcio%3A%0ACidade%3A%0AWhatsApp%3A%0A" class="inline-flex items-center justify-center px-8 py-4 rounded-xl bg-white text-zymplo-700 font-bold text-lg hover:bg-zinc-100 transition-all shadow-lg">
        Quero ser avisado
      </a>
      <p class="text-xs text-white/70 mt-6">Sem spam · só uma mensagem quando lançarmos.</p>
    </div>
  </section>
</BaseLayout>
