---
/**
 * Root index — geo-IP redirect to country-specific landing.
 * On Cloudflare Pages, `request.cf.country` is available; locally falls back to BR.
 */
import { COUNTRY_SLUGS, type CountrySlug } from '@data/countries';

const CF_TO_SLUG: Record<string, CountrySlug> = {
  BR: 'br', MX: 'mx', US: 'us', CO: 'co', ES: 'es', AR: 'ar', PY: 'py',
};

let target: CountrySlug = 'br';
const cf = (Astro.request as any)?.cf;
const cc: string | undefined = cf?.country;
if (cc && CF_TO_SLUG[cc]) target = CF_TO_SLUG[cc];

return Astro.redirect(`/${target}/`, 302);
---
