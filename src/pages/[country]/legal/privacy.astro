---
// fix(legal): política de privacidad servida en el idioma correcto según el país
// (br→pt-BR · us→en-US · resto→es), igual que ya hace la homepage vía getStaticPaths()
// sobre COUNTRY_SLUGS + CountryLayout. Antes, /legal/privacy/ estaba fijo en español
// para TODOS los subdominios de país (incluidos br. y us.), violando la regla trilingüe
// y siendo un riesgo real de compliance LGPD (aviso de privacidad debe ser comprensible
// en el idioma del usuario).
import LegalCountryLayout from '@layouts/LegalCountryLayout.astro';
import { COUNTRIES, legalLang, legalHreflangs, LEGAL_COUNTRY_SLUGS, type CountrySlug } from '@data/countries';
import { meta as metaEs } from '@components/Legal/Privacy/Es.astro';
import { meta as metaPt } from '@components/Legal/Privacy/Pt.astro';
import { meta as metaEn } from '@components/Legal/Privacy/En.astro';
import ContentEs from '@components/Legal/Privacy/Es.astro';
import ContentPt from '@components/Legal/Privacy/Pt.astro';
import ContentEn from '@components/Legal/Privacy/En.astro';

export function getStaticPaths() {
  // 'pt' (Portugal) excluido: colisiona con la ruta legacy /pt/legal/* (prefijo de
  // idioma português-BR) — ver comentario en LEGAL_COUNTRY_SLUGS en @data/countries.
  return LEGAL_COUNTRY_SLUGS.map((slug) => ({ params: { country: slug } }));
}

const DOC = 'privacy';
const { country: slug } = Astro.params as { country: CountrySlug };
const lang = legalLang(slug);
const meta = lang === 'pt' ? metaPt : lang === 'en' ? metaEn : metaEs;
const Content = lang === 'pt' ? ContentPt : lang === 'en' ? ContentEn : ContentEs;
const canonical = `https://${slug}.zymplo.com/legal/${DOC}/`;
const hreflangs = legalHreflangs(DOC);
---
<LegalCountryLayout
  lang={COUNTRIES[slug].locale}
  title={meta.title}
  description={meta.description}
  canonical={canonical}
  hreflangs={hreflangs}
>
  <Content />
</LegalCountryLayout>
