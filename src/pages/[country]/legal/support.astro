---
// feat(web): página de soporte por país · mismo mecanismo que src/pages/[country]/legal/delete-account.astro
// (país → idioma legal vía legalLang, contenido en @components/Legal/Support/{Es,Pt,En}).
import LegalCountryLayout from '@layouts/LegalCountryLayout.astro';
import { COUNTRIES, legalLang, legalHreflangs, LEGAL_COUNTRY_SLUGS, type CountrySlug } from '@data/countries';
import { meta as metaEs } from '@components/Legal/Support/Es.astro';
import { meta as metaPt } from '@components/Legal/Support/Pt.astro';
import { meta as metaEn } from '@components/Legal/Support/En.astro';
import ContentEs from '@components/Legal/Support/Es.astro';
import ContentPt from '@components/Legal/Support/Pt.astro';
import ContentEn from '@components/Legal/Support/En.astro';

export function getStaticPaths() {
  // 'pt' (Portugal) excluido: colisiona con la ruta legacy /pt/legal/* — ver
  // comentario en LEGAL_COUNTRY_SLUGS en @data/countries.
  return LEGAL_COUNTRY_SLUGS.map((slug) => ({ params: { country: slug } }));
}

const DOC = 'support';
const { country: slug } = Astro.params as { country: CountrySlug };
const lang = legalLang(slug);
const meta = lang === 'pt' ? metaPt : lang === 'en' ? metaEn : metaEs;
const Content = lang === 'pt' ? ContentPt : lang === 'en' ? ContentEn : ContentEs;
const canonical = `https://${slug}.zymplo.com/legal/${DOC}/`;
const hreflangs = legalHreflangs(DOC);
---
<LegalCountryLayout
  lang={COUNTRIES[slug].locale}
  title={meta.title}
  description={meta.description}
  canonical={canonical}
  hreflangs={hreflangs}
>
  <Content />
</LegalCountryLayout>
