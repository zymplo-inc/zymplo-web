---
import CountryLayout from '@layouts/CountryLayout.astro';
import HeroB from '@components/Hero/HeroB';
import ToolsCarousel from '@components/ToolsCarousel/ToolsCarousel.astro';
import PricingTable from '@components/PricingTable/PricingTable';
import { COUNTRIES, COUNTRY_SLUGS, type CountrySlug } from '@data/countries';
import { getDict } from '@i18n/index';

export function getStaticPaths() {
  return COUNTRY_SLUGS.map((slug) => ({ params: { country: slug } }));
}

const { country: slug } = Astro.params as { country: CountrySlug };
const c = COUNTRIES[slug];
const dict = getDict(slug);
---
<CountryLayout slug={slug}>
  <HeroB client:load slug={slug} country={c} dict={dict} />

  <section id="features" class="bg-paper py-20 md:py-32">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="font-display text-4xl md:text-6xl font-bold tracking-tightest text-center max-w-3xl mx-auto leading-tight">{dict.features?.title ?? ''}</h2>
      <div class="mt-20 grid md:grid-cols-2 gap-6">
        {dict.features?.items?.map((it: any, i: number) => (
          <div class="group bg-white rounded-3xl p-8 md:p-10 border border-ink/8 hover:shadow-xl transition relative overflow-hidden">
            <div class="absolute -top-20 -right-20 w-60 h-60 rounded-full opacity-0 group-hover:opacity-30 transition" style={`background: radial-gradient(circle, ${i % 2 ? '#5EEAD4' : '#623AE6'} 0%, transparent 70%);`}></div>
            <div class="relative">
              <div class="text-4xl">{it.icon}</div>
              <div class="mt-5 font-display font-bold text-2xl">{it.title}</div>
              <p class="mt-3 text-base text-slate leading-relaxed">{it.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ToolsCarousel slug={slug} />
  <PricingTable client:visible slug={slug} country={c} dict={dict} />

</CountryLayout>
