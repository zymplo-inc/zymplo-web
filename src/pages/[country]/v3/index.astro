---
import CountryLayout from '@layouts/CountryLayout.astro';
import HeroC from '@components/Hero/HeroC';
import ToolsCarousel from '@components/ToolsCarousel/ToolsCarousel.astro';
import PricingTable from '@components/PricingTable/PricingTable';
import { COUNTRIES, COUNTRY_SLUGS, type CountrySlug } from '@data/countries';
import { getDict } from '@i18n/index';

export function getStaticPaths() {
  return COUNTRY_SLUGS.map((slug) => ({ params: { country: slug } }));
}

const { country: slug } = Astro.params as { country: CountrySlug };
const c = COUNTRIES[slug];
const dict = getDict(slug);
const faq = (dict as any).faq;
const cmp = (dict.hero as any).comparison;
const vsLabel = (dict.hero as any).vs_label ?? 'Why Zymplo wins';
const challengeLabel = (dict.hero as any).challenge_label ?? '#ZymploChallenge';
const challengePrize = (dict.hero as any).challenge_prize ?? '$10,000 for the best video';
---
<CountryLayout slug={slug}>
  <HeroC client:load slug={slug} country={c} dict={dict} />

  <!-- Payments band · dark mode -->
  <section class="bg-ink border-b border-white/10 py-6">
    <div class="max-w-7xl mx-auto px-6 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-paper/60 text-xs uppercase tracking-widest">
      <span class="font-semibold">{(dict as any).payments_label ?? 'Accepts all payment methods'}</span>
      <div class="flex flex-wrap items-center gap-3 text-paper font-bold text-sm normal-case tracking-normal">
        {c.payments.map((p) => (
          <span class="px-3 py-1 rounded-full bg-white/5 border border-white/15">{p}</span>
        ))}
      </div>
    </div>
  </section>

  <section id="features" class="bg-ink text-paper py-24 md:py-32">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16">
        <span class="inline-block px-3 py-1 rounded-full bg-turquesa/15 text-turquesa-light text-xs font-bold uppercase tracking-widest">Features</span>
        <h2 class="mt-4 font-display text-5xl md:text-7xl font-bold tracking-tightest leading-[0.95]">{dict.features?.title ?? ''}</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {dict.features?.items?.map((it: any) => (
          <div class="bg-white/5 backdrop-blur rounded-3xl p-7 border border-white/10 hover:bg-white/10 hover:border-turquesa/40 transition">
            <div class="text-4xl">{it.icon}</div>
            <div class="mt-5 font-display font-bold text-xl text-paper">{it.title}</div>
            <p class="mt-3 text-sm text-paper/60 leading-relaxed">{it.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Comparison table vs competition (kill objections) -->
  {cmp && (
    <section id="vs" class="bg-ink text-paper py-20 md:py-28 border-t border-white/10">
      <div class="max-w-5xl mx-auto px-6">
        <div class="text-center mb-12">
          <span class="inline-block px-3 py-1 rounded-full bg-warning/15 text-warning text-xs font-bold uppercase tracking-widest">vs · toda la competencia actual</span>
          <h2 class="mt-4 font-display text-4xl md:text-6xl font-bold tracking-tightest leading-[0.95]">{vsLabel}</h2>
        </div>
        <div class="overflow-x-auto rounded-2xl border border-white/10">
          <table class="w-full text-left text-sm md:text-base">
            <thead class="bg-white/5">
              <tr>
                <th class="px-4 py-4 font-semibold text-paper/70"></th>
                {cmp.headers?.map((h: string, i: number) => (
                  <th class={`px-4 py-4 font-bold ${i === 0 ? 'text-turquesa-light' : 'text-paper/60'}`}>
                    {h}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {cmp.rows?.map((r: any) => (
                <tr class="border-t border-white/5">
                  <td class="px-4 py-4 text-paper/85 font-medium">{r.feature}</td>
                  {r.values?.map((v: boolean, i: number) => (
                    <td class="px-4 py-4">
                      {v ? (
                        <span class={`inline-flex w-7 h-7 rounded-full items-center justify-center font-bold ${i === 0 ? 'bg-turquesa text-white' : 'bg-paper/10 text-paper/70'}`}>✓</span>
                      ) : (
                        <span class="inline-flex w-7 h-7 rounded-full items-center justify-center bg-error/20 text-error/80 font-bold">✗</span>
                      )}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  <!-- TikTok challenge band · #ZymploChallenge -->
  <section class="bg-gradient-to-r from-purple via-turquesa to-azul py-12 md:py-16">
    <div class="max-w-5xl mx-auto px-6 text-center">
      <span class="inline-block px-3 py-1 rounded-full bg-white/15 backdrop-blur border border-white/30 text-white text-xs font-bold uppercase tracking-widest">🔥 viral challenge</span>
      <h2 class="mt-4 font-display text-3xl md:text-5xl font-bold tracking-tightest text-white leading-tight">
        {challengeLabel}
      </h2>
      <p class="mt-3 text-base md:text-lg text-white font-semibold">{challengePrize}</p>
      <div class="mt-6 flex flex-wrap gap-3 justify-center">
        <a href="https://www.tiktok.com/tag/zymplochallenge" target="_blank" rel="noopener" class="bg-black text-white font-semibold text-sm px-5 py-3 rounded-full hover:bg-ink transition inline-flex items-center gap-2">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64 2.93 2.93 0 01.88.13V9.4a6.84 6.84 0 00-1-.05A6.33 6.33 0 005.8 20.1a6.34 6.34 0 0010.86-4.43v-7a8.16 8.16 0 004.77 1.52v-3.4a4.85 4.85 0 01-1.84-.1z"/></svg>
          Ver TikTok
        </a>
        <a href="https://www.instagram.com/explore/tags/zymplochallenge/" target="_blank" rel="noopener" class="bg-white text-ink font-semibold text-sm px-5 py-3 rounded-full hover:bg-paper transition">
          Ver Instagram
        </a>
      </div>
    </div>
  </section>

  <ToolsCarousel slug={slug} />
  <PricingTable client:visible slug={slug} country={c} dict={dict} />

  {faq && (
    <section id="faq" class="bg-ink text-paper py-20 md:py-28 border-t border-white/10">
      <div class="max-w-3xl mx-auto px-6">
        <div class="text-center mb-12">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-turquesa/15 text-turquesa-light text-xs font-bold uppercase tracking-widest">{faq.eyebrow}</span>
          <h2 class="mt-4 font-display text-4xl md:text-5xl font-bold tracking-tightest text-paper">{faq.title}</h2>
        </div>
        <div class="space-y-3">
          {faq.items?.map((it: any) => (
            <details class="group bg-white/5 backdrop-blur rounded-2xl border border-white/10 hover:border-turquesa/40 transition">
              <summary class="flex items-center justify-between cursor-pointer p-5 list-none">
                <span class="font-semibold text-paper">{it.q}</span>
                <span class="text-turquesa-light text-xl group-open:rotate-45 transition">+</span>
              </summary>
              <div class="px-5 pb-5 text-paper/70 leading-relaxed">{it.a}</div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

</CountryLayout>

<style>
  @keyframes bounce-slow {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-30px) rotate(8deg); }
  }
  :global(.animate-bounce-slow) { animation: bounce-slow 6s ease-in-out infinite; }
  @keyframes fade-in {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }
  :global(.animate-fade-in) { animation: fade-in 0.5s ease-out; }
</style>
