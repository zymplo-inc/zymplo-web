---
import CountryLayout from '@layouts/CountryLayout.astro';
import { COUNTRY_SLUGS, type CountrySlug } from '@data/countries';

export function getStaticPaths() {
  return COUNTRY_SLUGS.map((slug) => ({ params: { country: slug } }));
}
const { country: slug } = Astro.params as { country: CountrySlug };
---
<CountryLayout slug={slug} title="Zymplo · Plan B descontinuado">
  <section class="organic-bg relative max-w-3xl mx-auto px-6 py-32 text-center">
    <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-turquesa-paler text-turquesa-deeper text-xs font-bold uppercase tracking-wider">Aviso</span>
    <h1 class="font-display text-4xl md:text-5xl font-bold tracking-tightest mt-6">Plan B descontinuado</h1>
    <p class="mt-6 text-xl text-mute">Zymplo agora foca direto no microempreendedor. Confira os 4 planos atuais para o seu país.</p>
    <a href={`/${slug}/precios/`} class="mt-10 inline-flex bg-turquesa text-white px-8 py-4 rounded-full font-bold">Ver planos atuais</a>
  </section>
</CountryLayout>
