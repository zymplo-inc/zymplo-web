---
const title = 'Zymplo · Manifesto Lab · V16';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0A0B14" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="https://sims.zymplo.com/brand/isotipo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;700;800;900&family=Inter:wght@400;500;700&display=swap" />
    <style is:inline>
      :root { --bg: #0A0B14; --paper: #FAFBFF; --turq: #14B8A6; --turq-light: #5EEAD4; --turq-paler: #CCFBF1; --mute: #6B7280; }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: 'Sora', sans-serif; background: var(--bg); color: var(--paper); min-height: 100vh; overflow-x: hidden; }

      .nav-back { position: fixed; top: 14px; left: 14px; z-index: 100; padding: 6px 12px 6px 6px; background: rgba(255,255,255,0.06); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.15); border-radius: 999px; font-size: 12px; font-weight: 700; color: var(--paper); text-decoration: none; display: flex; align-items: center; gap: 6px; font-family: 'Inter', sans-serif; }
      .nav-back img { height: 18px; }
      .lab-badge { position: fixed; top: 14px; right: 14px; z-index: 100; padding: 6px 12px; background: rgba(255,255,255,0.06); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.15); border-radius: 999px; font-size: 11px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--paper); text-decoration: none; font-family: 'Inter', sans-serif; }

      .stage { max-width: 1280px; margin: 0 auto; padding: 80px 22px 60px; }

      .pre { font-family: 'Inter', sans-serif; font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--turq-light); font-weight: 800; opacity: 0.85; }

      .manifesto { font-family: 'Sora', sans-serif; font-weight: 800; font-size: clamp(34px, 6.5vw, 96px); letter-spacing: -0.04em; line-height: 1.1; margin-top: 36px; }
      .manifesto p { display: block; padding: 16px 0; border-bottom: 1px solid rgba(255,255,255,0.08); transition: all 0.4s ease-out; opacity: 0.4; transform: translateX(-12px); }
      .manifesto p.visible { opacity: 1; transform: translateX(0); }
      .manifesto p.strong { color: var(--paper); }
      .manifesto p.med { color: rgba(255,255,255,0.85); }
      .manifesto p.dim { color: rgba(255,255,255,0.6); font-weight: 500; font-size: 0.85em; }
      .manifesto p .turq { background: linear-gradient(115deg, var(--turq-light), var(--turq-paler)); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .manifesto p .strike { text-decoration: line-through; color: var(--mute); font-weight: 500; }
      .manifesto p .underline { text-decoration: underline; text-decoration-color: var(--turq); text-decoration-thickness: 4px; text-underline-offset: 6px; }

      .signature { margin-top: 80px; padding-top: 32px; border-top: 1px solid rgba(255,255,255,0.15); display: grid; grid-template-columns: 1fr; gap: 32px; align-items: end; }
      @media (min-width: 768px) { .signature { grid-template-columns: 1.4fr 1fr; } }
      .signature .left { font-family: 'Inter', sans-serif; font-size: 13px; color: rgba(255,255,255,0.55); line-height: 1.6; }
      .signature .left strong { color: var(--paper); display: block; margin-top: 8px; font-family: 'Sora', sans-serif; font-weight: 700; font-size: 16px; letter-spacing: -0.01em; }
      .signature .left .stamp { display: inline-block; margin-top: 14px; padding: 6px 12px; border: 1px solid rgba(255,255,255,0.25); border-radius: 999px; font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--turq-light); }

      .cta-box { padding: 28px; background: rgba(94,234,212,0.06); border: 1px solid rgba(94,234,212,0.3); border-radius: 22px; }
      .cta-box .label { font-family: 'Inter', sans-serif; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--turq-light); font-weight: 800; }
      .cta-box .h { font-family: 'Sora', sans-serif; font-weight: 800; font-size: 26px; letter-spacing: -0.03em; margin-top: 8px; }
      .cta-box .btn { display: inline-flex; align-items: center; gap: 10px; margin-top: 18px; padding: 14px 24px; background: var(--paper); color: var(--bg); border-radius: 999px; font-family: 'Inter', sans-serif; font-weight: 800; font-size: 15px; text-decoration: none; transition: all 0.25s; }
      .cta-box .btn:hover { transform: translateY(-2px); }
      .cta-box .btn::after { content: '→'; }
      .cta-box .micro { margin-top: 12px; font-family: 'Inter', sans-serif; font-size: 12px; color: rgba(255,255,255,0.55); }

      .footer { padding: 32px 22px; text-align: center; font-size: 12px; color: rgba(255,255,255,0.45); font-family: 'Inter', sans-serif; }
      .footer a { color: rgba(255,255,255,0.75); text-decoration: none; margin: 0 8px; }
      @media (prefers-reduced-motion: reduce) { .manifesto p { opacity: 1 !important; transform: none !important; } }
    </style>
  </head>
  <body>
    <a class="nav-back" href="/lab/"><img src="https://sims.zymplo.com/brand/isotipo.svg" alt="Zymplo" />← Lab</a>
    <a class="lab-badge" href="/lab/">16 · Manifesto</a>

    <div class="stage">
      <span class="pre">— Manifiesto · Mayo MMXXVI</span>

      <div class="manifesto">
        <p class="strong">Cobrar <span class="strike">duele</span>.</p>
        <p class="strong">No tiene <span class="underline">por qué</span>.</p>
        <p class="med">No naciste para perseguir gente que te debe.</p>
        <p class="med">Naciste para hacer lo que sabés hacer · y que la plata entre.</p>
        <p class="strong">Por eso existe <span class="turq">Zymplo</span>.</p>
        <p class="dim">Una secretaria IA · que vive dentro de WhatsApp.</p>
        <p class="med">Sin app · sin signup · sin contraseñas · sin "registrate primero".</p>
        <p class="med">Le hablás como a un amigo. Te entiende. Te resuelve.</p>
        <p class="strong">Cobra · sin perseguir.</p>
        <p class="strong">Factura · hablando.</p>
        <p class="strong">Te recuerda · todo.</p>
        <p class="strong">Trabaja · 24/7.</p>
        <p class="med">Sin sueldo · sin vacaciones · sin que falte un día.</p>
        <p class="dim">No es un CRM. No es un ERP. No es un SaaS más.</p>
        <p class="med">Es la herramienta más usada del mundo · convertida en tu sistema operativo.</p>
        <p class="strong"><span class="turq">13 países.</span> 3 idiomas. Una promesa:</p>
        <p class="strong">que dejes de perder tiempo con lo que no te toca.</p>
        <p class="dim">Y que cobres · por fin · sin perseguir a nadie.</p>
      </div>

      <div class="signature">
        <div class="left">
          Firmado por la gente que ya lo está usando<br/>
          <strong>12,847 personas en 13 países</strong>
          <br/>
          $ 47.28M cobrados este mes · 847 se sumaron hoy
          <br/>
          <span class="stamp">★ EN VIVO ★ MAYO 2026</span>
        </div>

        <div class="cta-box">
          <div class="label">SUMATE</div>
          <div class="h">Empezá hoy.<br/>Sin fricción.</div>
          <a class="btn" href="https://wa.me/595981970735?text=Quiero%20probar%20Zymplo">Probar gratis</a>
          <div class="micro">funciona desde tu WhatsApp · gratis para siempre</div>
        </div>
      </div>
    </div>

    <footer class="footer">© 2026 Zymplo · Manifesto Edition · <a href="/lab/">Lab</a> · <a href="/">Landing</a> · <a href="/lab/v17/">V17 →</a></footer>

    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduceMotion) { document.querySelectorAll('.manifesto p').forEach((p) => p.classList.add('visible')); }
      else {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); } });
        }, { threshold: 0.5 });
        document.querySelectorAll('.manifesto p').forEach((p) => io.observe(p));
      }
    </script>
  </body>
</html>
