---
const title = 'Zymplo · Interactive Demo Lab · V15';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0F172A" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="https://sims.zymplo.com/brand/isotipo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" />
    <style is:inline>
      :root { --bg: #0A0B14; --bg-2: #0F172A; --turq: #14B8A6; --turq-light: #5EEAD4; --turq-paler: #CCFBF1; --paper: #FAFBFF; --mute: #6B7280; --good: #22C55E; --wa-bg: #0B141A; --wa-header: #1F2C33; --wa-bot: #1F2C33; --wa-usr: #005C4B; }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--paper); min-height: 100vh; overflow-x: hidden; }
      body::before { content: ''; position: fixed; inset: 0; background: radial-gradient(ellipse 70% 50% at 50% 0%, rgba(20,184,166,0.18) 0%, transparent 60%); pointer-events: none; z-index: 0; }

      .nav-back { position: fixed; top: 14px; left: 14px; z-index: 100; padding: 6px 12px 6px 6px; background: rgba(255,255,255,0.06); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.15); border-radius: 999px; font-size: 12px; font-weight: 700; color: var(--paper); text-decoration: none; display: flex; align-items: center; gap: 6px; }
      .nav-back img { height: 18px; }
      .lab-badge { position: fixed; top: 14px; right: 14px; z-index: 100; padding: 6px 12px; background: rgba(20,184,166,0.18); backdrop-filter: blur(20px); border: 1px solid rgba(20,184,166,0.4); border-radius: 999px; color: var(--turq-light); font-size: 11px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; text-decoration: none; }

      .wrap { position: relative; z-index: 2; max-width: 1280px; margin: 0 auto; padding: 60px 22px 60px; display: grid; grid-template-columns: 1fr; gap: 40px; align-items: center; }
      @media (min-width: 1024px) { .wrap { grid-template-columns: 1fr 1fr; gap: 60px; } }

      .pre { display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; background: rgba(20,184,166,0.1); border: 1px solid rgba(20,184,166,0.3); border-radius: 999px; font-size: 11px; font-weight: 800; letter-spacing: 0.18em; text-transform: uppercase; color: var(--turq-light); }
      .pre .pulse { width: 7px; height: 7px; border-radius: 50%; background: var(--turq-light); box-shadow: 0 0 10px var(--turq-light); animation: pulse 1.8s infinite; }
      @keyframes pulse { 50% { opacity: 0.5; transform: scale(1.3); } }

      h1 { font-family: 'Sora', sans-serif; font-weight: 900; font-size: clamp(40px, 7vw, 84px); letter-spacing: -0.045em; line-height: 0.95; margin-top: 22px; }
      h1 em { font-style: normal; background: linear-gradient(115deg, var(--turq-light), var(--turq-paler)); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .sub { margin-top: 22px; font-size: clamp(15px, 2vw, 19px); color: rgba(255,255,255,0.7); line-height: 1.5; max-width: 480px; }
      .demo-hint { margin-top: 16px; padding: 12px 16px; background: rgba(255,255,255,0.04); border: 1px dashed rgba(94,234,212,0.45); border-radius: 14px; font-size: 13px; color: var(--turq-light); }
      .demo-hint::before { content: '👉 '; }

      .quick-prompts { margin-top: 22px; }
      .quick-prompts .label { font-size: 11px; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: var(--mute); margin-bottom: 10px; }
      .qp { display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.12); color: rgba(255,255,255,0.85); border-radius: 999px; font-size: 13px; cursor: pointer; transition: all 0.2s; margin: 4px 4px 4px 0; }
      .qp:hover { background: rgba(94,234,212,0.12); border-color: var(--turq-light); color: var(--turq-light); }

      .cta { margin-top: 28px; display: inline-flex; align-items: center; gap: 10px; padding: 16px 26px; background: var(--turq); color: var(--bg); border-radius: 999px; font-weight: 800; font-size: 15px; text-decoration: none; box-shadow: 0 14px 50px rgba(20,184,166,0.4); transition: all 0.3s; }
      .cta:hover { transform: translateY(-2px); box-shadow: 0 22px 60px rgba(20,184,166,0.55); }
      .cta::after { content: '→'; }

      /* Phone */
      .phone-stage { display: flex; justify-content: center; }
      .phone { width: 360px; max-width: 100%; aspect-ratio: 9/19; background: linear-gradient(160deg, #1a1a1d 0%, #0d0e10 100%); border-radius: 44px; padding: 8px; box-shadow: 0 40px 100px rgba(0,0,0,0.55), 0 0 100px rgba(20,184,166,0.18); border: 1.5px solid #2a2a2d; position: relative; }
      .phone-screen { width: 100%; height: 100%; border-radius: 36px; background: var(--wa-bg); overflow: hidden; display: flex; flex-direction: column; position: relative; }
      .phone-notch { position: absolute; top: 8px; left: 50%; transform: translateX(-50%); width: 110px; height: 28px; background: black; border-radius: 16px; z-index: 10; }
      .wa-top { padding: 38px 14px 10px; background: var(--wa-header); display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
      .wa-top .av { width: 36px; height: 36px; border-radius: 50%; background: var(--turq); display: flex; align-items: center; justify-content: center; }
      .wa-top .av img { width: 22px; height: 22px; filter: brightness(0) invert(1); }
      .wa-top .id { flex: 1; min-width: 0; }
      .wa-top .id .n { font-size: 14px; font-weight: 700; color: white; line-height: 1.1; }
      .wa-top .id .s { font-size: 11px; color: rgba(255,255,255,0.55); margin-top: 2px; display: flex; align-items: center; gap: 4px; }
      .wa-top .id .s::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--good); }
      .wa-body { flex: 1; padding: 14px 10px; background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="200" height="200"><defs><pattern id="p" patternUnits="userSpaceOnUse" width="40" height="40"><circle cx="20" cy="20" r="1" fill="rgba(255,255,255,0.04)"/></pattern></defs><rect width="100%" height="100%" fill="%230B141A"/><rect width="100%" height="100%" fill="url(%23p)"/></svg>'); display: flex; flex-direction: column; gap: 6px; overflow-y: auto; scroll-behavior: smooth; }
      .wa-body::-webkit-scrollbar { width: 4px; }
      .wa-body::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); }
      .b { max-width: 80%; padding: 7px 11px 5px; border-radius: 13px; font-size: 13px; line-height: 1.38; opacity: 0; transform: translateY(8px); animation: bub-in 0.35s cubic-bezier(0.22,1,0.36,1) forwards; }
      @keyframes bub-in { to { opacity: 1; transform: translateY(0); } }
      .b.bot { align-self: flex-start; background: var(--wa-bot); color: white; border-bottom-left-radius: 4px; }
      .b.usr { align-self: flex-end; background: var(--wa-usr); color: white; border-bottom-right-radius: 4px; }
      .b .ts { display: block; margin-top: 2px; font-size: 9px; opacity: 0.55; text-align: right; }
      .b.usr .ts::after { content: ' ✓✓'; color: var(--turq-light); }
      .typing { align-self: flex-start; padding: 10px 12px; border-radius: 13px; border-bottom-left-radius: 4px; background: var(--wa-bot); display: inline-flex; gap: 3px; }
      .typing span { width: 6px; height: 6px; border-radius: 50%; background: rgba(255,255,255,0.5); animation: dot 1.3s ease-in-out infinite; }
      .typing span:nth-child(2) { animation-delay: 0.2s; }
      .typing span:nth-child(3) { animation-delay: 0.4s; }
      @keyframes dot { 0%, 100% { transform: translateY(0); opacity: 0.5; } 50% { transform: translateY(-3px); opacity: 1; } }
      .compose { padding: 8px 10px 10px; background: var(--wa-header); display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
      .compose input { flex: 1; padding: 9px 14px; background: #2A3942; border-radius: 999px; border: 0; color: white; font-size: 13px; font-family: inherit; outline: none; }
      .compose input::placeholder { color: rgba(255,255,255,0.4); }
      .compose .send { width: 38px; height: 38px; border-radius: 50%; background: var(--turq); border: 0; color: white; font-size: 18px; cursor: pointer; transition: transform 0.15s; }
      .compose .send:hover { transform: scale(1.06); }

      .footer { padding: 32px 22px; text-align: center; font-size: 12px; color: rgba(255,255,255,0.4); position: relative; z-index: 2; }
      .footer a { color: rgba(255,255,255,0.7); text-decoration: none; margin: 0 8px; }
      @media (prefers-reduced-motion: reduce) { .b, .typing span { animation: none !important; opacity: 1; transform: none; } }
    </style>
  </head>
  <body>
    <a class="nav-back" href="/lab/"><img src="https://sims.zymplo.com/brand/isotipo.svg" alt="Zymplo" />← Lab</a>
    <a class="lab-badge" href="/lab/">15 · DEMO</a>

    <main class="wrap">
      <div>
        <span class="pre"><span class="pulse"></span>DEMO INTERACTIVA · ESCRIBÍ AL TELÉFONO</span>
        <h1>Probalo <em>acá mismo</em>.<br/>Sin registrar nada.</h1>
        <p class="sub">Mandá un mensaje al teléfono de la derecha. Zé te responde como en WhatsApp real. Cuando te guste · pasamos al WhatsApp tuyo.</p>
        <div class="demo-hint">Probá: "cuánto cobré este mes" · "factura a Pablo 850000" · "recordame mañana 9 ir al taller"</div>

        <div class="quick-prompts">
          <div class="label">Prompts sugeridos</div>
          <button class="qp" data-prompt="Cuánto cobré este mes?">📊 cuánto cobré este mes</button>
          <button class="qp" data-prompt="Factura a Pablo 850000">🧾 factura a Pablo 850000</button>
          <button class="qp" data-prompt="Recordame mañana 9 ir al taller">📅 recordame mañana 9</button>
          <button class="qp" data-prompt="Cobrar a Maria 250">💸 cobrar a Maria 250</button>
        </div>

        <a class="cta" href="https://wa.me/595981970735?text=Quiero%20probar%20Zymplo">Pasarlo a mi WhatsApp gratis</a>
      </div>

      <div class="phone-stage">
        <div class="phone">
          <div class="phone-screen">
            <div class="phone-notch"></div>
            <div class="wa-top">
              <div class="av"><img src="https://sims.zymplo.com/brand/isotipo.svg" alt=""/></div>
              <div class="id">
                <div class="n">Zé · de Zymplo</div>
                <div class="s">en línea · responde rápido</div>
              </div>
            </div>
            <div class="wa-body" id="chat">
              <div class="b bot">Hola 👋 Soy Zé · tu secretaria IA. Probame · escribime cualquier cosa<span class="ts">14:32</span></div>
            </div>
            <div class="compose">
              <input id="input" type="text" placeholder="Escribí un mensaje…" autocomplete="off" />
              <button class="send" id="send" aria-label="Enviar">→</button>
            </div>
          </div>
        </div>
      </div>
    </main>

    <footer class="footer">© 2026 Zymplo · Interactive Demo · <a href="/lab/">Lab</a> · <a href="/">Landing</a> · <a href="/lab/v16/">V16 →</a></footer>

    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const chat = document.getElementById('chat');
      const input = document.getElementById('input');
      const send = document.getElementById('send');

      const t = () => new Date().toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' });
      function addBub(side, html) {
        const b = document.createElement('div'); b.className = 'b ' + side; b.innerHTML = html + '<span class="ts">' + t() + '</span>'; chat.appendChild(b); chat.scrollTop = chat.scrollHeight;
        return b;
      }
      function showTyping() {
        const tp = document.createElement('div'); tp.className = 'typing'; tp.innerHTML = '<span></span><span></span><span></span>'; chat.appendChild(tp); chat.scrollTop = chat.scrollHeight; return tp;
      }

      // Simple intent matcher · responses scripted
      function reply(msg) {
        const m = msg.toLowerCase();
        if (/(cu[aá]nto.*cobr[eé]|c[oó]mo voy|resumen|este mes)/.test(m)) {
          return ['📊 Este mes vas <strong>$ 2.847.000</strong> ✨', 'Detalle:<br/>· cobrado: ₲ 2.847k<br/>· pendiente: ₲ 850k (Pablo)<br/>· gastado: ₲ 320k', '¿Querés que le mande recordatorio a Pablo?'];
        }
        if (/(factur[ae]|nfse|cfdi)/.test(m)) {
          const monto = m.match(/(\d{3,})/);
          const a = m.match(/a\s+([a-zà-ÿ]+)/i);
          return [
            '🧾 Anotado · factura para ' + (a ? '<strong>' + a[1] + '</strong>' : 'tu cliente') + (monto ? ' por <strong>₲ ' + Number(monto[1]).toLocaleString('es-AR') + '</strong>' : ''),
            'Genero NFS-e ahora · ¿lo mando por WhatsApp directo a tu cliente?',
          ];
        }
        if (/(recordame|recuerdame|reminder|aviso)/.test(m)) {
          return ['📅 Listo · te aviso ' + (m.includes('mañana') ? '<strong>mañana</strong>' : 'cuando me digas') + '.', 'Si querés ajustar la hora · escribí "a las 9:30" o lo que prefieras 👌'];
        }
        if (/(cobrar?|cobranza)/.test(m)) {
          const monto = m.match(/(\d{3,})/);
          const a = m.match(/a\s+([a-zà-ÿ]+)/i);
          return [
            '💸 Mensaje listo para ' + (a ? '<strong>' + a[1] + '</strong>' : 'tu cliente') + (monto ? ' · <strong>₲ ' + Number(monto[1]).toLocaleString('es-AR') + '</strong>' : ''),
            'Te lo mando suave estilo "buenas, te paso para confirmar el saldo del trabajo. ¿pago hoy o mañana?". <strong>¿Lo envío?</strong>',
          ];
        }
        if (/(plan|precio|cu[aá]nto sale|cuesta)/.test(m)) {
          return ['💎 Tengo 4 planes:<br/>0 · gratis para siempre (lo que estás probando)<br/>1 · STARTER R$19/mes · más mensajes<br/>2 · PRO R$39/mes · UNLIMITED ✨ <em>el más popular</em><br/>3 · GOLD R$79/mes · UNLIMITED + premium', '¿Cuál te interesa? podés arrancar gratis sin tarjeta'];
        }
        if (/(hola|hi|hey|qu[eé] tal|buenas)/.test(m)) {
          return ['¡Hola! 👋 ¿Qué te gustaría probar?', 'Probá pedirme: "cuánto cobré este mes" · "factura a Pablo 850000" · "recordame mañana 9"'];
        }
        return ['Buenísimo · te lo resuelvo. Probá pedirme algo concreto: <em>cobrar</em> · <em>facturar</em> · <em>recordame</em> · <em>cómo voy este mes</em>.', 'O si querés pasarlo a tu WhatsApp real → tap en "Pasarlo a mi WhatsApp" 👇'];
      }

      function userSends(msg) {
        if (!msg.trim()) return;
        addBub('usr', msg);
        input.value = '';
        const tp = showTyping();
        const responses = reply(msg);
        responses.forEach((r, i) => {
          setTimeout(() => {
            if (i === 0) tp.remove();
            addBub('bot', r);
          }, reduceMotion ? 0 : 700 + i * 1000);
        });
      }

      send.addEventListener('click', () => userSends(input.value));
      input.addEventListener('keydown', (e) => { if (e.key === 'Enter') userSends(input.value); });
      document.querySelectorAll('.qp').forEach((b) => b.addEventListener('click', () => { userSends(b.dataset.prompt); }));
    </script>
  </body>
</html>
