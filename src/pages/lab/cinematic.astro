---
const title = 'Zymplo · Cinematic Lab · Variant A';
const description = 'Scroll-driven cinematic landing. Tu secretaria IA en WhatsApp.';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0A0B14" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="https://sims.zymplo.com/brand/isotipo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Sora:wght@400;500;600;700;800;900&display=swap" />
    <style is:inline>
      :root { --turquesa: #14B8A6; --turquesa-light: #5EEAD4; --turquesa-paler: #CCFBF1; --turquesa-deep: #0B6B62; --ink: #0A0B14; --ink-2: #0F172A; --paper: #FAFBFF; --purple: #623AE6; }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body { font-family: 'Manrope', sans-serif; background: var(--ink); color: white; overflow-x: hidden; }

      /* lab badge top-right */
      .lab-badge { position: fixed; top: 16px; right: 16px; z-index: 100; padding: 6px 12px; background: rgba(255,255,255,0.06); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.15); border-radius: 999px; font-size: 11px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.85); text-decoration: none; transition: all 0.3s; }
      .lab-badge:hover { background: rgba(255,255,255,0.12); color: white; }

      /* nav */
      .nav { position: fixed; top: 16px; left: 16px; z-index: 100; display: flex; align-items: center; gap: 8px; padding: 6px 14px 6px 8px; background: rgba(255,255,255,0.04); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.1); border-radius: 999px; text-decoration: none; color: white; font-weight: 800; font-size: 14px; transition: all 0.3s; }
      .nav:hover { background: rgba(255,255,255,0.08); }
      .nav img { height: 22px; }

      /* HERO · sticky scroll */
      .hero { position: relative; min-height: 280vh; }
      .hero-sticky { position: sticky; top: 0; height: 100vh; display: flex; align-items: center; justify-content: center; overflow: hidden; }

      /* gradient mesh BG */
      .mesh-bg { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
      .mesh-bg::before, .mesh-bg::after, .mesh-bg .blob { content: ''; position: absolute; border-radius: 50%; filter: blur(100px); }
      .mesh-bg::before { top: -10%; right: -10%; width: 60vw; height: 60vw; background: radial-gradient(circle, var(--turquesa) 0%, transparent 70%); opacity: 0.45; will-change: transform; }
      .mesh-bg::after { bottom: -15%; left: -10%; width: 55vw; height: 55vw; background: radial-gradient(circle, var(--purple) 0%, transparent 70%); opacity: 0.3; will-change: transform; }
      .mesh-bg .blob { top: 35%; left: 35%; width: 35vw; height: 35vw; background: radial-gradient(circle, var(--turquesa-light) 0%, transparent 70%); opacity: 0.18; will-change: transform; }

      /* dot grid */
      .dot-grid { position: absolute; inset: 0; background-image: radial-gradient(circle, rgba(255,255,255,0.08) 1px, transparent 1px); background-size: 32px 32px; pointer-events: none; mask-image: radial-gradient(ellipse 80% 60% at center, black 0%, transparent 80%); -webkit-mask-image: radial-gradient(ellipse 80% 60% at center, black 0%, transparent 80%); }

      .hero-grid { position: relative; z-index: 2; max-width: 1280px; width: 100%; margin: 0 auto; padding: 0 24px; display: grid; grid-template-columns: 1fr; gap: 40px; align-items: center; }
      @media (min-width: 1024px) { .hero-grid { grid-template-columns: 1.1fr 1fr; gap: 60px; } }

      /* HEADLINE · word-reveal */
      .h-eyebrow { display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.15); border-radius: 999px; font-size: 11px; font-weight: 800; letter-spacing: 0.18em; text-transform: uppercase; color: var(--turquesa-light); }
      .h-eyebrow .pulse { width: 6px; height: 6px; border-radius: 50%; background: var(--turquesa-light); box-shadow: 0 0 0 0 var(--turquesa-light); animation: pulse-soft 2.4s ease-out infinite; }
      @keyframes pulse-soft { 0% { box-shadow: 0 0 0 0 rgba(94,234,212,0.7); } 70% { box-shadow: 0 0 0 12px rgba(94,234,212,0); } 100% { box-shadow: 0 0 0 0 rgba(94,234,212,0); } }

      h1.cinematic { font-family: 'Sora', sans-serif; font-weight: 900; letter-spacing: -0.05em; line-height: 0.92; font-size: clamp(48px, 9vw, 132px); margin-top: 22px; }
      h1.cinematic .word { display: inline-block; opacity: 0; transform: translateY(40px); filter: blur(8px); transition: opacity 0.9s cubic-bezier(0.22,1,0.36,1), transform 0.9s cubic-bezier(0.22,1,0.36,1), filter 0.9s cubic-bezier(0.22,1,0.36,1); margin-right: 0.18em; }
      h1.cinematic .word.visible { opacity: 1; transform: translateY(0); filter: blur(0); }
      h1.cinematic .accent { background: linear-gradient(115deg, var(--turquesa-light) 0%, var(--turquesa-paler) 35%, white 70%, var(--turquesa-light) 100%); background-size: 200% 200%; -webkit-background-clip: text; background-clip: text; color: transparent; animation: shimmer-cine 6s ease-in-out infinite; }
      @keyframes shimmer-cine { 0%,100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }

      .h-sub { margin-top: 26px; font-size: clamp(16px, 2vw, 22px); font-weight: 500; color: rgba(255,255,255,0.7); max-width: 520px; line-height: 1.45; opacity: 0; transform: translateY(20px); transition: opacity 1s 0.6s, transform 1s 0.6s; }
      .h-sub.visible { opacity: 1; transform: translateY(0); }

      .h-cta { margin-top: 36px; display: flex; flex-wrap: wrap; gap: 14px; align-items: center; opacity: 0; transform: translateY(20px); transition: opacity 1s 0.9s, transform 1s 0.9s; }
      .h-cta.visible { opacity: 1; transform: translateY(0); }
      .btn { display: inline-flex; align-items: center; gap: 10px; padding: 16px 28px; border-radius: 999px; font-weight: 800; font-size: 16px; text-decoration: none; transition: all 0.25s cubic-bezier(0.22,1,0.36,1); position: relative; overflow: hidden; }
      .btn-primary { background: white; color: var(--ink); box-shadow: 0 14px 60px rgba(94,234,212,0.25); }
      .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 22px 80px rgba(94,234,212,0.4); }
      .btn-primary::after { content: '→'; transition: transform 0.3s; }
      .btn-primary:hover::after { transform: translateX(4px); }
      .btn-ghost { color: rgba(255,255,255,0.85); background: transparent; border: 1px solid rgba(255,255,255,0.2); }
      .btn-ghost:hover { background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.4); color: white; }

      .micro { margin-top: 14px; font-size: 13px; color: rgba(255,255,255,0.55); display: flex; gap: 18px; flex-wrap: wrap; }
      .micro span { display: inline-flex; align-items: center; gap: 6px; }
      .micro span::before { content: '✓'; color: var(--turquesa-light); font-weight: 800; }

      /* IPHONE 3D · scroll-driven */
      .phone-stage { position: relative; height: 600px; perspective: 1800px; transform-style: preserve-3d; }
      .phone { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%) rotateY(-12deg) rotateX(4deg); width: 320px; height: 580px; border-radius: 48px; background: linear-gradient(160deg, #1a1a1d 0%, #0d0e10 100%); border: 1.5px solid #2a2a2d; box-shadow: 0 40px 100px rgba(0,0,0,0.55), 0 0 0 1px rgba(94,234,212,0.08), 0 0 80px rgba(20,184,166,0.18); padding: 8px; will-change: transform; transition: transform 0.1s linear; }
      .phone-screen { position: relative; width: 100%; height: 100%; border-radius: 40px; background: #0F1B14; overflow: hidden; }
      .phone-notch { position: absolute; top: 8px; left: 50%; transform: translateX(-50%); width: 110px; height: 28px; background: black; border-radius: 16px; z-index: 10; }
      .wa-header { position: absolute; top: 0; left: 0; right: 0; padding: 38px 14px 10px; background: #1F2C33; display: flex; align-items: center; gap: 10px; z-index: 5; }
      .wa-avatar { width: 36px; height: 36px; border-radius: 50%; background: var(--turquesa); display: flex; align-items: center; justify-content: center; }
      .wa-avatar img { width: 22px; height: 22px; filter: brightness(0) invert(1); }
      .wa-info { flex: 1; min-width: 0; }
      .wa-info .n { font-size: 14px; font-weight: 700; color: white; line-height: 1.1; }
      .wa-info .s { font-size: 11px; color: rgba(255,255,255,0.55); margin-top: 2px; }
      .wa-info .s::before { content: '·'; color: var(--turquesa-light); margin-right: 4px; font-weight: 800; }
      .wa-body { position: absolute; top: 80px; bottom: 0; left: 0; right: 0; padding: 18px 12px; display: flex; flex-direction: column; gap: 8px; background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="200" height="200"><defs><pattern id="p" patternUnits="userSpaceOnUse" width="40" height="40"><circle cx="20" cy="20" r="1" fill="rgba(255,255,255,0.04)"/></pattern></defs><rect width="100%" height="100%" fill="%230b141a"/><rect width="100%" height="100%" fill="url(%23p)"/></svg>'); }
      .bubble { max-width: 80%; padding: 8px 12px; border-radius: 14px; font-size: 13px; line-height: 1.35; word-break: break-word; opacity: 0; transform: translateY(8px); animation: bubble-in 0.5s cubic-bezier(0.22,1,0.36,1) forwards; }
      .bubble.usr { align-self: flex-end; background: #005C4B; color: white; border-bottom-right-radius: 4px; }
      .bubble.bot { align-self: flex-start; background: #1F2C33; color: white; border-bottom-left-radius: 4px; }
      .bubble small { display: block; margin-top: 4px; font-size: 9px; opacity: 0.6; text-align: right; }
      @keyframes bubble-in { to { opacity: 1; transform: translateY(0); } }
      .b1 { animation-delay: 1.2s; }
      .b2 { animation-delay: 2.4s; }
      .b3 { animation-delay: 3.6s; }
      .b4 { animation-delay: 5s; }

      /* SECTION · Conocé a Zé */
      .meet { padding: 200px 0 120px; position: relative; }
      .meet .quote { max-width: 1100px; margin: 0 auto; padding: 0 24px; font-family: 'Sora', sans-serif; font-weight: 800; font-size: clamp(36px, 6.5vw, 88px); letter-spacing: -0.045em; line-height: 1; }
      .meet .quote span { display: block; opacity: 0; transform: translateY(40px); transition: opacity 1.2s, transform 1.2s; }
      .meet .quote span.visible { opacity: 1; transform: translateY(0); }
      .meet .quote .l1 { color: rgba(255,255,255,0.4); }
      .meet .quote .l2 { color: white; transition-delay: 0.2s; }
      .meet .quote .l3 { background: linear-gradient(110deg, var(--turquesa-light), white, var(--turquesa-paler)); -webkit-background-clip: text; background-clip: text; color: transparent; transition-delay: 0.4s; }

      /* FEATURES · sticky stack */
      .features { padding: 80px 0 160px; }
      .features-wrap { max-width: 1280px; margin: 0 auto; padding: 0 24px; display: grid; grid-template-columns: 1fr; gap: 60px; }
      @media (min-width: 1024px) { .features-wrap { grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; } }

      .feat-side-sticky { position: sticky; top: 80px; }
      .feat-eyebrow { display: inline-block; padding: 4px 10px; background: rgba(94,234,212,0.1); border: 1px solid rgba(94,234,212,0.25); border-radius: 999px; font-size: 11px; font-weight: 800; letter-spacing: 0.15em; text-transform: uppercase; color: var(--turquesa-light); }
      .feat-h2 { font-family: 'Sora', sans-serif; font-weight: 800; font-size: clamp(36px, 5vw, 60px); letter-spacing: -0.04em; line-height: 1.05; margin-top: 14px; }
      .feat-p { margin-top: 18px; font-size: 17px; color: rgba(255,255,255,0.65); line-height: 1.55; max-width: 480px; }

      .feat-list { display: flex; flex-direction: column; gap: 18px; }
      .feat-card { padding: 32px; border: 1px solid rgba(255,255,255,0.08); border-radius: 22px; background: rgba(255,255,255,0.025); position: relative; overflow: hidden; transition: all 0.4s cubic-bezier(0.22,1,0.36,1); opacity: 0; transform: translateY(40px); }
      .feat-card.visible { opacity: 1; transform: translateY(0); }
      .feat-card:hover { border-color: rgba(94,234,212,0.3); transform: translateY(-3px); background: rgba(20,184,166,0.04); }
      .feat-card .icon { width: 48px; height: 48px; border-radius: 14px; background: linear-gradient(135deg, var(--turquesa) 0%, var(--purple) 100%); display: flex; align-items: center; justify-content: center; font-size: 22px; }
      .feat-card .t { font-family: 'Sora', sans-serif; font-weight: 700; font-size: 22px; letter-spacing: -0.02em; margin-top: 18px; }
      .feat-card .d { margin-top: 8px; font-size: 14px; color: rgba(255,255,255,0.6); line-height: 1.5; }

      /* STATS · big numbers */
      .stats { padding: 120px 0; background: linear-gradient(180deg, transparent 0%, rgba(20,184,166,0.04) 50%, transparent 100%); }
      .stats-wrap { max-width: 1280px; margin: 0 auto; padding: 0 24px; }
      .stats-h { text-align: center; margin-bottom: 80px; }
      .stats-h .e { display: inline-block; padding: 4px 10px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.12); border-radius: 999px; font-size: 11px; font-weight: 800; letter-spacing: 0.15em; text-transform: uppercase; color: rgba(255,255,255,0.7); }
      .stats-h h2 { font-family: 'Sora', sans-serif; font-weight: 800; font-size: clamp(34px, 5vw, 56px); letter-spacing: -0.04em; line-height: 1.05; margin-top: 14px; max-width: 720px; margin-left: auto; margin-right: auto; }
      .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 32px; }
      .stat-big { text-align: center; }
      .stat-big .v { font-family: 'Sora', sans-serif; font-weight: 800; font-size: clamp(48px, 7vw, 88px); letter-spacing: -0.045em; line-height: 1; background: linear-gradient(120deg, var(--turquesa-light), var(--turquesa-paler)); -webkit-background-clip: text; background-clip: text; color: transparent; font-variant-numeric: tabular-nums; }
      .stat-big .l { margin-top: 10px; font-size: 13px; color: rgba(255,255,255,0.55); text-transform: uppercase; letter-spacing: 0.12em; font-weight: 700; }

      /* FINAL CTA · mega type */
      .final { padding: 160px 0 120px; text-align: center; position: relative; overflow: hidden; }
      .final::before { content: ''; position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 80vw; height: 60vh; background: radial-gradient(ellipse 80% 80% at center, rgba(20,184,166,0.18) 0%, transparent 70%); pointer-events: none; }
      .final-wrap { position: relative; z-index: 2; max-width: 1280px; margin: 0 auto; padding: 0 24px; }
      .final h2 { font-family: 'Sora', sans-serif; font-weight: 900; letter-spacing: -0.06em; line-height: 0.85; font-size: clamp(60px, 14vw, 200px); }
      .final h2 .l1 { color: white; }
      .final h2 .l2 { background: linear-gradient(115deg, var(--turquesa-light), var(--turquesa-paler)); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .final p { margin-top: 28px; font-size: clamp(16px, 2.2vw, 22px); color: rgba(255,255,255,0.7); max-width: 560px; margin-left: auto; margin-right: auto; }
      .final-cta { margin-top: 44px; display: inline-flex; align-items: center; gap: 12px; padding: 22px 40px; background: white; color: var(--ink); border-radius: 999px; font-weight: 800; font-size: 18px; text-decoration: none; box-shadow: 0 24px 80px rgba(94,234,212,0.3); transition: all 0.3s cubic-bezier(0.22,1,0.36,1); }
      .final-cta:hover { transform: translateY(-4px); box-shadow: 0 32px 100px rgba(94,234,212,0.45); }
      .final-cta::after { content: '→'; transition: transform 0.3s; }
      .final-cta:hover::after { transform: translateX(6px); }
      .final-micro { margin-top: 16px; font-size: 13px; color: rgba(255,255,255,0.5); }

      /* footer minimal */
      .ft { padding: 40px 24px; text-align: center; font-size: 12px; color: rgba(255,255,255,0.35); border-top: 1px solid rgba(255,255,255,0.05); }
      .ft a { color: rgba(255,255,255,0.55); text-decoration: none; margin: 0 10px; }
      .ft a:hover { color: white; }

      @media (prefers-reduced-motion: reduce) {
        * { animation: none !important; transition: none !important; }
        .word { opacity: 1 !important; transform: none !important; filter: none !important; }
        .feat-card, .h-sub, .h-cta { opacity: 1 !important; transform: none !important; }
      }
      @media (max-width: 1023px) { .hero { min-height: auto; } .hero-sticky { position: relative; height: auto; padding: 120px 0 80px; } .phone-stage { height: 540px; margin-top: 40px; } }
    </style>
  </head>
  <body>
    <a class="nav" href="/lab/">
      <img src="https://sims.zymplo.com/brand/isotipo.svg" alt="Zymplo" />
      ← Lab
    </a>
    <a class="lab-badge" href="/lab/">A · Cinematic</a>

    <section class="hero">
      <div class="hero-sticky">
        <div class="mesh-bg"><div class="blob"></div></div>
        <div class="dot-grid"></div>

        <div class="hero-grid">
          <div>
            <span class="h-eyebrow"><span class="pulse"></span> EN VIVO · 13 PAÍSES</span>
            <h1 class="cinematic" id="cine-h1" aria-label="Cobra. Sin perseguir. La IA hace todo.">
              <span class="word">Cobrá.</span>
              <span class="word">Sin</span>
              <span class="word">perseguir.</span>
              <br/>
              <span class="word accent">La</span>
              <span class="word accent">IA</span>
              <span class="word accent">hace</span>
              <span class="word accent">todo.</span>
            </h1>
            <p class="h-sub" id="cine-sub">Tu secretaria IA dentro de WhatsApp. Cobra · factura · agenda · organiza. Sin app · sin signup · sin fricción.</p>
            <div class="h-cta" id="cine-cta">
              <a class="btn btn-primary" href="https://wa.me/595981970735?text=Quiero%20probar%20Zymplo">Empezar gratis</a>
              <a class="btn btn-ghost" href="#features">Ver cómo funciona</a>
            </div>
            <div class="micro" id="cine-micro">
              <span>Sin app</span>
              <span>Sin registro</span>
              <span>Gratis para siempre</span>
            </div>
          </div>

          <div class="phone-stage">
            <div class="phone" id="cine-phone">
              <div class="phone-notch"></div>
              <div class="phone-screen">
                <div class="wa-header">
                  <div class="wa-avatar"><img src="https://sims.zymplo.com/brand/isotipo.svg" alt="" /></div>
                  <div class="wa-info">
                    <div class="n">Zymplo</div>
                    <div class="s">en línea</div>
                  </div>
                </div>
                <div class="wa-body">
                  <div class="bubble bot b1">Hola Diego ✨ Vi que Pablo te debe ₲ 850.000 desde el martes. ¿Le mando el recordatorio?<small>14:32</small></div>
                  <div class="bubble usr b2">Dale, pero suave<small>14:32 ✓✓</small></div>
                  <div class="bubble bot b3">Mensaje enviado · le di la opción de pagar por Tigo Money. Te aviso ni bien responde 💪<small>14:33</small></div>
                  <div class="bubble usr b4">Sos lo mejor<small>14:33 ✓✓</small></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="meet">
      <div class="quote" id="cine-quote">
        <span class="l1">Tu día tiene 24 horas.</span>
        <span class="l2">El de Zé tiene infinitas.</span>
        <span class="l3">Trabaja por vos · 24/7.</span>
      </div>
    </section>

    <section class="features" id="features">
      <div class="features-wrap">
        <div class="feat-side-sticky">
          <span class="feat-eyebrow">⚡ qué hace zé</span>
          <h2 class="feat-h2">Todo lo que odiás hacer.<br/>Sin que lo pidas.</h2>
          <p class="feat-p">Zé entiende tu negocio. Cobra a quien te debe. Manda el comprobante. Te recuerda lo importante. Vive en tu WhatsApp. No tenés que hacer nada distinto.</p>
        </div>

        <div class="feat-list">
          <div class="feat-card feat-anim"><div class="icon">💸</div><div class="t">Cobra sin perseguir</div><div class="d">Detecta facturas vencidas. Manda recordatorios calientes que cobran. Te avisa cuando entró la plata.</div></div>
          <div class="feat-card feat-anim"><div class="icon">🧾</div><div class="t">Facturá hablando</div><div class="d">"Hacé factura a Pablo por 850.000". Listo. NFS-e · CFDI · DIAN · AFIP · todo según tu país.</div></div>
          <div class="feat-card feat-anim"><div class="icon">📅</div><div class="t">Agenda en tu cabeza</div><div class="d">"Recordame mañana 9 ir al taller". Zé te avisa. No olvidás nada. Nunca más.</div></div>
          <div class="feat-card feat-anim"><div class="icon">📊</div><div class="t">Resumen al toque</div><div class="d">"¿Cómo voy este mes?". Te muestra entró · falta · gastaste. En segundos. Sin abrir nada.</div></div>
        </div>
      </div>
    </section>

    <section class="stats">
      <div class="stats-wrap">
        <div class="stats-h">
          <span class="e">⚡ MOMENTUM</span>
          <h2>Gente real cobrando hoy.</h2>
        </div>
        <div class="stats-grid">
          <div class="stat-big"><div class="v" data-target="47280000" data-prefix="$ " data-suffix="M" data-divisor="1000000" data-decimals="2">$ 0M</div><div class="l">cobrados este mes</div></div>
          <div class="stat-big"><div class="v" data-target="12847" data-decimals="0">0</div><div class="l">personas activas</div></div>
          <div class="stat-big"><div class="v" data-target="13" data-decimals="0">0</div><div class="l">países LATAM + US</div></div>
          <div class="stat-big"><div class="v" data-target="847" data-decimals="0">0</div><div class="l">se sumaron hoy</div></div>
        </div>
      </div>
    </section>

    <section class="final">
      <div class="final-wrap">
        <h2>
          <span class="l1">Empezá hoy.</span>
          <span class="l2">Sin fricción.</span>
        </h2>
