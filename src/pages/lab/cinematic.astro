    <footer class="ft">
      © 2026 Zymplo · <a href="/lab/">Lab</a> · <a href="/">Landing actual</a> · <a href="/lab/alive/">Variant B</a> · <a href="/lab/conversational/">Variant C</a>
    </footer>

    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Hero word reveal on load
      window.addEventListener('load', () => {
        const words = document.querySelectorAll('#cine-h1 .word');
        words.forEach((w, i) => setTimeout(() => w.classList.add('visible'), 80 + i * 90));
        setTimeout(() => {
          document.getElementById('cine-sub').classList.add('visible');
          document.getElementById('cine-cta').classList.add('visible');
        }, 200);
      });

      // iPhone scroll-driven 3D
      const phone = document.getElementById('cine-phone');
      const heroSec = document.querySelector('.hero');
      function onPhoneScroll() {
        if (!phone || !heroSec || reduceMotion) return;
        const r = heroSec.getBoundingClientRect();
        const total = r.height - window.innerHeight;
        const p = Math.max(0, Math.min(1, -r.top / total));
        const rotY = -12 + p * 22;
        const rotX = 4 - p * 6;
        const ty = -50 + p * -20;
        const scale = 1 - p * 0.12;
        phone.style.transform = `translate(-50%, ${ty}%) rotateY(${rotY}deg) rotateX(${rotX}deg) scale(${scale})`;
      }
      window.addEventListener('scroll', onPhoneScroll, { passive: true });
      onPhoneScroll();

      // mesh parallax
      const mesh = document.querySelector('.mesh-bg');
      function onMesh() {
        if (!mesh || reduceMotion) return;
        const y = window.scrollY * 0.15;
        mesh.style.transform = `translateY(${y}px)`;
      }
      window.addEventListener('scroll', onMesh, { passive: true });

      // Quote reveal · stats counter · features stagger
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            const el = e.target;
            if (el.classList.contains('feat-anim')) {
              const cards = document.querySelectorAll('.feat-anim');
              cards.forEach((c, i) => setTimeout(() => c.classList.add('visible'), i * 110));
              io.unobserve(el);
            } else if (el.id === 'cine-quote') {
              el.querySelectorAll('span').forEach((s) => s.classList.add('visible'));
              io.unobserve(el);
            } else if (el.classList.contains('stat-big')) {
              const v = el.querySelector('.v');
              const target = parseFloat(v.dataset.target || '0');
              const prefix = v.dataset.prefix || '';
              const suffix = v.dataset.suffix || '';
              const divisor = parseFloat(v.dataset.divisor || '1');
              const decimals = parseInt(v.dataset.decimals || '0');
              const dur = 1800; const t0 = performance.now();
              function step(t) {
                const p = Math.min(1, (t - t0) / dur);
                const eased = 1 - Math.pow(1 - p, 3);
                const cur = (target / divisor) * eased;
                v.textContent = prefix + cur.toFixed(decimals) + suffix;
                if (p < 1) requestAnimationFrame(step);
              }
              requestAnimationFrame(step);
              io.unobserve(el);
            }
          }
        });
      }, { threshold: 0.2 });

      document.querySelectorAll('.feat-anim, #cine-quote, .stat-big').forEach((el) => io.observe(el));
    </script>
  </body>
