---
const title = 'Zymplo · 8-Bit Pixel Lab · V11';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0F380F" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="https://sims.zymplo.com/brand/isotipo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" />
    <style is:inline>
      :root { --gb-darkest: #0F380F; --gb-dark: #306230; --gb-light: #8BAC0F; --gb-lightest: #9BBC0F; --gb-screen: #C4CFA1; --paper: #c4cfa1; --ink: #0F380F; }
      * { box-sizing: border-box; margin: 0; padding: 0; image-rendering: pixelated; image-rendering: crisp-edges; }
      body { font-family: 'VT323', monospace; background: #1a1a1a; color: var(--ink); min-height: 100vh; padding: 20px; display: flex; align-items: center; justify-content: center; }

      .gb-shell { background: linear-gradient(180deg, #d4d4d4 0%, #b8b8b8 100%); border-radius: 14px 14px 60px 14px; padding: 32px 28px 80px; max-width: 540px; width: 100%; box-shadow: 0 30px 80px rgba(0,0,0,0.6), inset 0 4px 0 rgba(255,255,255,0.4), inset 0 -4px 0 rgba(0,0,0,0.15); position: relative; }
      .gb-top { display: flex; align-items: center; gap: 6px; margin-bottom: 14px; font-family: 'Press Start 2P', monospace; font-size: 8px; color: #444; text-transform: uppercase; letter-spacing: 0.08em; }
      .gb-top .pwr { width: 10px; height: 10px; background: red; border-radius: 50%; box-shadow: 0 0 6px red; }
      .gb-top .label { letter-spacing: 0.2em; flex: 1; text-align: center; font-size: 7px; }
      .gb-screen-frame { background: #777; padding: 14px 18px; border-radius: 8px; box-shadow: inset 0 4px 12px rgba(0,0,0,0.4); }
      .gb-screen { background: var(--gb-screen); padding: 16px; min-height: 480px; image-rendering: pixelated; position: relative; overflow: hidden; }

      .lcd-overlay { position: absolute; inset: 0; background-image: linear-gradient(rgba(0,0,0,0.04) 50%, transparent 50%); background-size: 100% 4px; pointer-events: none; z-index: 5; }

      .pix-content { position: relative; z-index: 2; font-family: 'Press Start 2P', monospace; }
      .head-bar { display: flex; justify-content: space-between; align-items: center; padding-bottom: 6px; border-bottom: 2px solid var(--ink); font-size: 7px; }
      .head-bar .pulse { display: inline-block; width: 6px; height: 6px; background: var(--ink); margin-right: 4px; vertical-align: middle; animation: blink 1s steps(1) infinite; }
      @keyframes blink { 50% { opacity: 0; } }

      .title-pix { font-family: 'Press Start 2P', monospace; font-size: 18px; line-height: 1.4; text-align: center; margin-top: 24px; color: var(--ink); }
      .sub-pix { font-family: 'VT323', monospace; font-size: 18px; line-height: 1.2; text-align: center; margin-top: 14px; color: var(--gb-darkest); padding: 0 8px; }

      .player-card { margin-top: 20px; padding: 10px 12px; border: 2px solid var(--ink); background: var(--gb-lightest); }
      .player-card .row { display: flex; justify-content: space-between; padding: 4px 0; font-family: 'VT323', monospace; font-size: 18px; }
      .player-card .row .l { font-family: 'Press Start 2P', monospace; font-size: 8px; }

      .menu { margin-top: 16px; }
      .menu-item { padding: 6px 10px; font-family: 'Press Start 2P', monospace; font-size: 9px; color: var(--ink); position: relative; cursor: pointer; transition: transform 0.1s; text-decoration: none; display: block; margin-bottom: 4px; }
      .menu-item.active { background: var(--ink); color: var(--gb-screen); }
      .menu-item.active::before { content: '▶ '; }
      .menu-item:hover { transform: translateX(2px); }
      .menu-item:not(.active)::before { content: '   '; }

      .footer-pix { margin-top: 14px; padding-top: 8px; border-top: 2px solid var(--ink); font-family: 'Press Start 2P', monospace; font-size: 6px; color: var(--gb-darkest); text-align: center; line-height: 1.5; }

      .controls { margin-top: 24px; display: flex; justify-content: space-between; align-items: center; padding: 0 14px; }
      .dpad { width: 60px; height: 60px; position: relative; }
      .dpad::before, .dpad::after { content: ''; position: absolute; background: #333; border-radius: 4px; box-shadow: inset 0 -2px 0 rgba(0,0,0,0.4); }
      .dpad::before { width: 60px; height: 22px; top: 19px; left: 0; }
      .dpad::after { width: 22px; height: 60px; top: 0; left: 19px; }
      .ab { display: flex; gap: 14px; transform: rotate(-30deg); }
      .ab-btn { width: 36px; height: 36px; border-radius: 50%; background: linear-gradient(135deg, #8c3a76, #5d234d); display: flex; align-items: center; justify-content: center; color: white; font-family: 'Press Start 2P', monospace; font-size: 10px; box-shadow: 0 4px 0 rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.4); }

      .start-select { display: flex; gap: 14px; justify-content: center; align-items: center; margin-top: 16px; }
      .ss { padding: 4px 14px; background: #333; border-radius: 12px; transform: skewX(-20deg); box-shadow: 0 3px 0 rgba(0,0,0,0.4); }
      .ss span { display: block; font-family: 'Press Start 2P', monospace; font-size: 7px; color: #888; text-align: center; transform: skewX(20deg); margin-top: 6px; }

      .lab-badge { position: fixed; top: 14px; right: 14px; z-index: 100; padding: 6px 12px; background: var(--gb-darkest); color: var(--gb-screen); font-family: 'Press Start 2P', monospace; font-size: 8px; text-decoration: none; border: 2px solid var(--gb-screen); }
      .nav-back { position: fixed; top: 14px; left: 14px; z-index: 100; padding: 6px 12px 6px 6px; background: var(--gb-screen); color: var(--gb-darkest); border: 2px solid var(--gb-darkest); font-family: 'Press Start 2P', monospace; font-size: 8px; text-decoration: none; display: flex; align-items: center; gap: 6px; }
      .nav-back img { height: 14px; image-rendering: pixelated; }

      .speaker { position: absolute; bottom: 24px; right: 24px; display: flex; flex-direction: column; gap: 4px; transform: rotate(-30deg); }
      .speaker span { display: block; width: 4px; height: 22px; background: rgba(0,0,0,0.3); border-radius: 2px; }

      .pixel-btn-cta { display: block; margin-top: 12px; padding: 12px; background: var(--ink); color: var(--gb-screen); font-family: 'Press Start 2P', monospace; font-size: 10px; text-align: center; text-decoration: none; border: 3px solid var(--ink); transition: transform 0.1s; }
      .pixel-btn-cta:hover { transform: scale(1.04); }
    </style>
  </head>
  <body>
    <a class="nav-back" href="/lab/"><img src="https://sims.zymplo.com/brand/isotipo.svg" alt="Zymplo" />LAB</a>
    <a class="lab-badge" href="/lab/">11·PIXEL</a>

    <div class="gb-shell">
      <div class="gb-top">
        <div class="pwr"></div>
        <div class="label">★ ZYMPLO ★ POCKET ★</div>
        <div style="font-family: 'Press Start 2P', monospace; font-size: 6px; color: #888;">DOT MATRIX WITH STEREO SOUND</div>
      </div>

      <div class="gb-screen-frame">
        <div class="gb-screen">
          <div class="lcd-overlay"></div>

          <div class="pix-content">
            <div class="head-bar">
              <span><span class="pulse"></span>LIVE</span>
              <span>13 PAÍSES</span>
            </div>

            <div class="title-pix">COBRÁ<br/>SIN<br/>PERSEGUIR</div>
            <p class="sub-pix">tu IA en whatsapp.<br/>cobra · factura · agenda.<br/>sin app · sin signup.</p>

            <div class="player-card">
              <div class="row"><span class="l">$ MES</span><span>$47.28M</span></div>
              <div class="row"><span class="l">USERS</span><span>12.847</span></div>
              <div class="row"><span class="l">PAÍSES</span><span>13</span></div>
              <div class="row"><span class="l">HOY</span><span>+847</span></div>
            </div>

            <a class="pixel-btn-cta" href="https://wa.me/595981970735?text=Quiero%20probar%20Zymplo">▶ START · GRATIS</a>

            <div class="menu">
              <a class="menu-item active" href="https://wa.me/595981970735?text=Quiero%20probar%20Zymplo">PROBAR ZÉ</a>
              <a class="menu-item" href="#planes">VER PLANES</a>
              <a class="menu-item" href="#feats">QUÉ HACE</a>
              <a class="menu-item" href="/">LANDING WEB</a>
            </div>

            <div class="footer-pix">© 2026 ZYMPLO INC.<br/>PRESS START TO PLAY</div>
          </div>
        </div>
      </div>

      <div class="controls">
        <div class="dpad"></div>
        <div class="ab">
          <div class="ab-btn">B</div>
          <div class="ab-btn">A</div>
        </div>
      </div>

      <div class="start-select">
        <div class="ss"><span>SELECT</span></div>
        <div class="ss"><span>START</span></div>
      </div>

      <div class="speaker">
        <span></span><span></span><span></span><span></span><span></span><span></span>
      </div>
    </div>
  </body>
</html>
