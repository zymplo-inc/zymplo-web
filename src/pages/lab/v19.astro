    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const $ = (s, c=document) => c.querySelector(s);
      const $$ = (s, c=document) => [...c.querySelectorAll(s)];

      // PROGRESS
      const prog = $('#prog');
      function onScroll() {
        const sy = window.scrollY;
        const sh = document.documentElement.scrollHeight - window.innerHeight;
        prog.style.width = Math.min(100, Math.max(0, sy / sh * 100)) + '%';
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // TYPED
      const examples = ['Cobrar João R$200', 'Quanto ganhei hoje?', 'Agendar cliente amanhã', 'Quem ainda não pagou?', 'Resumo do mês'];
      const typedEl = $('#typedText');
      let exIdx = 0, charIdx = 0, deleting = false;
      function tick() {
        if (reduceMotion) { typedEl.textContent = examples[0]; return; }
        const cur = examples[exIdx];
        if (!deleting) {
          charIdx++; typedEl.textContent = cur.slice(0, charIdx);
          if (charIdx === cur.length) { setTimeout(() => { deleting = true; tick(); }, 1700); return; }
          setTimeout(tick, 70 + Math.random() * 60);
        } else {
          charIdx--; typedEl.textContent = cur.slice(0, charIdx);
          if (charIdx === 0) { deleting = false; exIdx = (exIdx + 1) % examples.length; setTimeout(tick, 240); return; }
          setTimeout(tick, 30);
        }
      }
      tick();

      // SCROLLY
      const s1 = $('.scene.s1'); const s1words = $$('.s1 .word');
      const flowPath = $('#flowPath'); const pathLen = flowPath ? flowPath.getTotalLength() : 0;
      if (flowPath) { flowPath.style.strokeDasharray = pathLen; flowPath.style.strokeDashoffset = pathLen; }
      const s2nodes = $$('.svg-flow .node-circle, .svg-flow .node-pulse');
      const s2labels = $$('.svg-flow .label, .svg-flow .emoji');
      const s3stats = $$('.s3 .stat .v');
      const s3animated = new Set();
      function getProgress(scene) { const r = scene.getBoundingClientRect(); const sH = scene.offsetHeight - window.innerHeight; return Math.max(0, Math.min(1, -r.top / sH)); }
      function onScrolly() {
        if (reduceMotion) return;
        if (s1) {
          const p = getProgress(s1);
          const showCount = Math.floor(p * (s1words.length + 4));
          s1words.forEach((w, i) => { if (i < showCount) w.classList.add('show'); else w.classList.remove('show'); });
        }
        const s2 = $('.scene.s2');
        if (s2 && pathLen) {
          const p = getProgress(s2);
          flowPath.style.strokeDashoffset = pathLen * Math.max(0, 1 - p * 1.4);
          for (let i = 0; i < 4; i++) {
            const threshold = 0.18 + i * 0.18;
            const show = p > threshold;
            const cIdx = i * 2;
            if (s2nodes[cIdx]) s2nodes[cIdx].classList.toggle('show', show);
            if (s2nodes[cIdx + 1]) s2nodes[cIdx + 1].classList.toggle('show', show);
            if (s2labels[i * 2]) s2labels[i * 2].classList.toggle('show', show);
            if (s2labels[i * 2 + 1]) s2labels[i * 2 + 1].classList.toggle('show', show);
          }
        }
        const s3 = $('.scene.s3');
        if (s3) {
          const r = s3.getBoundingClientRect();
          if (r.top < window.innerHeight * 0.6 && r.bottom > 0 && !s3animated.has('done')) {
            s3animated.add('done');
            s3stats.forEach((v) => {
              const target = parseFloat(v.dataset.target || '0');
              const prefix = v.dataset.prefix || ''; const suffix = v.dataset.suffix || '';
              const decimals = parseInt(v.dataset.decimals ?? '0');
              const dur = 1700; const t0 = performance.now();
              function step(t) {
                const p = Math.min(1, (t - t0) / dur);
                const eased = 1 - Math.pow(1 - p, 3);
                const cur = target * eased;
                v.textContent = prefix + cur.toLocaleString('pt-BR', { minimumFractionDigits: decimals, maximumFractionDigits: decimals }) + suffix;
                if (p < 1) requestAnimationFrame(step);
              }
              requestAnimationFrame(step);
            });
          }
        }
      }
      window.addEventListener('scroll', onScrolly, { passive: true });
      onScrolly();

      // INTERACTIVE DEMO
      const live = $('#livechat'); const lin = $('#liveInput'); const lsend = $('#liveSend');
      function addBub(side, html) {
        const b = document.createElement('div'); b.className = 'b ' + side;
        b.style.cssText = 'opacity: 0; transform: translateY(8px); animation: bub-in 0.4s cubic-bezier(0.22,1,0.36,1) forwards; max-width: 80%; padding: 7px 11px 5px; border-radius: 13px; font-size: 13px; line-height: 1.4;';
        b.style.background = side === 'usr' ? '#6A00F4' : '#1F2C33';
        b.style.color = 'white';
        b.style.alignSelf = side === 'usr' ? 'flex-end' : 'flex-start';
        b.style[side === 'usr' ? 'borderBottomRightRadius' : 'borderBottomLeftRadius'] = '4px';
        b.innerHTML = html + '<span style="display:block;margin-top:3px;font-size:9px;opacity:0.55;text-align:right;">agora' + (side === 'usr' ? ' ✓✓' : '') + '</span>';
        live.appendChild(b); live.scrollTop = live.scrollHeight;
      }
      function showTyping() {
        const tp = document.createElement('div'); tp.className = 'typing-dots'; tp.innerHTML = '<span></span><span></span><span></span>';
        live.appendChild(tp); live.scrollTop = live.scrollHeight; return tp;
      }
      function reply(msg) {
        const m = msg.toLowerCase();
        if (/(quanto.*ganhe|faturamento|resumo do dia|hoje)/.test(m)) {
          return ['📊 Hoje você está com <strong>R$ 1.240 ✨</strong>', 'Pendentes: <em>R$ 680</em> (3 clientes)', 'Quer enviar lembretes agora?'];
        }
        if (/(cobrar?)/.test(m)) {
          const monto = m.match(/(\d{2,})/);
          const a = m.match(/cobrar?\s+([a-zà-ÿ]+)/i);
          return [
            '💸 Cobrança preparada para <strong>' + (a ? a[1] : 'seu cliente') + '</strong>' + (monto ? ' · <em>R$ ' + Number(monto[1]).toLocaleString('pt-BR') + '</em>' : ''),
            'Mando uma mensagem cordial · com link Pix anexado. <strong>Posso enviar?</strong>',
          ];
        }
        if (/(lembrete|lembrar|amanha|amanhã)/.test(m)) {
          return ['📅 Lembrete agendado · te aviso amanhã 9h.', 'Quer adicionar mais detalhes?'];
        }
        if (/(quem.*n[aã]o.*pago|inadimplent|n[aã]o pago)/.test(m)) {
          return ['⚠️ <strong>3 clientes</strong> ainda não pagaram:', '· João · R$ 200<br/>· Ana · R$ 150<br/>· Marcos · R$ 420', 'Quer que eu envie lembretes agora?'];
        }
        return ['Boa! Posso te ajudar.<br/>· <em>cobrar João 200</em><br/>· <em>quanto ganhei hoje</em><br/>· <em>quem não pagou</em><br/>· <em>resumo do dia</em>'];
      }
      function userSend(msg) {
        if (!msg.trim()) return;
        addBub('usr', msg); lin.value = '';
        const tp = showTyping();
        const responses = reply(msg);
        responses.forEach((r, i) => { setTimeout(() => { if (i === 0) tp.remove(); addBub('bot', r); }, reduceMotion ? 0 : 700 + i * 950); });
      }
      lsend && lsend.addEventListener('click', () => userSend(lin.value));
      lin && lin.addEventListener('keydown', (e) => { if (e.key === 'Enter') userSend(lin.value); });
      $$('.qp').forEach((b) => b.addEventListener('click', () => userSend(b.dataset.prompt)));
    </script>
