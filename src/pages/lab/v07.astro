---
const title = 'Zymplo · Y2K Lab · V07';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#9CD9F0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="https://sims.zymplo.com/brand/isotipo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bungee&family=Press+Start+2P&family=VT323&family=Inter:wght@500;700&display=swap" />
    <style is:inline>
      :root { --sky: #9CD9F0; --bubble: #FFB7E5; --grass: #BFFB8B; --chrome: linear-gradient(180deg, #FFFFFF 0%, #C0C0C0 50%, #888 100%); --hot: #FF1493; --neon: #00FFCC; }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: 'VT323', monospace; background: linear-gradient(180deg, var(--sky) 0%, var(--bubble) 100%); min-height: 100vh; color: #1a0033; overflow-x: hidden; cursor: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 32"><polygon points="2,2 2,28 10,22 14,30 18,28 14,20 22,20" fill="white" stroke="black" stroke-width="2"/></svg>'), auto; }

      /* sparkle bg */
      body::before { content: ''; position: fixed; inset: 0; background-image: radial-gradient(2px 2px at 20% 30%, white, transparent), radial-gradient(2px 2px at 70% 60%, white, transparent), radial-gradient(1px 1px at 50% 80%, white, transparent), radial-gradient(2px 2px at 80% 20%, white, transparent); background-size: 200px 200px; animation: twinkle 3s ease-in-out infinite; pointer-events: none; opacity: 0.7; }
      @keyframes twinkle { 50% { opacity: 0.3; } }

      .nav-back { position: fixed; top: 14px; left: 14px; z-index: 100; padding: 4px 12px; background: white; color: #1a0033; border: 2px outset #ddd; font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 700; text-decoration: none; display: flex; align-items: center; gap: 6px; }
      .nav-back img { height: 14px; }
      .lab-badge { position: fixed; top: 14px; right: 14px; z-index: 100; padding: 4px 12px; background: var(--hot); color: white; border: 2px outset white; font-family: 'Press Start 2P', monospace; font-size: 8px; text-decoration: none; }

      .marquee-top { background: black; color: var(--neon); padding: 8px 0; overflow: hidden; white-space: nowrap; font-family: 'VT323', monospace; font-size: 18px; border-bottom: 4px solid white; box-shadow: 0 4px 0 black; }
      .marquee-top span { display: inline-block; padding-left: 100%; animation: scroll-y2k 20s linear infinite; }
      @keyframes scroll-y2k { to { transform: translateX(-100%); } }

      .container { max-width: 980px; margin: 24px auto; padding: 0 18px; position: relative; }

      .window { background: linear-gradient(180deg, #DFEBFD 0%, #BBD5FA 100%); border: 2px solid #003C8B; border-radius: 8px 8px 0 0; box-shadow: 4px 4px 0 rgba(0,0,0,0.25); margin-bottom: 24px; }
      .window-bar { background: linear-gradient(90deg, #1163C8 0%, #5BA0F4 50%, #1163C8 100%); color: white; font-family: 'Inter', sans-serif; font-weight: 700; font-size: 13px; padding: 6px 10px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #002E6D; }
      .window-bar .title { display: flex; align-items: center; gap: 8px; }
      .window-bar .icon { width: 16px; height: 16px; background: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
      .window-bar .icon img { width: 12px; height: 12px; }
      .window-bar .ctrls { display: flex; gap: 4px; }
      .window-bar .ctrls span { width: 18px; height: 16px; background: #DFE7FA; border: 1px outset #DFE7FA; display: flex; align-items: center; justify-content: center; font-size: 10px; color: black; font-weight: 700; cursor: pointer; }

      .window-body { padding: 24px 22px; background: #DFEBFD; }

      .hero-card { padding: 28px; background: var(--chrome); border-radius: 14px; box-shadow: 6px 6px 0 var(--hot), inset 0 4px 0 rgba(255,255,255,0.6); text-align: center; position: relative; }
      .hero-card::before { content: '★'; position: absolute; top: -16px; left: -16px; font-size: 36px; color: var(--hot); animation: spin 4s linear infinite; }
      .hero-card::after { content: '✿'; position: absolute; bottom: -16px; right: -16px; font-size: 36px; color: #b300ff; animation: spin 5s linear infinite reverse; }
      @keyframes spin { to { transform: rotate(360deg); } }
      h1 { font-family: 'Bungee', sans-serif; font-size: clamp(40px, 9vw, 96px); line-height: 0.95; letter-spacing: -0.02em; background: linear-gradient(180deg, #FF1493 0%, #b300ff 50%, #1163C8 100%); -webkit-background-clip: text; background-clip: text; color: transparent; -webkit-text-stroke: 2px white; text-shadow: 6px 6px 0 black; }
      .hero-card .sub { font-family: 'Inter', sans-serif; font-size: 16px; font-weight: 500; margin-top: 14px; color: #1a0033; max-width: 540px; margin-left: auto; margin-right: auto; line-height: 1.4; }
      .hero-card .stat-line { margin-top: 14px; display: inline-block; padding: 6px 14px; background: black; color: var(--neon); font-family: 'VT323', monospace; font-size: 18px; }
      .hero-card .stat-line .blink { animation: blink-y2k 1s steps(1) infinite; color: white; }
      @keyframes blink-y2k { 50% { opacity: 0; } }

      .cta-row { margin-top: 24px; display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
      .btn-y2k { display: inline-block; padding: 12px 22px; background: linear-gradient(180deg, #FFB7E5 0%, #FF1493 100%); color: white; font-family: 'Bungee', sans-serif; font-size: 14px; text-decoration: none; border: 2px solid white; border-radius: 999px; box-shadow: 4px 4px 0 black; transition: transform 0.15s, box-shadow 0.15s; }
      .btn-y2k:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 black; }
      .btn-y2k.alt { background: linear-gradient(180deg, var(--neon) 0%, #00b894 100%); color: black; }

      .gif-row { margin-top: 24px; display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 700; }
      .gif-row span { padding: 4px 10px; background: linear-gradient(90deg, #FFEE00, var(--hot)); border: 2px solid white; border-radius: 4px; box-shadow: 2px 2px 0 black; text-transform: uppercase; }

      .grid-cards { display: grid; grid-template-columns: 1fr; gap: 18px; margin-bottom: 24px; }
      @media (min-width: 700px) { .grid-cards { grid-template-columns: repeat(2, 1fr); } }
      .info-card { background: white; border: 2px solid black; padding: 20px; box-shadow: 4px 4px 0 var(--hot); border-radius: 4px; }
      .info-card .star { font-family: 'Bungee', sans-serif; color: var(--hot); font-size: 14px; }
      .info-card h3 { font-family: 'Bungee', sans-serif; font-size: 22px; margin-top: 6px; color: #1a0033; }
      .info-card p { font-family: 'Inter', sans-serif; font-size: 14px; color: #444; margin-top: 8px; line-height: 1.5; }

      .stats-strip { background: var(--neon); border: 2px solid black; box-shadow: 4px 4px 0 black; padding: 14px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-bottom: 24px; font-family: 'Bungee', sans-serif; }
      @media (min-width: 700px) { .stats-strip { grid-template-columns: repeat(4, 1fr); } }
      .stats-strip .v { font-size: 28px; line-height: 1; }
      .stats-strip .l { font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 700; text-transform: uppercase; margin-top: 4px; color: #1a0033; }

      .visitor { text-align: center; padding: 14px; font-family: 'VT323', monospace; font-size: 18px; color: white; background: black; border: 2px solid white; box-shadow: 4px 4px 0 var(--hot); }
      .visitor .num { color: var(--neon); padding: 2px 8px; background: #1a0033; margin: 0 4px; }

      .footer { padding: 18px 0 40px; text-align: center; font-family: 'Inter', sans-serif; font-size: 11px; color: #1a0033; }
      .footer a { color: #b300ff; text-decoration: underline; margin: 0 8px; }

      @media (prefers-reduced-motion: reduce) { * { animation: none !important; } }
    </style>
  </head>
  <body>
    <a class="nav-back" href="/lab/"><img src="https://sims.zymplo.com/brand/isotipo.svg" alt="Zymplo" />← LAB</a>
    <a class="lab-badge" href="/lab/">07·Y2K</a>

    <div class="marquee-top"><span>★ WELCOME TO ZYMPLO.COM ★ TU SECRETARIA AI EN WHATSAPP ★ 13 PAÍSES ★ GRATIS PARA SIEMPRE ★ MEJOR VISTO EN INTERNET EXPLORER 6.0 ★ CONFIRMADO POR ★ ESTAMOS COBRANDO YA ★</span></div>

    <div class="container">
      <div class="window">
        <div class="window-bar">
          <span class="title"><span class="icon"><img src="https://sims.zymplo.com/brand/isotipo.svg" alt=""/></span>Zymplo.exe — Tu secretaria IA</span>
          <span class="ctrls"><span>_</span><span>□</span><span>×</span></span>
        </div>
        <div class="window-body">
          <div class="hero-card">
            <h1>COBRÁ<br/>SIN PERSEGUIR</h1>
            <p class="sub">Tu secretaria IA dentro de WhatsApp. Cobra · factura · agenda · organiza. Sin app · sin signup · 100% gratis para siempre.</p>
