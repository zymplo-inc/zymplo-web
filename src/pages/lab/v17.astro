---
const title = 'Zymplo · Seu negócio funcionando sozinho, no WhatsApp.';
const description = 'Cobre clientes, organize sua agenda e acompanhe seu dinheiro sem instalar nada.';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0A0B14" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#FAFBFF" media="(prefers-color-scheme: light)" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="https://sims.zymplo.com/brand/isotipo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700;800&display=swap" />

    <style is:inline>
      :root {
        --bg: #0A0B14; --bg-2: #11141F; --paper: #FAFBFF; --ink: #0A0B14; --mute: #6B7280;
        --turq: #14B8A6; --turq-light: #5EEAD4; --turq-paler: #CCFBF1; --turq-deep: #0B6B62;
        --good: #22C55E; --bot: #1F2C33; --usr: #005C4B; --wa-bg: #0B141A;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body { font-family: 'Inter', system-ui, sans-serif; background: var(--bg); color: var(--paper); min-height: 100vh; overflow-x: hidden; -webkit-font-smoothing: antialiased; line-height: 1.5; }
      img { max-width: 100%; display: block; }

      /* PROGRESS BAR */
      .progress { position: fixed; top: 0; left: 0; height: 3px; background: linear-gradient(90deg, var(--turq), var(--turq-light)); z-index: 999; width: 0%; transition: width 0.05s linear; box-shadow: 0 0 8px var(--turq-light); }

      /* NAV */
      .nav-back { position: fixed; top: 14px; left: 14px; z-index: 100; padding: 6px 12px 6px 6px; background: rgba(255,255,255,0.04); backdrop-filter: blur(20px) saturate(160%); -webkit-backdrop-filter: blur(20px) saturate(160%); border: 1px solid rgba(255,255,255,0.12); border-radius: 999px; font-size: 12px; font-weight: 700; color: var(--paper); text-decoration: none; display: flex; align-items: center; gap: 6px; transition: all 0.2s; }
      .nav-back:hover { background: rgba(255,255,255,0.08); }
      .nav-back img { height: 18px; }
      .lab-badge { position: fixed; top: 14px; right: 14px; z-index: 100; padding: 6px 12px; background: rgba(20,184,166,0.16); backdrop-filter: blur(20px); border: 1px solid rgba(94,234,212,0.4); border-radius: 999px; font-size: 11px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--turq-light); text-decoration: none; }

      /* SCROLL HINT */
      .scroll-hint { position: fixed; bottom: 22px; left: 50%; transform: translateX(-50%); padding: 7px 16px 7px 14px; background: rgba(0,0,0,0.55); backdrop-filter: blur(14px); border: 1px solid rgba(255,255,255,0.12); border-radius: 999px; color: rgba(255,255,255,0.85); font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; z-index: 50; opacity: 0.9; pointer-events: none; transition: opacity 0.4s; display: inline-flex; align-items: center; gap: 8px; }
      .scroll-hint .arr { display: inline-block; animation: bounce-y 1.6s ease-in-out infinite; }
      @keyframes bounce-y { 50% { transform: translateY(4px); } }
      .scroll-hint.hidden { opacity: 0; }

      /* ============ HERO ============ */
      .hero { position: relative; min-height: 100vh; padding: 96px 22px 60px; max-width: 1280px; margin: 0 auto; display: flex; flex-direction: column; justify-content: center; }
      .hero-bg { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
      .hero-bg::before { content: ''; position: absolute; top: -10%; right: -10%; width: 70vw; height: 70vw; background: radial-gradient(circle, rgba(20,184,166,0.32) 0%, transparent 60%); filter: blur(80px); animation: float-x 16s ease-in-out infinite; }
      .hero-bg::after { content: ''; position: absolute; bottom: -20%; left: -10%; width: 60vw; height: 60vw; background: radial-gradient(circle, rgba(94,234,212,0.18) 0%, transparent 60%); filter: blur(80px); animation: float-y 20s ease-in-out infinite; }
      @keyframes float-x { 50% { transform: translate(40px, -30px); } }
      @keyframes float-y { 50% { transform: translate(-40px, 30px); } }

      .hero-grid { position: relative; z-index: 2; display: grid; grid-template-columns: 1fr; gap: 40px; align-items: center; }
      @media (min-width: 1024px) { .hero-grid { grid-template-columns: 1.15fr 1fr; gap: 64px; } }

      .pill { display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; background: rgba(20,184,166,0.1); border: 1px solid rgba(94,234,212,0.3); border-radius: 999px; font-size: 11px; font-weight: 800; letter-spacing: 0.18em; text-transform: uppercase; color: var(--turq-light); }
      .pill .pulse { width: 7px; height: 7px; border-radius: 50%; background: var(--turq-light); box-shadow: 0 0 0 0 var(--turq-light); animation: pulse-soft 2.4s ease-out infinite; }
      @keyframes pulse-soft { 0% { box-shadow: 0 0 0 0 rgba(94,234,212,0.7); } 70% { box-shadow: 0 0 0 12px rgba(94,234,212,0); } 100% { box-shadow: 0 0 0 0 rgba(94,234,212,0); } }

      h1.hero-h { font-family: 'Sora', sans-serif; font-weight: 900; font-size: clamp(40px, 7.5vw, 88px); letter-spacing: -0.045em; line-height: 0.96; margin-top: 22px; }
      h1.hero-h em { font-style: normal; background: linear-gradient(115deg, var(--turq-light) 0%, var(--turq-paler) 50%, white 100%); background-size: 200% 200%; -webkit-background-clip: text; background-clip: text; color: transparent; animation: shimmer 6s ease-in-out infinite; }
      @keyframes shimmer { 0%,100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }
      .hero-sub { margin-top: 22px; font-size: clamp(15px, 1.9vw, 19px); color: rgba(255,255,255,0.75); max-width: 560px; line-height: 1.5; font-weight: 500; }

      /* FAKE INPUT */
      .fake-input-wrap { margin-top: 32px; max-width: 540px; }
      .fake-input { display: flex; align-items: center; gap: 10px; padding: 8px 8px 8px 18px; background: rgba(255,255,255,0.05); border: 1.5px solid rgba(255,255,255,0.12); border-radius: 999px; transition: all 0.3s; backdrop-filter: blur(8px); }
      .fake-input:focus-within, .fake-input:hover { border-color: rgba(94,234,212,0.5); background: rgba(255,255,255,0.08); }
      .fake-input .icon { width: 28px; height: 28px; border-radius: 50%; background: var(--turq); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
      .fake-input .icon img { width: 16px; height: 16px; filter: brightness(0) invert(1); }
      .fake-input .text { flex: 1; min-width: 0; font-size: 15px; color: rgba(255,255,255,0.85); padding: 11px 0; font-family: inherit; }
      .fake-input .text .typed { color: var(--paper); font-weight: 500; }
      .fake-input .text .cursor-blink { display: inline-block; width: 2px; height: 16px; background: var(--turq-light); margin-left: 1px; vertical-align: -3px; animation: blink-c 1s steps(1) infinite; }
      @keyframes blink-c { 50% { opacity: 0; } }
      .fake-input .send-btn { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; background: var(--turq); color: white; border: 0; cursor: pointer; font-size: 19px; flex-shrink: 0; box-shadow: 0 8px 24px rgba(20,184,166,0.45); transition: all 0.2s; text-decoration: none; }
      .fake-input .send-btn:hover { transform: scale(1.08); box-shadow: 0 12px 32px rgba(20,184,166,0.6); }

      .hint-pills { margin-top: 14px; display: flex; gap: 8px; flex-wrap: wrap; }
      .hint-pills .h { padding: 5px 11px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.12); border-radius: 999px; font-size: 12px; color: rgba(255,255,255,0.7); }

      .cta-row { margin-top: 28px; display: flex; gap: 14px; flex-wrap: wrap; align-items: center; }
      .btn-primary { display: inline-flex; align-items: center; gap: 10px; padding: 17px 30px; background: var(--paper); color: var(--ink); border-radius: 999px; font-weight: 800; font-size: 15px; text-decoration: none; box-shadow: 0 16px 50px rgba(94,234,212,0.28); transition: all 0.25s cubic-bezier(0.22,1,0.36,1); }
      .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 24px 70px rgba(94,234,212,0.45); }
      .btn-primary::after { content: '→'; transition: transform 0.3s; }
      .btn-primary:hover::after { transform: translateX(4px); }
      .btn-ghost { display: inline-flex; align-items: center; gap: 10px; padding: 17px 26px; color: rgba(255,255,255,0.85); background: transparent; border: 1px solid rgba(255,255,255,0.2); border-radius: 999px; font-weight: 700; font-size: 15px; text-decoration: none; transition: all 0.25s; }
      .btn-ghost:hover { background: rgba(255,255,255,0.06); color: white; border-color: rgba(255,255,255,0.4); }

      .micro { margin-top: 14px; font-size: 13px; color: rgba(255,255,255,0.55); }
      .micro::before { content: '✓ '; color: var(--turq-light); font-weight: 800; }

      /* HERO PHONE */
      .phone-stage { display: flex; justify-content: center; align-items: center; }
      .phone { width: 320px; max-width: 100%; aspect-ratio: 9/19; background: linear-gradient(160deg, #1a1a1d 0%, #0d0e10 100%); border-radius: 44px; padding: 8px; box-shadow: 0 40px 100px rgba(0,0,0,0.55), 0 0 80px rgba(20,184,166,0.18); border: 1.5px solid #2a2a2d; position: relative; transform: rotate(-3deg); animation: phone-breath 7s ease-in-out infinite; }
      @keyframes phone-breath { 50% { transform: rotate(-3deg) translateY(-6px); } }
      .phone-screen { width: 100%; height: 100%; border-radius: 36px; background: var(--wa-bg); overflow: hidden; display: flex; flex-direction: column; position: relative; }
      .phone-notch { position: absolute; top: 8px; left: 50%; transform: translateX(-50%); width: 110px; height: 28px; background: black; border-radius: 16px; z-index: 10; }
      .wa-top { padding: 38px 14px 10px; background: var(--bot); display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
      .wa-top .av { width: 36px; height: 36px; border-radius: 50%; background: var(--turq); display: flex; align-items: center; justify-content: center; }
      .wa-top .av img { width: 22px; height: 22px; filter: brightness(0) invert(1); }
      .wa-top .id { flex: 1; min-width: 0; }
      .wa-top .id .n { font-size: 14px; font-weight: 700; color: white; line-height: 1.1; }
      .wa-top .id .s { font-size: 11px; color: rgba(255,255,255,0.55); margin-top: 2px; display: flex; align-items: center; gap: 4px; }
      .wa-top .id .s::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--good); }
      .wa-body { flex: 1; padding: 14px 10px; display: flex; flex-direction: column; gap: 6px; background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="200" height="200"><defs><pattern id="p" patternUnits="userSpaceOnUse" width="40" height="40"><circle cx="20" cy="20" r="1" fill="rgba(255,255,255,0.04)"/></pattern></defs><rect width="100%" height="100%" fill="%230B141A"/><rect width="100%" height="100%" fill="url(%23p)"/></svg>'); }
      .b { max-width: 80%; padding: 7px 11px 5px; border-radius: 13px; font-size: 13px; line-height: 1.4; opacity: 0; transform: translateY(8px); animation: bub-in 0.45s cubic-bezier(0.22,1,0.36,1) forwards; }
      .b1 { animation-delay: 1s; }
      .b2 { animation-delay: 2.2s; }
      .b3 { animation-delay: 3.6s; }
      @keyframes bub-in { to { opacity: 1; transform: translateY(0); } }
      .b.bot { align-self: flex-start; background: var(--bot); color: white; border-bottom-left-radius: 4px; }
      .b.usr { align-self: flex-end; background: var(--usr); color: white; border-bottom-right-radius: 4px; }
      .b strong { font-weight: 700; }
      .b em { font-style: normal; color: var(--turq-light); font-weight: 600; }
      .b .ts { display: block; margin-top: 3px; font-size: 9px; opacity: 0.55; text-align: right; }
      .b.usr .ts::after { content: ' ✓✓'; color: var(--turq-light); }

      /* ============ SCROLLY ============ */
      .scrolly-shell { position: relative; }
      .scene { position: relative; min-height: 200vh; }
      .scene-pin { position: sticky; top: 0; height: 100vh; display: flex; align-items: center; justify-content: center; padding: 0 22px; overflow: hidden; }

      /* SCENE 1 · word reveal */
      .s1 .stage { max-width: 1100px; text-align: center; }
      .s1 .pre { font-family: 'Inter', sans-serif; font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--turq-light); font-weight: 800; opacity: 0.85; }
      .s1 .lines { font-family: 'Sora', sans-serif; font-weight: 800; font-size: clamp(34px, 6.5vw, 80px); letter-spacing: -0.04em; line-height: 1.05; margin-top: 32px; }
      .s1 .lines p { padding: 14px 0; }
      .s1 .lines p.dim { color: rgba(255,255,255,0.5); font-weight: 500; font-size: 0.7em; }
      .s1 .word { display: inline-block; opacity: 0; transform: translateY(30px); filter: blur(8px); transition: opacity 0.7s cubic-bezier(0.22,1,0.36,1), transform 0.7s cubic-bezier(0.22,1,0.36,1), filter 0.7s cubic-bezier(0.22,1,0.36,1); margin-right: 0.16em; }
      .s1 .word.show { opacity: 1; transform: translateY(0); filter: blur(0); }
      .s1 .word.accent { background: linear-gradient(115deg, var(--turq-light), var(--turq-paler), white); -webkit-background-clip: text; background-clip: text; color: transparent; }

      /* SCENE 2 · SVG flow */
      .s2 .stage { max-width: 1100px; width: 100%; display: grid; grid-template-columns: 1fr; gap: 32px; align-items: center; }
      @media (min-width: 900px) { .s2 .stage { grid-template-columns: 1fr 1.2fr; gap: 50px; } }
      .s2 .pre { font-family: 'Inter', sans-serif; font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--turq-light); font-weight: 800; }
      .s2 h2 { font-family: 'Sora', sans-serif; font-weight: 800; font-size: clamp(34px, 6vw, 64px); letter-spacing: -0.04em; line-height: 1.05; margin-top: 16px; }
      .s2 h2 em { font-style: normal; background: linear-gradient(115deg, var(--turq-light), var(--turq-paler)); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .s2 p.deck { margin-top: 18px; font-size: 17px; color: rgba(255,255,255,0.65); line-height: 1.55; max-width: 480px; }
      .svg-stage { aspect-ratio: 1.1/1; max-width: 520px; margin: 0 auto; width: 100%; }
      .svg-flow path.line { stroke: var(--turq-light); stroke-width: 2.5; fill: none; stroke-dasharray: 2200; stroke-dashoffset: 2200; transition: stroke-dashoffset 0.4s linear; filter: drop-shadow(0 0 8px var(--turq)); }
      .svg-flow .node-circle { fill: var(--turq); opacity: 0; transition: opacity 0.5s; }
      .svg-flow .node-pulse { fill: none; stroke: var(--turq-light); stroke-width: 2; opacity: 0; transform-origin: center; transition: opacity 0.5s; }
      .svg-flow .node-circle.show { opacity: 1; }
      .svg-flow .node-pulse.show { opacity: 0.6; animation: pulse-svg 1.8s ease-out infinite; }
      @keyframes pulse-svg { 0% { transform: scale(1); opacity: 0.6; } 100% { transform: scale(2.4); opacity: 0; } }
      .svg-flow .label { fill: var(--paper); font-family: 'Sora', sans-serif; font-weight: 700; font-size: 18px; opacity: 0; transition: opacity 0.5s; }
      .svg-flow .label.show { opacity: 1; }
      .svg-flow .emoji { font-size: 26px; opacity: 0; transition: opacity 0.5s; }
      .svg-flow .emoji.show { opacity: 1; }

      /* SCENE 3 · stats counter */
      .s3 .stage { max-width: 1100px; width: 100%; text-align: center; }
      .s3 .pre { font-family: 'Inter', sans-serif; font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--turq-light); font-weight: 800; }
      .s3 h2 { font-family: 'Sora', sans-serif; font-weight: 800; font-size: clamp(28px, 4.5vw, 48px); letter-spacing: -0.035em; max-width: 720px; margin: 16px auto 56px; line-height: 1.2; }
      .s3 .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 32px; }
      .s3 .stat .v { font-family: 'Sora', sans-serif; font-weight: 900; font-size: clamp(56px, 10vw, 120px); letter-spacing: -0.05em; line-height: 0.95; background: linear-gradient(115deg, var(--turq-light), var(--turq-paler), white); -webkit-background-clip: text; background-clip: text; color: transparent; font-variant-numeric: tabular-nums; }
      .s3 .stat .l { margin-top: 10px; font-size: 13px; color: rgba(255,255,255,0.55); text-transform: uppercase; letter-spacing: 0.14em; font-weight: 700; }

      /* SCENE 4 · mega type */
      .s4 .stage { max-width: 1280px; width: 100%; text-align: center; }
      .s4 h2 { font-family: 'Sora', sans-serif; font-weight: 900; font-size: clamp(72px, 18vw, 280px); letter-spacing: -0.055em; line-height: 0.85; }
      .s4 h2 em { font-style: italic; font-weight: 400; color: var(--turq-light); }
      .s4 .deck { margin-top: 32px; font-size: clamp(17px, 2.4vw, 26px); color: rgba(255,255,255,0.7); max-width: 600px; margin-left: auto; margin-right: auto; line-height: 1.4; font-weight: 500; }

      /* SCENE 5 · chat demo big */
      .s5 .stage { max-width: 920px; width: 100%; display: flex; flex-direction: column; align-items: center; }
      .s5 .pre { font-family: 'Inter', sans-serif; font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--turq-light); font-weight: 800; }
      .s5 h2 { font-family: 'Sora', sans-serif; font-weight: 800; font-size: clamp(28px, 4.5vw, 44px); letter-spacing: -0.035em; line-height: 1.2; margin-top: 14px; max-width: 600px; text-align: center; }
      .s5 h2 em { font-style: normal; color: var(--turq-light); }
      .chat-show { width: 100%; max-width: 540px; margin-top: 36px; padding: 22px; background: rgba(11,20,26,0.8); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.08); border-radius: 22px; display: flex; flex-direction: column; gap: 10px; }
      .chat-show .b { max-width: 86%; padding: 10px 14px 8px; border-radius: 14px; font-size: 14px; line-height: 1.45; }
      .chat-show .b.usr { background: var(--usr); color: white; border-bottom-right-radius: 4px; align-self: flex-end; }
      .chat-show .b.bot { background: var(--bot); color: white; border-bottom-left-radius: 4px; align-self: flex-start; }
      .chat-show .b strong { font-weight: 700; }
      .chat-show .b em { font-style: normal; color: var(--turq-light); font-weight: 600; }
      .chat-show .ts { display: block; margin-top: 4px; font-size: 10px; opacity: 0.55; text-align: right; }
      .chat-show .ts.usr-ts::after { content: ' ✓✓'; color: var(--turq-light); }

      /* SCENE 6 · target users */
      .s6 .stage { max-width: 1100px; width: 100%; text-align: center; }
      .s6 .pre { font-family: 'Inter', sans-serif; font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--turq-light); font-weight: 800; }
      .s6 h2 { font-family: 'Sora', sans-serif; font-weight: 800; font-size: clamp(28px, 4.5vw, 48px); letter-spacing: -0.035em; line-height: 1.2; margin-top: 14px; max-width: 720px; margin-left: auto; margin-right: auto; }
      .s6 h2 em { font-style: normal; color: var(--turq-light); }
      .s6 .grid { margin-top: 48px; display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 16px; }
      .s6 .gi { padding: 24px 18px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 18px; transition: all 0.3s; }
      .s6 .gi:hover { transform: translateY(-4px); border-color: rgba(94,234,212,0.4); background: rgba(20,184,166,0.06); }
      .s6 .gi .ic { font-size: 36px; }
      .s6 .gi .n { margin-top: 12px; font-family: 'Sora', sans-serif; font-weight: 700; font-size: 16px; }

      /* SCENE 7 · final cta */
      .s7 .stage { max-width: 1280px; width: 100%; text-align: center; }
      .s7 h2 { font-family: 'Sora', sans-serif; font-weight: 900; font-size: clamp(48px, 9vw, 120px); letter-spacing: -0.055em; line-height: 0.92; }
      .s7 h2 em { font-style: normal; background: linear-gradient(115deg, var(--turq-light), var(--turq-paler)); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .s7 .deck { margin-top: 24px; font-size: clamp(15px, 2vw, 19px); color: rgba(255,255,255,0.7); max-width: 560px; margin-left: auto; margin-right: auto; line-height: 1.5; }
      .s7 .cta-mega { display: inline-flex; align-items: center; gap: 12px; padding: 22px 40px; background: var(--paper); color: var(--ink); border-radius: 999px; font-weight: 800; font-size: 18px; text-decoration: none; margin-top: 36px; box-shadow: 0 24px 80px rgba(94,234,212,0.3); transition: all 0.3s cubic-bezier(0.22,1,0.36,1); }
      .s7 .cta-mega:hover { transform: translateY(-4px); box-shadow: 0 32px 100px rgba(94,234,212,0.45); }
      .s7 .cta-mega::after { content: '→'; transition: transform 0.3s; }
      .s7 .cta-mega:hover::after { transform: translateX(6px); }
      .s7 .micro-fin { margin-top: 16px; font-size: 13px; color: rgba(255,255,255,0.5); }

      /* ============ LIVE DEMO ============ */
      .demo-section { padding: 120px 22px; max-width: 1280px; margin: 0 auto; }
      .demo-grid { display: grid; grid-template-columns: 1fr; gap: 40px; align-items: center; }
      @media (min-width: 1024px) { .demo-grid { grid-template-columns: 1fr 1fr; gap: 60px; } }
      .demo-h .pre { font-family: 'Inter', sans-serif; font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--turq-light); font-weight: 800; }
