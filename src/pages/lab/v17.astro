    <footer class="ft">
      © 2026 Zymplo · World-Class Edition · <a href="/lab/">Lab</a> · <a href="/">Landing atual</a> · <a href="/lab/v16/">← V16</a> · <a href="/lab/v18/">V18 →</a>
    </footer>

    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const $ = (s, c=document) => c.querySelector(s);
      const $$ = (s, c=document) => [...c.querySelectorAll(s)];

      // ===== PROGRESS BAR + SCROLL HINT =====
      const prog = $('#prog');
      const hint = $('#hint');
      function onScroll() {
        const sy = window.scrollY;
        const sh = document.documentElement.scrollHeight - window.innerHeight;
        const total = Math.min(1, Math.max(0, sy / sh));
        prog.style.width = (total * 100) + '%';
        if (sy > 100) hint.classList.add('hidden');
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // ===== HERO · TYPED ROTATION =====
      const examples = [
        'Cobrar João R$200',
        'Quanto ganhei hoje?',
        'Agendar cliente amanhã',
        'Resumo do mês',
        'Cobrar Carlos R$350',
      ];
      const typedEl = $('#typedText');
      let exIdx = 0, charIdx = 0, deleting = false;
      function tick() {
        if (reduceMotion) { typedEl.textContent = examples[0]; return; }
        const cur = examples[exIdx];
        if (!deleting) {
          charIdx++;
          typedEl.textContent = cur.slice(0, charIdx);
          if (charIdx === cur.length) { setTimeout(() => { deleting = true; tick(); }, 1700); return; }
          setTimeout(tick, 70 + Math.random() * 60);
        } else {
          charIdx--;
          typedEl.textContent = cur.slice(0, charIdx);
          if (charIdx === 0) { deleting = false; exIdx = (exIdx + 1) % examples.length; setTimeout(tick, 240); return; }
          setTimeout(tick, 30);
        }
      }
      tick();

      // ===== SCROLLY · SCENES =====
      // Scene 1 · word reveal based on scroll progress
      const s1 = $('.scene.s1');
      const s1words = $$('.s1 .word');
      // Scene 2 · path drawing
      const flowPath = $('#flowPath');
      const pathLen = flowPath ? flowPath.getTotalLength() : 0;
      if (flowPath) { flowPath.style.strokeDasharray = pathLen; flowPath.style.strokeDashoffset = pathLen; }
      const s2nodes = $$('.svg-flow .node-circle, .svg-flow .node-pulse');
      const s2labels = $$('.svg-flow .label, .svg-flow .emoji');
      // Scene 3 · stat counters
      const s3stats = $$('.s3 .stat .v');
      const s3animated = new Set();

      function getProgress(scene) {
        const r = scene.getBoundingClientRect();
        const scrollableH = scene.offsetHeight - window.innerHeight;
        return Math.max(0, Math.min(1, -r.top / scrollableH));
      }

      function onScrolly() {
        if (reduceMotion) return;
        // S1
        if (s1) {
          const p = getProgress(s1);
          const showCount = Math.floor(p * (s1words.length + 4));
          s1words.forEach((w, i) => { if (i < showCount) w.classList.add('show'); else w.classList.remove('show'); });
        }
        // S2
        const s2 = $('.scene.s2');
        if (s2 && pathLen) {
          const p = getProgress(s2);
          flowPath.style.strokeDashoffset = pathLen * Math.max(0, 1 - p * 1.4);
          // 4 nodes appear at 25/50/75/100 % path progress
          for (let i = 0; i < 4; i++) {
            const threshold = 0.18 + i * 0.18;
            const show = p > threshold;
            const cIdx = i * 2;
            if (s2nodes[cIdx]) s2nodes[cIdx].classList.toggle('show', show);
            if (s2nodes[cIdx + 1]) s2nodes[cIdx + 1].classList.toggle('show', show);
            if (s2labels[i * 2]) s2labels[i * 2].classList.toggle('show', show);
            if (s2labels[i * 2 + 1]) s2labels[i * 2 + 1].classList.toggle('show', show);
          }
        }
        // S3 counters
        const s3 = $('.scene.s3');
        if (s3) {
          const r = s3.getBoundingClientRect();
          if (r.top < window.innerHeight * 0.6 && r.bottom > 0 && !s3animated.has('done')) {
            s3animated.add('done');
            s3stats.forEach((v) => {
              const target = parseFloat(v.dataset.target || '0');
              const prefix = v.dataset.prefix || '';
              const suffix = v.dataset.suffix || '';
              const decimals = parseInt(v.dataset.decimals ?? '0');
              const dur = 1700; const t0 = performance.now();
              function step(t) {
                const p = Math.min(1, (t - t0) / dur);
                const eased = 1 - Math.pow(1 - p, 3);
                const cur = target * eased;
                v.textContent = prefix + cur.toLocaleString('pt-BR', { minimumFractionDigits: decimals, maximumFractionDigits: decimals }) + suffix;
                if (p < 1) requestAnimationFrame(step);
              }
              requestAnimationFrame(step);
            });
          }
        }
      }
      window.addEventListener('scroll', onScrolly, { passive: true });
      onScrolly();

      // ===== LIVE DEMO CHAT =====
      const live = $('#livechat');
      const lin = $('#liveInput');
      const lsend = $('#liveSend');
      const t = () => 'agora';
      function addBub(side, html) {
        const b = document.createElement('div'); b.className = 'b ' + side; b.style.cssText = 'opacity: 0; transform: translateY(8px); animation: bub-in 0.4s cubic-bezier(0.22,1,0.36,1) forwards; max-width: 80%; padding: 7px 11px 5px; border-radius: 13px; font-size: 13px; line-height: 1.4;';
        b.style.background = side === 'usr' ? 'var(--usr)' : 'var(--bot)';
        b.style.color = 'white';
        b.style.alignSelf = side === 'usr' ? 'flex-end' : 'flex-start';
        b.style[side === 'usr' ? 'borderBottomRightRadius' : 'borderBottomLeftRadius'] = '4px';
        b.innerHTML = html + '<span class="ts" style="display:block;margin-top:3px;font-size:9px;opacity:0.55;text-align:right;">' + t() + (side === 'usr' ? ' ✓✓' : '') + '</span>';
        live.appendChild(b);
        live.scrollTop = live.scrollHeight;
        return b;
      }
      function showTyping() {
        const tp = document.createElement('div'); tp.className = 'typing'; tp.innerHTML = '<span></span><span></span><span></span>';
        live.appendChild(tp); live.scrollTop = live.scrollHeight; return tp;
      }
      function reply(msg) {
        const m = msg.toLowerCase();
        if (/(quanto.*ganhe|resumo|hoje|esse m[eê]s)/.test(m)) {
          return [
            'Esse mês você está com <strong>R$ 8.470 ✨</strong>',
            'Detalhe:<br/>· recebido: R$ 8.470<br/>· pendente: R$ 350 (Carlos)<br/>· gastos: R$ 1.240',
            'Quer que eu mande um lembrete pro Carlos?',
          ];
        }
        if (/(cobrar?|cobranza|cobranca)/.test(m)) {
          const monto = m.match(/(\d{2,})/);
          const a = m.match(/cobrar?\s+([a-zà-ÿ]+)/i);
          return [
            '💸 Cobrança preparada para <strong>' + (a ? a[1] : 'seu cliente') + '</strong>' + (monto ? ' · <em>R$ ' + Number(monto[1]).toLocaleString('pt-BR') + '</em>' : ''),
            'Mando uma mensagem cordial e simpática · com link Pix anexado. <strong>Posso enviar?</strong>',
          ];
        }
        if (/(agendar?|reservar?|reuni[aã]o|cliente amanha|cliente amanh[aã])/.test(m)) {
          return ['📅 Agendado · te aviso ' + (m.includes('amanh') ? '<strong>amanhã</strong>' : 'na hora') + '.', 'Se quiser ajustar, me diga "às 9:30" ou outro horário 👌'];
        }
        if (/(plano|preço|preco|quanto custa)/.test(m)) {
          return ['💎 Tenho 4 planos:<br/>0 · grátis para sempre (você está aqui)<br/>1 · STARTER R$19/mês<br/>2 · <strong>PRO R$39/mês</strong> ✨ <em>o mais popular</em><br/>3 · GOLD R$79/mês', 'Pode começar grátis sem cartão. Qual te interessa?'];
        }
        if (/(oi|ol[aá]|hi|e a[íi])/.test(m)) {
          return ['Oi! 👋 O que você quer testar?', 'Tenta pedir: "quanto ganhei hoje" · "cobrar Carlos 350" · "agendar cliente amanhã"'];
        }
        return ['Boa! Posso te ajudar. Tenta algo concreto:<br/>· <em>cobrar</em> alguém<br/>· <em>quanto ganhei</em><br/>· <em>agendar</em> cliente<br/>· <em>resumo do mês</em>'];
      }
      function userSend(msg) {
        if (!msg.trim()) return;
        addBub('usr', msg);
        lin.value = '';
        const tp = showTyping();
        const responses = reply(msg);
        responses.forEach((r, i) => {
          setTimeout(() => {
            if (i === 0) tp.remove();
            addBub('bot', r);
          }, reduceMotion ? 0 : 700 + i * 950);
        });
      }
      lsend && lsend.addEventListener('click', () => userSend(lin.value));
      lin && lin.addEventListener('keydown', (e) => { if (e.key === 'Enter') userSend(lin.value); });
      $$('.qp').forEach((b) => b.addEventListener('click', () => userSend(b.dataset.prompt)));
    </script>
  </body>
</html>
