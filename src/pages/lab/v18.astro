    <footer class="ft">
      © 2026 Zymplo · Apple/Nubank Edition · <a href="/lab/">Lab</a> · <a href="/">Landing</a> · <a href="/lab/v17/">← V17</a> · <a href="/lab/v19/">V19 →</a>
    </footer>

    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const $ = (s, c=document) => c.querySelector(s);
      const $$ = (s, c=document) => [...c.querySelectorAll(s)];

      // PROGRESS
      const prog = $('#prog'); const hint = $('#hint');
      function onScroll() {
        const sy = window.scrollY;
        const sh = document.documentElement.scrollHeight - window.innerHeight;
        const total = Math.min(1, Math.max(0, sy / sh));
        prog.style.width = (total * 100) + '%';
        if (sy > 100) hint.classList.add('hidden');
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // TYPED ROTATION
      const examples = ['Cobrar João R$200', 'Quanto ganhei hoje?', 'Agendar cliente amanhã', 'Quem ainda não pagou?', 'Resumo do mês'];
      const typedEl = $('#typedText');
      let exIdx = 0, charIdx = 0, deleting = false;
      function tick() {
        if (reduceMotion) { typedEl.textContent = examples[0]; return; }
        const cur = examples[exIdx];
        if (!deleting) {
          charIdx++; typedEl.textContent = cur.slice(0, charIdx);
          if (charIdx === cur.length) { setTimeout(() => { deleting = true; tick(); }, 1700); return; }
          setTimeout(tick, 70 + Math.random() * 60);
        } else {
          charIdx--; typedEl.textContent = cur.slice(0, charIdx);
          if (charIdx === 0) { deleting = false; exIdx = (exIdx + 1) % examples.length; setTimeout(tick, 240); return; }
          setTimeout(tick, 30);
        }
      }
      tick();

      // SCROLLY
      const s1 = $('.scene.s1'); const s1words = $$('.s1 .word');
      const flowPath = $('#flowPath'); const pathLen = flowPath ? flowPath.getTotalLength() : 0;
      if (flowPath) { flowPath.style.strokeDasharray = pathLen; flowPath.style.strokeDashoffset = pathLen; }
      const s2nodes = $$('.svg-flow .node-circle, .svg-flow .node-pulse');
      const s2labels = $$('.svg-flow .label, .svg-flow .emoji');
      const s3stats = $$('.s3 .stat .v');
      const s3animated = new Set();
      function getProgress(scene) { const r = scene.getBoundingClientRect(); const sH = scene.offsetHeight - window.innerHeight; return Math.max(0, Math.min(1, -r.top / sH)); }
      function onScrolly() {
        if (reduceMotion) return;
        if (s1) {
          const p = getProgress(s1);
          const showCount = Math.floor(p * (s1words.length + 4));
          s1words.forEach((w, i) => { if (i < showCount) w.classList.add('show'); else w.classList.remove('show'); });
        }
        const s2 = $('.scene.s2');
        if (s2 && pathLen) {
          const p = getProgress(s2);
          flowPath.style.strokeDashoffset = pathLen * Math.max(0, 1 - p * 1.4);
          for (let i = 0; i < 4; i++) {
            const threshold = 0.18 + i * 0.18;
            const show = p > threshold;
            const cIdx = i * 2;
            if (s2nodes[cIdx]) s2nodes[cIdx].classList.toggle('show', show);
            if (s2nodes[cIdx + 1]) s2nodes[cIdx + 1].classList.toggle('show', show);
            if (s2labels[i * 2]) s2labels[i * 2].classList.toggle('show', show);
            if (s2labels[i * 2 + 1]) s2labels[i * 2 + 1].classList.toggle('show', show);
          }
        }
        const s3 = $('.scene.s3');
        if (s3) {
          const r = s3.getBoundingClientRect();
          if (r.top < window.innerHeight * 0.6 && r.bottom > 0 && !s3animated.has('done')) {
            s3animated.add('done');
            s3stats.forEach((v) => {
              const target = parseFloat(v.dataset.target || '0');
              const prefix = v.dataset.prefix || ''; const suffix = v.dataset.suffix || '';
              const decimals = parseInt(v.dataset.decimals ?? '0');
              const dur = 1700; const t0 = performance.now();
              function step(t) {
                const p = Math.min(1, (t - t0) / dur);
                const eased = 1 - Math.pow(1 - p, 3);
                const cur = target * eased;
                v.textContent = prefix + cur.toLocaleString('pt-BR', { minimumFractionDigits: decimals, maximumFractionDigits: decimals }) + suffix;
                if (p < 1) requestAnimationFrame(step);
              }
              requestAnimationFrame(step);
            });
          }
        }
      }
      window.addEventListener('scroll', onScrolly, { passive: true });
      onScrolly();

      // ONBOARDING SIM
      const onbBody = $('#onbBody');
      const onbScript = [
        ['usr', 'Oi Zymplo, quero começar'],
        ['typing', 800],
        ['bot', 'Oi 👋 Eu sou a <strong>Zymplo</strong>. Vou organizar seu trabalho e suas cobranças.'],
        ['typing', 700],
        ['bot', 'Como posso te chamar?'],
        ['usr', 'Diego'],
        ['typing', 700],
        ['bot', 'Prazer, Diego. Você trabalha com o quê?'],
        ['quicks', ['Serviços', 'Vendas', 'Consultoria', 'Loja']],
        ['usr', 'Serviços'],
        ['typing', 700],
        ['bot', 'Você cobra por <em>serviço</em>, <em>produto</em> ou <em>mensalidade</em>?'],
        ['quicks', ['Serviço', 'Produto', 'Mensalidade']],
        ['usr', 'Serviço'],
        ['typing', 800],
        ['bot', 'Vamos criar sua primeira cobrança?'],
        ['usr', 'cobrar João 200'],
        ['typing', 900],
        ['bot', 'Perfeito ✨ Quer enviar por <strong>Pix</strong>, <strong>WhatsApp</strong> ou só salvar como pendente?'],
        ['quicks', ['Enviar Pix', 'Enviar WhatsApp', 'Salvar pendente']],
        ['usr', 'Enviar Pix'],
        ['typing', 800],
        ['bot', 'Pronto Diego ✅<br/>Sua primeira cobrança está organizada · agora seu trabalho começa a ficar mais leve.'],
      ];

      function onbAddBub(side, html) {
        const b = document.createElement('div'); b.className = 'b ' + side; b.style.cssText = 'opacity: 0; transform: translateY(8px); animation: bub-in 0.4s cubic-bezier(0.22,1,0.36,1) forwards; max-width: 80%; padding: 7px 11px 5px; border-radius: 13px; font-size: 13px; line-height: 1.4;';
        b.style.background = side === 'usr' ? '#6A00F4' : '#1F2C33';
        b.style.color = 'white';
        b.style.alignSelf = side === 'usr' ? 'flex-end' : 'flex-start';
        b.style[side === 'usr' ? 'borderBottomRightRadius' : 'borderBottomLeftRadius'] = '4px';
        b.innerHTML = html + '<span style="display:block;margin-top:3px;font-size:9px;opacity:0.55;text-align:right;">' + (side === 'usr' ? 'agora ✓✓' : 'agora') + '</span>';
        onbBody.appendChild(b); onbBody.scrollTop = onbBody.scrollHeight;
      }
      function onbTyping() {
        const tp = document.createElement('div'); tp.className = 'typing'; tp.innerHTML = '<span></span><span></span><span></span>';
        tp.style.cssText = 'align-self: flex-start; padding: 10px 12px; border-radius: 13px; border-bottom-left-radius: 4px; background: #1F2C33; display: inline-flex; gap: 3px;';
        tp.querySelectorAll('span').forEach((s) => { s.style.cssText = 'width: 6px; height: 6px; border-radius: 50%; background: rgba(255,255,255,0.5); animation: dot 1.3s ease-in-out infinite;'; });
        if (tp.children[1]) tp.children[1].style.animationDelay = '0.2s';
        if (tp.children[2]) tp.children[2].style.animationDelay = '0.4s';
        onbBody.appendChild(tp); onbBody.scrollTop = onbBody.scrollHeight; return tp;
      }
      function onbQuicks(arr) {
        const w = document.createElement('div');
        w.style.cssText = 'align-self: flex-start; display: flex; flex-wrap: wrap; gap: 6px; padding: 4px 0;';
        arr.forEach((q) => {
          const c = document.createElement('span');
          c.style.cssText = 'padding: 6px 12px; background: rgba(106,0,244,0.12); border: 1px solid rgba(189,131,255,0.35); color: #BD83FF; border-radius: 999px; font-size: 12px; font-weight: 600;';
          c.textContent = q;
          w.appendChild(c);
        });
        onbBody.appendChild(w); onbBody.scrollTop = onbBody.scrollHeight;
      }

      let onbStarted = false;
      function startOnb() {
        if (onbStarted) return;
        onbStarted = true;
        let typing = null;
        let i = 0;
        function step() {
          if (i >= onbScript.length) return;
          const [type, val] = onbScript[i]; i++;
          if (type === 'usr' || type === 'bot') {
            if (typing) { typing.remove(); typing = null; }
            onbAddBub(type, val);
            setTimeout(step, reduceMotion ? 0 : 700);
          } else if (type === 'typing') {
            typing = onbTyping();
            setTimeout(step, reduceMotion ? 0 : val);
          } else if (type === 'quicks') {
            onbQuicks(val);
            setTimeout(step, reduceMotion ? 0 : 800);
          }
        }
        step();
      }
      const onbObs = new IntersectionObserver((entries) => { entries.forEach((e) => { if (e.isIntersecting) { startOnb(); onbObs.disconnect(); } }); }, { threshold: 0.3 });
      if (onbBody) onbObs.observe(onbBody);
    </script>
  </body>
</html>
