---
const title = 'Zymplo · Apple/Nubank Edition · V18';
const description = 'Seu negócio funcionando sozinho, no WhatsApp.';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0B0B0F" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="https://sims.zymplo.com/brand/isotipo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" />
    <style is:inline>
      /* ===== DESIGN SYSTEM TOKENS ===== */
      :root {
        /* Purple scale (Nubank-inspired, 10 steps) */
        --p-50: #F5EBFF; --p-100: #E9D6FF; --p-200: #D4ADFF; --p-300: #BD83FF;
        --p-400: #9F4DFF; --p-500: #6A00F4; --p-600: #5A00CC; --p-700: #4400A3;
        --p-800: #2E007A; --p-900: #1A0052;
        /* Neutral */
        --n-0: #FFFFFF; --n-50: #FAFAFA; --n-100: #F5F5F7; --n-200: #E5E5EA;
        --n-400: #8E8E93; --n-700: #1F1F23; --n-900: #0B0B0F;
        /* Semantic */
        --good: #22C55E; --warn: #F59E0B; --error: #EF4444;
        /* Brand */
        --wa: #25D366;
        /* Gradients */
        --grad-ai: linear-gradient(135deg, #6A00F4 0%, #2E70FF 50%, #00E5FF 100%);
        --grad-purple: linear-gradient(115deg, #6A00F4 0%, #BD83FF 100%);
        --grad-glow: radial-gradient(circle, rgba(106,0,244,0.45) 0%, transparent 70%);
        /* Spacing 4px grid · 4 8 12 16 24 32 48 64 96 */
        --r-12: 12px; --r-16: 16px; --r-24: 24px; --r-32: 32px; --r-pill: 999px;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body { font-family: 'Inter', system-ui, sans-serif; background: var(--n-900); color: var(--n-0); min-height: 100vh; -webkit-font-smoothing: antialiased; line-height: 1.5; overflow-x: hidden; }
      img { max-width: 100%; display: block; }

      /* ===== TYPOGRAPHY SYSTEM ===== */
      .display-xl { font-weight: 900; font-size: clamp(56px, 11vw, 132px); letter-spacing: -0.05em; line-height: 0.92; }
      .display-l  { font-weight: 800; font-size: clamp(40px, 7vw, 80px); letter-spacing: -0.04em; line-height: 1; }
      .h1 { font-weight: 800; font-size: clamp(34px, 5vw, 56px); letter-spacing: -0.035em; line-height: 1.1; }
      .h2 { font-weight: 800; font-size: clamp(28px, 4vw, 44px); letter-spacing: -0.03em; line-height: 1.15; }
      .h3 { font-weight: 700; font-size: clamp(20px, 2.4vw, 26px); letter-spacing: -0.02em; line-height: 1.25; }
      .body-l { font-size: 18px; line-height: 1.5; }
      .body-m { font-size: 16px; line-height: 1.55; }
      .body-s { font-size: 14px; line-height: 1.55; }
      .caption { font-size: 12px; line-height: 1.4; }
      .micro { font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 700; }

      /* ===== PROGRESS BAR ===== */
      .progress { position: fixed; top: 0; left: 0; height: 3px; background: var(--grad-ai); z-index: 999; width: 0%; transition: width 0.05s linear; box-shadow: 0 0 8px var(--p-400); }

      /* ===== NAV ===== */
      .nav { position: fixed; top: 14px; left: 14px; z-index: 100; padding: 6px 12px 6px 6px; background: rgba(255,255,255,0.05); backdrop-filter: blur(20px) saturate(160%); border: 1px solid rgba(255,255,255,0.12); border-radius: var(--r-pill); font-size: 12px; font-weight: 700; color: var(--n-0); text-decoration: none; display: flex; align-items: center; gap: 6px; transition: all 0.2s; }
      .nav:hover { background: rgba(255,255,255,0.1); }
      .nav img { height: 18px; }
      .lab-badge { position: fixed; top: 14px; right: 14px; z-index: 100; padding: 6px 12px; background: rgba(106,0,244,0.18); backdrop-filter: blur(20px); border: 1px solid rgba(189,131,255,0.4); border-radius: var(--r-pill); font-size: 11px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--p-200); text-decoration: none; }

      /* ===== SCROLL HINT ===== */
      .scroll-hint { position: fixed; bottom: 22px; left: 50%; transform: translateX(-50%); padding: 7px 16px 7px 14px; background: rgba(0,0,0,0.55); backdrop-filter: blur(14px); border: 1px solid rgba(255,255,255,0.12); border-radius: var(--r-pill); color: rgba(255,255,255,0.85); font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; z-index: 50; opacity: 0.9; pointer-events: none; transition: opacity 0.4s; display: inline-flex; align-items: center; gap: 8px; }
      .scroll-hint .arr { animation: bounce-y 1.6s ease-in-out infinite; }
      @keyframes bounce-y { 50% { transform: translateY(4px); } }
      .scroll-hint.hidden { opacity: 0; }

      /* ===== HERO ===== */
      .hero { position: relative; min-height: 100vh; padding: 100px 22px 60px; max-width: 1280px; margin: 0 auto; display: flex; flex-direction: column; justify-content: center; }
      .hero-bg { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
      .hero-bg::before { content: ''; position: absolute; top: -10%; right: -10%; width: 80vw; height: 80vw; background: var(--grad-glow); filter: blur(80px); animation: float-x 20s ease-in-out infinite; opacity: 0.7; }
      .hero-bg::after { content: ''; position: absolute; bottom: -10%; left: -15%; width: 60vw; height: 60vw; background: radial-gradient(circle, rgba(46,112,255,0.35) 0%, transparent 70%); filter: blur(80px); animation: float-y 24s ease-in-out infinite; }
      @keyframes float-x { 50% { transform: translate(40px, -30px); } }
      @keyframes float-y { 50% { transform: translate(-40px, 30px); } }

      .hero-grid { position: relative; z-index: 2; display: grid; grid-template-columns: 1fr; gap: 48px; align-items: center; }
      @media (min-width: 1024px) { .hero-grid { grid-template-columns: 1.15fr 1fr; gap: 64px; } }

      .pill { display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; background: rgba(106,0,244,0.16); border: 1px solid rgba(189,131,255,0.4); border-radius: var(--r-pill); color: var(--p-200); font-weight: 800; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; }
      .pill .pulse { width: 7px; height: 7px; border-radius: 50%; background: var(--p-400); box-shadow: 0 0 0 0 var(--p-400); animation: pulse-soft 2.4s ease-out infinite; }
      @keyframes pulse-soft { 0% { box-shadow: 0 0 0 0 rgba(159,77,255,0.7); } 70% { box-shadow: 0 0 0 12px rgba(159,77,255,0); } 100% { box-shadow: 0 0 0 0 rgba(159,77,255,0); } }

      h1.hero-h { margin-top: 22px; }
      h1.hero-h em { font-style: normal; background: var(--grad-ai); -webkit-background-clip: text; background-clip: text; color: transparent; background-size: 200% 200%; animation: shimmer 6s ease-in-out infinite; }
      @keyframes shimmer { 0%,100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }
      .hero-sub { margin-top: 22px; color: rgba(255,255,255,0.72); max-width: 540px; font-weight: 500; }

      /* ===== INPUT (CHAT STYLE) ===== */
      .input-shell { margin-top: 32px; max-width: 540px; }
      .chat-input { display: flex; align-items: center; gap: 10px; padding: 8px 8px 8px 18px; background: rgba(255,255,255,0.05); border: 1.5px solid rgba(255,255,255,0.12); border-radius: var(--r-pill); transition: all 0.3s; backdrop-filter: blur(8px); }
      .chat-input:focus-within, .chat-input:hover { border-color: var(--p-400); background: rgba(255,255,255,0.08); }
      .chat-input .icon { width: 28px; height: 28px; border-radius: 50%; background: var(--grad-purple); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
      .chat-input .icon img { width: 16px; height: 16px; filter: brightness(0) invert(1); }
      .chat-input .text { flex: 1; min-width: 0; font-size: 15px; color: rgba(255,255,255,0.85); padding: 11px 0; }
      .chat-input .typed { color: var(--n-0); font-weight: 500; }
      .chat-input .cursor-blink { display: inline-block; width: 2px; height: 16px; background: var(--p-300); margin-left: 1px; vertical-align: -3px; animation: blink-c 1s steps(1) infinite; }
      @keyframes blink-c { 50% { opacity: 0; } }
      .chat-input .send-btn { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; background: var(--grad-ai); color: white; border: 0; cursor: pointer; font-size: 19px; flex-shrink: 0; box-shadow: 0 8px 24px rgba(106,0,244,0.45); transition: all 0.2s; text-decoration: none; }
      .chat-input .send-btn:hover { transform: scale(1.08); box-shadow: 0 12px 32px rgba(106,0,244,0.6); }

      .hint-pills { margin-top: 14px; display: flex; gap: 8px; flex-wrap: wrap; }
      .hint-pills .h { padding: 5px 11px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.12); border-radius: var(--r-pill); font-size: 12px; color: rgba(255,255,255,0.7); }

      /* ===== BUTTONS ===== */
      .cta-row { margin-top: 28px; display: flex; gap: 14px; flex-wrap: wrap; align-items: center; }
      .btn-primary { display: inline-flex; align-items: center; gap: 10px; padding: 17px 30px; background: var(--n-0); color: var(--n-900); border-radius: var(--r-pill); font-weight: 800; font-size: 15px; text-decoration: none; box-shadow: 0 16px 50px rgba(106,0,244,0.28); transition: all 0.25s cubic-bezier(0.22,1,0.36,1); }
      .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 24px 70px rgba(106,0,244,0.5); }
      .btn-primary::after { content: '→'; transition: transform 0.3s; }
      .btn-primary:hover::after { transform: translateX(4px); }
      .btn-ghost { display: inline-flex; align-items: center; gap: 10px; padding: 17px 26px; color: rgba(255,255,255,0.85); background: transparent; border: 1px solid rgba(255,255,255,0.2); border-radius: var(--r-pill); font-weight: 700; font-size: 15px; text-decoration: none; transition: all 0.25s; }
      .btn-ghost:hover { background: rgba(255,255,255,0.06); color: white; border-color: rgba(255,255,255,0.4); }

      .micro-text { margin-top: 14px; font-size: 13px; color: rgba(255,255,255,0.55); }
      .micro-text::before { content: '✓ '; color: var(--p-300); font-weight: 800; }

      /* ===== HERO PHONE ===== */
      .phone-stage { display: flex; justify-content: center; align-items: center; }
      .phone { width: 320px; max-width: 100%; aspect-ratio: 9/19; background: linear-gradient(160deg, #1a1a1d 0%, #0d0e10 100%); border-radius: 44px; padding: 8px; box-shadow: 0 40px 100px rgba(0,0,0,0.55), 0 0 80px rgba(106,0,244,0.25); border: 1.5px solid #2a2a2d; position: relative; transform: rotate(-2deg); animation: phone-breath 7s ease-in-out infinite; }
      @keyframes phone-breath { 50% { transform: rotate(-2deg) translateY(-6px); } }
      .phone-screen { width: 100%; height: 100%; border-radius: 36px; background: #0B141A; overflow: hidden; display: flex; flex-direction: column; position: relative; }
      .phone-notch { position: absolute; top: 8px; left: 50%; transform: translateX(-50%); width: 110px; height: 28px; background: black; border-radius: 16px; z-index: 10; }
      .wa-top { padding: 38px 14px 10px; background: #1F2C33; display: flex; align-items: center; gap: 10px; }
      .wa-top .av { width: 36px; height: 36px; border-radius: 50%; background: var(--grad-purple); display: flex; align-items: center; justify-content: center; }
      .wa-top .av img { width: 22px; height: 22px; filter: brightness(0) invert(1); }
      .wa-top .id .n { font-size: 14px; font-weight: 700; line-height: 1.1; }
      .wa-top .id .s { font-size: 11px; color: rgba(255,255,255,0.55); margin-top: 2px; display: flex; align-items: center; gap: 4px; }
      .wa-top .id .s::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--good); }
      .wa-body { flex: 1; padding: 14px 10px; display: flex; flex-direction: column; gap: 6px; background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="200" height="200"><defs><pattern id="p" patternUnits="userSpaceOnUse" width="40" height="40"><circle cx="20" cy="20" r="1" fill="rgba(255,255,255,0.04)"/></pattern></defs><rect width="100%" height="100%" fill="%230B141A"/><rect width="100%" height="100%" fill="url(%23p)"/></svg>'); }
      .b { max-width: 80%; padding: 7px 11px 5px; border-radius: 13px; font-size: 13px; line-height: 1.4; opacity: 0; transform: translateY(8px); animation: bub-in 0.45s cubic-bezier(0.22,1,0.36,1) forwards; }
      .b1 { animation-delay: 0.8s; }
      .b2 { animation-delay: 2s; }
      .b3 { animation-delay: 3.2s; }
      .b4 { animation-delay: 4.4s; }
      @keyframes bub-in { to { opacity: 1; transform: translateY(0); } }
      .b.bot { align-self: flex-start; background: #1F2C33; color: white; border-bottom-left-radius: 4px; }
      .b.usr { align-self: flex-end; background: #6A00F4; color: white; border-bottom-right-radius: 4px; }
      .b strong { font-weight: 700; }
      .b em { font-style: normal; color: var(--p-200); font-weight: 600; }
      .b .ts { display: block; margin-top: 3px; font-size: 9px; opacity: 0.55; text-align: right; }
      .b.usr .ts::after { content: ' ✓✓'; color: var(--p-200); }

      /* ===== DESIGN SYSTEM SHOWCASE ===== */
      .ds-section { padding: 100px 22px; max-width: 1280px; margin: 0 auto; }
      .section-h { text-align: center; max-width: 760px; margin: 0 auto 56px; }
      .section-h .pre { color: var(--p-300); }
      .section-h h2 { margin-top: 12px; }
      .section-h h2 em { font-style: normal; background: var(--grad-ai); -webkit-background-clip: text; background-clip: text; color: transparent; }

      .ds-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 18px; }
      .ds-card { padding: 28px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: var(--r-24); transition: all 0.3s; }
      .ds-card:hover { border-color: rgba(189,131,255,0.4); background: rgba(106,0,244,0.04); }
      .ds-card .ds-label { font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 800; color: var(--p-300); }
      .ds-card .ds-title { margin-top: 12px; font-weight: 700; font-size: 18px; }
      .ds-card .ds-body { margin-top: 10px; font-size: 13px; color: rgba(255,255,255,0.65); line-height: 1.5; }

      .colors-row { margin-top: 16px; display: flex; gap: 4px; flex-wrap: wrap; }
      .colors-row .swatch { width: 32px; height: 32px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1); flex-shrink: 0; }
      .typo-demo { margin-top: 16px; font-family: 'Inter', sans-serif; }
      .typo-demo .row { padding: 6px 0; border-bottom: 1px solid rgba(255,255,255,0.06); display: flex; justify-content: space-between; align-items: baseline; gap: 14px; }
      .typo-demo .row:last-child { border: 0; }
      .typo-demo .row .lab { color: rgba(255,255,255,0.55); font-size: 11px; }

      .spacing-demo { margin-top: 16px; display: flex; align-items: end; gap: 4px; }
      .spacing-demo .b { width: 12px; background: var(--grad-purple); border-radius: 4px; opacity: 1; transform: none; animation: none; flex: none; }
      .spacing-demo .lab { font-size: 10px; color: rgba(255,255,255,0.5); margin-top: 6px; text-align: center; min-width: 12px; }

      /* ===== SCROLLY ===== */
      .scrolly-shell { position: relative; }
      .scene { position: relative; min-height: 200vh; }
      .scene-pin { position: sticky; top: 0; height: 100vh; display: flex; align-items: center; justify-content: center; padding: 0 22px; overflow: hidden; }

      /* SCENE 1 · word reveal */
      .s1 .stage { max-width: 1100px; text-align: center; }
      .s1 .pre { color: var(--p-300); }
      .s1 .lines { font-weight: 800; font-size: clamp(34px, 6vw, 76px); letter-spacing: -0.04em; line-height: 1.05; margin-top: 28px; }
      .s1 .lines p { padding: 14px 0; }
      .s1 .lines p.dim { color: rgba(255,255,255,0.5); font-weight: 500; font-size: 0.7em; }
      .s1 .word { display: inline-block; opacity: 0; transform: translateY(30px); filter: blur(8px); transition: all 0.7s cubic-bezier(0.22,1,0.36,1); margin-right: 0.16em; }
      .s1 .word.show { opacity: 1; transform: translateY(0); filter: blur(0); }
      .s1 .word.accent { background: var(--grad-ai); -webkit-background-clip: text; background-clip: text; color: transparent; }

      /* SCENE 2 · SVG flow */
      .s2 .stage { max-width: 1100px; width: 100%; display: grid; grid-template-columns: 1fr; gap: 32px; align-items: center; }
      @media (min-width: 900px) { .s2 .stage { grid-template-columns: 1fr 1.2fr; gap: 50px; } }
      .s2 h2 em { font-style: normal; background: var(--grad-ai); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .s2 p.deck { margin-top: 18px; color: rgba(255,255,255,0.65); max-width: 480px; }
      .svg-stage { aspect-ratio: 1.1/1; max-width: 520px; margin: 0 auto; width: 100%; }
      .svg-flow path.line { stroke: var(--p-300); stroke-width: 2.5; fill: none; stroke-dasharray: 2200; stroke-dashoffset: 2200; transition: stroke-dashoffset 0.4s linear; filter: drop-shadow(0 0 8px var(--p-500)); }
      .svg-flow .node-circle { fill: var(--p-500); opacity: 0; transition: opacity 0.5s; }
      .svg-flow .node-pulse { fill: none; stroke: var(--p-300); stroke-width: 2; opacity: 0; transform-origin: center; transition: opacity 0.5s; }
      .svg-flow .node-circle.show { opacity: 1; }
      .svg-flow .node-pulse.show { opacity: 0.6; animation: pulse-svg 1.8s ease-out infinite; }
      @keyframes pulse-svg { 0% { transform: scale(1); opacity: 0.6; } 100% { transform: scale(2.4); opacity: 0; } }
      .svg-flow .label { fill: var(--n-0); font-family: 'Inter', sans-serif; font-weight: 700; font-size: 18px; opacity: 0; transition: opacity 0.5s; }
      .svg-flow .label.show { opacity: 1; }
      .svg-flow .emoji { font-size: 26px; opacity: 0; transition: opacity 0.5s; }
      .svg-flow .emoji.show { opacity: 1; }

      /* SCENE 3 */
      .s3 .stage { max-width: 1100px; text-align: center; }
      .s3 h2 { max-width: 720px; margin: 16px auto 56px; }
      .s3 .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 32px; }
      .s3 .stat .v { font-weight: 900; font-size: clamp(56px, 10vw, 120px); letter-spacing: -0.05em; line-height: 0.95; background: var(--grad-ai); -webkit-background-clip: text; background-clip: text; color: transparent; font-variant-numeric: tabular-nums; }
      .s3 .stat .l { margin-top: 10px; font-size: 13px; color: rgba(255,255,255,0.55); text-transform: uppercase; letter-spacing: 0.14em; font-weight: 700; }

      /* SCENE 4 */
      .s4 .stage { text-align: center; }
      .s4 h2 { font-weight: 900; font-size: clamp(72px, 18vw, 280px); letter-spacing: -0.055em; line-height: 0.85; }
      .s4 h2 em { font-style: italic; font-weight: 400; background: var(--grad-ai); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .s4 .deck { margin-top: 32px; font-size: clamp(17px, 2.4vw, 26px); color: rgba(255,255,255,0.7); max-width: 600px; margin-left: auto; margin-right: auto; font-weight: 500; }

      /* SCENE 5 */
      .s5 .stage { max-width: 920px; display: flex; flex-direction: column; align-items: center; }
      .s5 h2 em { font-style: normal; color: var(--p-300); }
      .chat-show { width: 100%; max-width: 540px; margin-top: 36px; padding: 22px; background: rgba(11,20,26,0.8); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.08); border-radius: var(--r-24); display: flex; flex-direction: column; gap: 10px; }
      .chat-show .b { max-width: 86%; padding: 10px 14px 8px; border-radius: 14px; font-size: 14px; line-height: 1.45; opacity: 1; transform: none; animation: none; }
      .chat-show .b.usr { background: var(--p-500); color: white; border-bottom-right-radius: 4px; align-self: flex-end; }
      .chat-show .b.bot { background: #1F2C33; color: white; border-bottom-left-radius: 4px; align-self: flex-start; }
      .chat-show .b strong { font-weight: 700; }
      .chat-show .b em { font-style: normal; color: var(--p-200); font-weight: 600; }
      .chat-show .ts { display: block; margin-top: 4px; font-size: 10px; opacity: 0.55; text-align: right; }
      .chat-show .ts.usr-ts::after { content: ' ✓✓'; color: var(--p-200); }

      /* SCENE 6 */
      .s6 .stage { max-width: 1100px; text-align: center; }
      .s6 h2 em { font-style: normal; color: var(--p-300); }
      .s6 .grid { margin-top: 48px; display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 16px; }
      .s6 .gi { padding: 24px 18px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: var(--r-16); transition: all 0.3s; }
      .s6 .gi:hover { transform: translateY(-4px); border-color: rgba(189,131,255,0.4); background: rgba(106,0,244,0.06); }
      .s6 .gi .ic { font-size: 36px; }
      .s6 .gi .n { margin-top: 12px; font-weight: 700; font-size: 16px; }

      /* SCENE 7 */
      .s7 .stage { max-width: 1280px; text-align: center; }
      .s7 h2 { font-weight: 900; font-size: clamp(48px, 9vw, 124px); letter-spacing: -0.055em; line-height: 0.92; }
      .s7 h2 em { font-style: normal; background: var(--grad-ai); -webkit-background-clip: text; background-clip: text; color: transparent; }
