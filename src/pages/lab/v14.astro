---
const title = 'Zymplo · Boot Terminal Lab · V14';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="https://sims.zymplo.com/brand/isotipo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap" />
    <style is:inline>
      :root { --bg: #000; --green: #00FF85; --amber: #FFB800; --turq: #14B8A6; --turq-light: #5EEAD4; --paper: #FAFBFF; --mute: #888; --pink: #FF6B9D; }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: 'JetBrains Mono', monospace; background: var(--bg); color: var(--green); min-height: 100vh; padding: 40px 24px 60px; line-height: 1.5; font-size: 14px; }
      body::before { content: ''; position: fixed; inset: 0; background-image: repeating-linear-gradient(0deg, rgba(0,255,133,0.03) 0px, rgba(0,255,133,0.03) 1px, transparent 1px, transparent 3px); pointer-events: none; z-index: 99; }
      body::after { content: ''; position: fixed; inset: 0; background: radial-gradient(ellipse 90% 70% at center, transparent 30%, rgba(0,0,0,0.7) 100%); pointer-events: none; z-index: 98; }

      .nav-back { position: fixed; top: 14px; left: 14px; z-index: 100; padding: 4px 10px 4px 6px; background: rgba(0,255,133,0.1); color: var(--green); border: 1px solid var(--green); font-size: 11px; font-weight: 700; text-decoration: none; display: flex; align-items: center; gap: 6px; }
      .nav-back img { height: 14px; }
      .lab-badge { position: fixed; top: 14px; right: 14px; z-index: 100; padding: 4px 10px; background: rgba(255,184,0,0.1); color: var(--amber); border: 1px solid var(--amber); font-size: 11px; font-weight: 700; text-decoration: none; }

      .term { max-width: 920px; margin: 0 auto; position: relative; z-index: 2; }
      .term-window { background: rgba(0,255,133,0.02); border: 1px solid rgba(0,255,133,0.3); }
      .term-bar { background: rgba(0,255,133,0.08); padding: 8px 14px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(0,255,133,0.2); font-size: 11px; color: var(--mute); }
      .term-bar .dots { display: flex; gap: 6px; }
      .term-bar .dots span { width: 10px; height: 10px; border-radius: 50%; background: var(--mute); }
      .term-bar .dots span:nth-child(1) { background: #FF5F57; }
      .term-bar .dots span:nth-child(2) { background: #FFBD2E; }
      .term-bar .dots span:nth-child(3) { background: #28C940; }
      .term-bar .title { color: var(--green); }
      .term-body { padding: 18px 22px; min-height: 60vh; }

      .line { display: block; white-space: pre-wrap; opacity: 0; animation: line-in 0.04s steps(1) forwards; }
      @keyframes line-in { to { opacity: 1; } }
      .line .prompt { color: var(--turq-light); }
      .line .arg { color: var(--amber); }
      .line .ok { color: var(--green); }
      .line .info { color: var(--paper); }
      .line .warn { color: var(--amber); }
      .line .err { color: var(--pink); }
      .line .h1 { font-weight: 700; color: var(--turq-light); }

      .ascii { color: var(--turq-light); font-size: 10px; line-height: 1.1; white-space: pre; margin: 8px 0; }
      .progress-bar { display: inline-block; }
      .progress-bar .fill { color: var(--green); }
      .progress-bar .empty { color: var(--mute); }

      .cursor { display: inline-block; width: 10px; height: 17px; background: var(--green); margin-left: 4px; vertical-align: middle; animation: blink 1.05s steps(1) infinite; }
      @keyframes blink { 50% { opacity: 0; } }

      .links-row { margin-top: 24px; padding: 14px 0; border-top: 1px solid rgba(0,255,133,0.2); display: flex; gap: 8px; flex-wrap: wrap; }
      .links-row a { color: var(--green); text-decoration: none; padding: 7px 14px; border: 1px solid var(--green); transition: all 0.15s; font-weight: 500; font-size: 13px; }
      .links-row a:hover { background: var(--green); color: var(--bg); }
      .links-row a.alt { color: var(--amber); border-color: var(--amber); }
      .links-row a.alt:hover { background: var(--amber); color: var(--bg); }

      .stats-block { margin-top: 18px; padding: 14px; border: 1px dashed rgba(0,255,133,0.3); }
      .stats-block .row { display: grid; grid-template-columns: 220px 1fr; gap: 14px; padding: 4px 0; font-size: 13px; }
      .stats-block .row .k { color: var(--mute); }
      .stats-block .row .v { color: var(--paper); font-weight: 700; }
      .stats-block .row .v.ok { color: var(--green); }

      .footer { padding: 24px 0 0; text-align: center; font-size: 11px; color: var(--mute); border-top: 1px solid rgba(0,255,133,0.15); margin-top: 24px; }
      .footer a { color: var(--green); text-decoration: none; margin: 0 8px; }
    </style>
  </head>
  <body>
    <a class="nav-back" href="/lab/"><img src="https://sims.zymplo.com/brand/isotipo.svg" alt="Zymplo" />← LAB</a>
    <a class="lab-badge" href="/lab/">14 · BOOT</a>

    <div class="term">
      <div class="term-window">
        <div class="term-bar">
          <div class="dots"><span></span><span></span><span></span></div>
          <div class="title">zymplo@cloud:~/v14_boot</div>
          <div>5/5/26 · 00:42</div>
        </div>
        <div class="term-body" id="term"></div>
      </div>

      <div class="links-row">
        <a href="https://wa.me/595981970735?text=Quiero%20probar%20Zymplo">$ ./empezar.sh</a>
        <a class="alt" href="#stats">$ cat stats.log</a>
        <a class="alt" href="/lab/">$ cd ../lab</a>
      </div>

      <footer class="footer">© 2026 zymplo · /lab/v14_boot · <a href="/lab/">Lab</a> · <a href="/">Landing</a> · <a href="/lab/v15/">V15 →</a></footer>
    </div>

    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const term = document.getElementById('term');
      const lines = [
        ['line', '<span class="prompt">$</span> <span class="arg">init</span> zymplo://secretary --mode=whatsapp --plan=free'],
        ['line', '<span class="info">[ OK ]</span> bootstrapping zymplo runtime v9.2.0'],
        ['line', '<span class="info">[ OK ]</span> connecting to whatsapp api...... <span class="ok">connected</span>'],
        ['line', '<span class="info">[ OK ]</span> loading 170 ai agents.......... <span class="ok">ready</span>'],
        ['line', '<span class="info">[ OK ]</span> scanning 13 countries........... <span class="ok">PT · ES · EN</span>'],
        ['line', '<span class="info">[ OK ]</span> verifying brand v2............... <span class="ok">on-spec</span>'],
        ['line', ''],
        ['ascii', `   ███████╗██╗   ██╗███╗   ███╗██████╗ ██╗      ██████╗
   ╚══███╔╝╚██╗ ██╔╝████╗ ████║██╔══██╗██║     ██╔═══██╗
     ███╔╝  ╚████╔╝ ██╔████╔██║██████╔╝██║     ██║   ██║
    ███╔╝    ╚██╔╝  ██║╚██╔╝██║██╔═══╝ ██║     ██║   ██║
   ███████╗   ██║   ██║ ╚═╝ ██║██║     ███████╗╚██████╔╝
   ╚══════╝   ╚═╝   ╚═╝     ╚═╝╚═╝     ╚══════╝ ╚═════╝
                          /v14 · boot · 2026`],
        ['line', ''],
        ['line', '<span class="h1">> Zymplo · tu secretaria IA en WhatsApp</span>'],
        ['line', '<span class="info">> cobra · factura · agenda · organiza · sin app · sin signup</span>'],
        ['line', ''],
        ['line', '<span class="prompt">$</span> <span class="arg">cat</span> features.txt'],
        ['line', '<span class="ok">[01]</span> cobra sin perseguir · detecta vencidas, manda calientes, te avisa cuando entró'],
        ['line', '<span class="ok">[02]</span> facturá hablando · NFS-e · CFDI · DIAN · AFIP · DGT'],
        ['line', '<span class="ok">[03]</span> agenda en tu cabeza · "recordame mañana 9" → llega el aviso'],
        ['line', '<span class="ok">[04]</span> resumen live · "¿cómo voy?" → entró/falta/gastaste, en segundos'],
        ['line', ''],
        ['line', '<span class="prompt">$</span> <span class="arg">tail</span> -f live.log'],
        ['live'],
        ['line', ''],
        ['line', '<span class="prompt">$</span> <span class="arg">cat</span> stats.json'],
        ['stats'],
        ['line', ''],
        ['line', '<span class="warn">> ready to start? press [enter] o</span>'],
        ['line', '<span class="prompt">$</span> <span class="arg">./empezar.sh</span> --plan=free --whatsapp <span class="ok">→ click acá ↓</span>'],
        ['cursor'],
      ];

      const liveTickers = [
        '<span class="info">[live]</span> <span class="info">diego.SP</span> cobró ₲ 850k · 12s ago',
        '<span class="info">[live]</span> <span class="info">luana.BH</span> emitió NFS-e R$ 320 · 24s ago',
        '<span class="info">[live]</span> <span class="info">maría.CDMX</span> programó 3 reminders · 38s ago',
        '<span class="info">[live]</span> <span class="info">john.MIA</span> charged $ 320 USD · 1m ago',
        '<span class="info">[live]</span> <span class="info">sofía.LIM</span> cobró S/ 180 · 2m ago',
      ];

      const statsLines = [
        '{',
        '  <span class="info">"cobrado_mes"</span>: <span class="ok">"$ 47.28M"</span>,',
        '  <span class="info">"usuarios"</span>: <span class="ok">12847</span>,',
        '  <span class="info">"paises"</span>: <span class="ok">13</span>,',
        '  <span class="info">"sumados_hoy"</span>: <span class="ok">847</span>,',
        '  <span class="info">"status"</span>: <span class="ok">"live"</span>',
        '}',
      ];

      let i = 0;
      function next() {
        if (i >= lines.length) return;
        const [type, content] = lines[i];
        i++;
        if (type === 'line') {
          const el = document.createElement('span');
          el.className = 'line';
          el.innerHTML = (content || '&nbsp;') + '\n';
          term.appendChild(el);
          window.scrollTo(0, document.body.scrollHeight);
          setTimeout(next, reduceMotion ? 0 : (content === '' ? 60 : 90));
        } else if (type === 'ascii') {
          const el = document.createElement('span');
          el.className = 'ascii';
          el.textContent = content;
          term.appendChild(el);
          setTimeout(next, reduceMotion ? 0 : 240);
        } else if (type === 'live') {
          liveTickers.forEach((tk, idx) => {
            setTimeout(() => {
              const el = document.createElement('span');
              el.className = 'line';
              el.innerHTML = tk + '\n';
              term.appendChild(el);
              window.scrollTo(0, document.body.scrollHeight);
            }, reduceMotion ? 0 : idx * 80);
          });
          setTimeout(next, reduceMotion ? 0 : liveTickers.length * 80 + 80);
        } else if (type === 'stats') {
          statsLines.forEach((tk, idx) => {
            setTimeout(() => {
              const el = document.createElement('span');
              el.className = 'line';
              el.innerHTML = tk + '\n';
              term.appendChild(el);
              window.scrollTo(0, document.body.scrollHeight);
            }, reduceMotion ? 0 : idx * 60);
          });
          setTimeout(next, reduceMotion ? 0 : statsLines.length * 60 + 80);
        } else if (type === 'cursor') {
          const el = document.createElement('span');
          el.className = 'cursor';
          term.appendChild(el);
        }
      }
      next();
    </script>
  </body>
</html>
