            <li><a href="/legal/delete-account/">Eliminar cuenta</a></li>
          </ul>
        </div>
      </div>
      <div class="ft-bottom">
        <span>© 2026 Zymplo Inc. · Todos los derechos reservados.</span>
        <span class="country">🌍 Global · 13 países · 1 mismo bot</span>
      </div>
    </footer>

    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const $ = (s, c=document) => c.querySelector(s);
      const $$ = (s, c=document) => [...c.querySelectorAll(s)];

      // PROGRESS
      const prog = $('#prog');
      function onScroll() {
        const sy = window.scrollY;
        const sh = document.documentElement.scrollHeight - window.innerHeight;
        prog.style.width = Math.min(100, Math.max(0, sy / sh * 100)) + '%';
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // LIVE TICKER · update times
      function updateTickerTimes() {
        const stage = $('#liveTickerStage');
        if (!stage) return;
        const ages = ['hace 14s', 'hace 28s', 'hace 42s', 'hace 1m', 'hace 1m 8s'];
        stage.querySelectorAll('.ago').forEach((el, i) => { el.textContent = ages[i]; });
      }
      setInterval(updateTickerTimes, 4000);

      // QUIZ
      const quizState = { 1: 0, 2: 0, 3: 0 };
      $$('.quiz-q .opt').forEach(b => {
        b.addEventListener('click', () => {
          const q = b.parentElement.parentElement.dataset.q;
          quizState[q] = parseInt(b.dataset.v);
          b.parentElement.querySelectorAll('.opt').forEach(o => o.classList.remove('sel'));
          b.classList.add('sel');
          if (quizState[1] && quizState[2] && quizState[3]) {
            const total = (quizState[1] + quizState[2] + quizState[3]) / 12 * 100;
            const score = Math.round(total);
            $('#scoreNum').textContent = score + '%';
            const label = score >= 75 ? 'Match perfecto · Zymplo te ahorra horas cada semana' : score >= 50 ? 'Buen match · Zymplo te organiza el caos' : score >= 25 ? 'Plan Free es para vos · empezás sin pagar' : 'Empezás gratis · sin compromiso · cancelas cuando querés';
            $('#scoreLabel').textContent = label;
            $('#quizResult').classList.add('show');
          }
        });
      });

      // INTERACTIVE DEMO
      const live = $('#livechat'); const lin = $('#liveInput'); const lsend = $('#liveSend');
      function addBub(side, html) {
        const b = document.createElement('div'); b.className = 'b ' + side;
        b.innerHTML = html + '<span class="ts">ahora</span>';
        live.appendChild(b); live.scrollTop = live.scrollHeight;
      }
      function showTyping() {
        const tp = document.createElement('div'); tp.className = 'typing-dots'; tp.innerHTML = '<span></span><span></span><span></span>';
        live.appendChild(tp); live.scrollTop = live.scrollHeight; return tp;
      }
      function reply(msg) {
        const m = msg.toLowerCase();
        if (/(cu[aá]nto.*entr|resumen|d[ií]a|hoy|este mes|faturament)/.test(m)) {
          return ['📊 Hoy entraron <strong>€1.240 ✨</strong>', 'Pendientes: <em>€680</em> (3 clientes)', '¿Quieres que les mande recordatorio?'];
        }
        if (/(cobrar?|cobran)/.test(m)) {
          const monto = m.match(/(\d{2,})/);
          const a = m.match(/(?:cobrar?\s+a?\s+|para\s+)([a-zà-ÿ]+)/i);
          return [
            '💸 Cobro listo para <strong>' + (a ? a[1] : 'tu cliente') + '</strong>' + (monto ? ' · <em>€' + monto[1] + '</em>' : ''),
            'Mando un mensaje cordial · con link Bizum/SEPA anexado. <strong>¿Lo envío?</strong>',
          ];
        }
        if (/(agend|reservar|amana|amanha|mañana)/.test(m)) {
          return ['📅 Turno agendado · te aviso cuando se acerque.', '¿Quieres añadir más detalles?'];
        }
        if (/(qui[eé]n.*no.*pag|inadimplent|debe|moros)/.test(m)) {
          return ['⚠️ <strong>3 clientes</strong> aún no te pagaron:', '· Juan · €200<br/>· Ana · €150<br/>· Marcos · €420', '¿Les envío recordatorio ahora?'];
        }
        return ['Buenísimo · te ayudo. Prueba:<br/>· <em>cobrar a Juan 200</em><br/>· <em>¿cuánto entró hoy?</em><br/>· <em>¿quién no me pagó?</em><br/>· <em>resumen del día</em>'];
      }
      function userSend(msg) {
        if (!msg.trim()) return;
        addBub('usr', msg); lin.value = '';
        const tp = showTyping();
        const responses = reply(msg);
        responses.forEach((r, i) => { setTimeout(() => { if (i === 0) tp.remove(); addBub('bot', r); }, reduceMotion ? 0 : 700 + i * 950); });
      }
      lsend && lsend.addEventListener('click', () => userSend(lin.value));
      lin && lin.addEventListener('keydown', (e) => { if (e.key === 'Enter') userSend(lin.value); });
      $$('.qp').forEach((b) => b.addEventListener('click', () => userSend(b.dataset.prompt)));
    </script>
  </body>
</html>
