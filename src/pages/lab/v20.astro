---
const title = 'Zymplo · Todo tu trabajo. Más simple. En WhatsApp.';
const description = 'Cobra, agenda clientes, responde consultas y organiza todo hablando. Sin instalar nada. Sin aprender nada nuevo. Zymplo se encarga. Tú recuperas tu tiempo.';
const ogImage = 'https://sims.zymplo.com/web/v20-assets/hero-latam.webp';
const A = 'https://sims.zymplo.com/web/v20-assets';
const WA = 'https://wa.me/595981970735?text=%C2%A1Hola!%20Quiero%20empezar%20con%20Zymplo';
const ISO = 'https://sims.zymplo.com/brand/isotipo.svg';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#14B8A6" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={ISO} />
    <link rel="apple-touch-icon" href="https://sims.zymplo.com/brand/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Sora:wght@500;700;800;900&display=swap" />
    <link rel="preload" as="image" href={`${A}/hero-latam.webp`} fetchpriority="high" />

    <style is:inline>
      :root {
        --bg: #0A0B14; --bg-2: #11141F;
        --paper: #FAFBFF; --ink: #0A0B14;
        --turq: #14B8A6; --turq-deep: #0F9488; --turq-light: #5EEAD4; --turq-paler: #CCFBF1;
        --good: #22C55E; --warm: #F59E0B; --hot: #FB923C; --purple: #623AE6; --azul: #1E4AD4;
        --grad-zy: linear-gradient(115deg, #14B8A6 0%, #5EEAD4 50%, #CCFBF1 100%);
        --grad-cta: linear-gradient(135deg, #14B8A6 0%, #0F9488 100%);
        --grad-hero: linear-gradient(135deg, #14B8A6 0%, #0F9488 60%, #1E4AD4 100%);
        --grad-glow: radial-gradient(circle, rgba(20,184,166,0.45) 0%, transparent 70%);
        --grad-viral: linear-gradient(90deg, var(--purple) 0%, var(--turq) 50%, var(--azul) 100%);
        --r-pill: 999px; --r-24: 24px; --r-16: 16px; --r-12: 12px;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body { font-family: 'Inter', system-ui, sans-serif; background: var(--bg); color: var(--paper); min-height: 100vh; -webkit-font-smoothing: antialiased; line-height: 1.5; overflow-x: hidden; }
      img { max-width: 100%; display: block; }

      .display-l { font-family: 'Sora', sans-serif; font-weight: 800; font-size: clamp(40px, 7vw, 80px); letter-spacing: -0.04em; line-height: 1; }
      .h1 { font-family: 'Sora', sans-serif; font-weight: 800; font-size: clamp(34px, 5vw, 56px); letter-spacing: -0.035em; line-height: 1.1; }
      .h2 { font-family: 'Sora', sans-serif; font-weight: 800; font-size: clamp(28px, 4vw, 44px); letter-spacing: -0.03em; line-height: 1.15; }
      .micro { font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 700; }

      /* PROGRESS + NAV BACK */
      .progress { position: fixed; top: 0; left: 0; height: 3px; background: var(--grad-zy); z-index: 999; width: 0%; transition: width 0.05s linear; box-shadow: 0 0 8px var(--turq-light); }
      .nav-back { position: fixed; top: 14px; left: 14px; z-index: 100; padding: 6px 12px 6px 6px; background: rgba(255,255,255,0.05); backdrop-filter: blur(20px) saturate(160%); border: 1px solid rgba(255,255,255,0.12); border-radius: var(--r-pill); font-size: 12px; font-weight: 700; color: var(--paper); text-decoration: none; display: flex; align-items: center; gap: 6px; }
      .nav-back img { height: 18px; }
      .lab-badge { position: fixed; top: 14px; right: 14px; z-index: 100; padding: 6px 12px; background: rgba(20,184,166,0.18); backdrop-filter: blur(20px); border: 1px solid rgba(94,234,212,0.4); border-radius: var(--r-pill); font-size: 11px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--turq-light); text-decoration: none; }

      /* TOP BANNER */
      .top-banner { position: relative; z-index: 5; padding: 10px 22px; background: rgba(0,0,0,0.4); backdrop-filter: blur(10px); border-bottom: 1px solid rgba(255,255,255,0.08); text-align: center; font-size: 13px; font-weight: 500; color: var(--paper); }
      .top-banner .pulse { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--good); margin-right: 8px; vertical-align: middle; animation: pulse-d 1.5s ease-in-out infinite; box-shadow: 0 0 8px var(--good); }
      @keyframes pulse-d { 0%,100% { box-shadow: 0 0 0 0 rgba(34,197,94,0.7); } 70% { box-shadow: 0 0 0 8px rgba(34,197,94,0); } }
      .top-banner strong { color: var(--turq-light); font-weight: 800; }

      /* HERO · turquesa cinematic with mesh */
      .hero { position: relative; min-height: 100vh; padding: 90px 22px 60px; max-width: 1280px; margin: 0 auto; display: flex; flex-direction: column; justify-content: center; background: var(--grad-hero); }
      .hero { background: transparent; }
      body.hero-bg-active { background: var(--grad-hero); }
      .hero-bg-fixed { position: fixed; inset: 0; z-index: -1; background: var(--grad-hero); pointer-events: none; }
      .hero-bg-fixed::before { content: ''; position: absolute; top: -10%; right: -10%; width: 80vw; height: 80vw; background: radial-gradient(ellipse 80% 60% at 20% 20%, rgba(94,234,212,0.35) 0%, transparent 60%); animation: float-x 20s ease-in-out infinite; }
      .hero-bg-fixed::after { content: ''; position: absolute; bottom: -10%; left: -10%; width: 70vw; height: 70vw; background: radial-gradient(ellipse 70% 50% at 80% 75%, rgba(30,74,212,0.3) 0%, transparent 65%); animation: float-y 24s ease-in-out infinite; }
      @keyframes float-x { 50% { transform: translate(40px, -30px); } }
      @keyframes float-y { 50% { transform: translate(-40px, 30px); } }

      .hero-grid { position: relative; z-index: 2; display: grid; grid-template-columns: 1fr; gap: 40px; align-items: center; }
      @media (min-width: 1024px) { .hero-grid { grid-template-columns: 1.1fr 1fr; gap: 64px; } }

      .countries-strip { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 11px; font-weight: 800; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.85); }
      .countries-strip .flags { font-size: 18px; letter-spacing: 0.04em; }

      h1.hero-h { margin-top: 18px; color: white; text-shadow: 0 2px 24px rgba(0,0,0,0.18); }
      h1.hero-h em { font-style: normal; color: var(--turq-paler); }
      .hero-sub { margin-top: 22px; color: rgba(255,255,255,0.92); max-width: 560px; font-size: clamp(15px, 1.95vw, 19px); line-height: 1.55; font-weight: 500; }

      /* CTAs hero */
      .cta-row { margin-top: 32px; display: flex; gap: 14px; flex-wrap: wrap; align-items: center; }
      .btn-primary { display: inline-flex; align-items: center; gap: 10px; padding: 17px 30px; background: var(--paper); color: var(--ink); border-radius: var(--r-pill); font-weight: 800; font-size: 16px; text-decoration: none; box-shadow: 0 16px 50px rgba(0,0,0,0.25); transition: all 0.25s cubic-bezier(0.22,1,0.36,1); }
      .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 24px 70px rgba(0,0,0,0.4); }
      .btn-primary::after { content: '→'; transition: transform 0.3s; }
      .btn-primary:hover::after { transform: translateX(4px); }
      .btn-ghost { display: inline-flex; align-items: center; gap: 10px; padding: 17px 26px; color: white; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.25); border-radius: var(--r-pill); font-weight: 700; font-size: 15px; text-decoration: none; backdrop-filter: blur(10px); transition: all 0.25s; }
      .btn-ghost:hover { background: rgba(255,255,255,0.16); border-color: rgba(255,255,255,0.5); }

      .micro-text { margin-top: 14px; display: flex; gap: 18px; flex-wrap: wrap; font-size: 13px; color: rgba(255,255,255,0.85); }
      .micro-text span { display: inline-flex; align-items: center; gap: 6px; }
      .micro-text span::before { content: '✓'; color: var(--good); font-weight: 800; }

      /* HERO image phone composite */
      .hero-img-wrap { position: relative; aspect-ratio: 4/5; max-width: 460px; margin: 0 auto; border-radius: 28px; overflow: hidden; box-shadow: 0 40px 100px rgba(0,0,0,0.55), 0 0 80px rgba(20,184,166,0.18); transform: rotate(-1deg); animation: img-breath 7s ease-in-out infinite; }
      @keyframes img-breath { 50% { transform: rotate(-1deg) translateY(-6px); } }
      .hero-img-wrap img { width: 100%; height: 100%; object-fit: cover; }
      .hero-img-wrap::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 50%, rgba(10,11,20,0.6) 100%); pointer-events: none; }
      .hero-feature-bubble { position: absolute; padding: 12px 16px; background: rgba(11,20,26,0.85); backdrop-filter: blur(20px); border: 1px solid rgba(94,234,212,0.4); border-radius: 14px; font-size: 12.5px; line-height: 1.35; color: white; box-shadow: 0 12px 32px rgba(0,0,0,0.4); opacity: 0; animation: bubble-pop 0.8s cubic-bezier(0.22,1,0.36,1) forwards; }
      .hero-feature-bubble strong { display: block; color: var(--turq-light); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 3px; font-weight: 800; }
      .hero-feature-bubble .ic { font-size: 18px; vertical-align: middle; margin-right: 4px; }
      .hfb-1 { top: 14px; right: 14px; max-width: 200px; animation-delay: 1.0s; }
      .hfb-2 { bottom: 18%; left: 14px; max-width: 220px; animation-delay: 1.6s; }
      .hfb-3 { top: 38%; right: 0%; max-width: 200px; animation-delay: 2.2s; }
      .hfb-4 { bottom: 14px; right: 14px; max-width: 220px; animation-delay: 2.8s; }
      @keyframes bubble-pop { from { opacity: 0; transform: translateY(8px) scale(0.96); } to { opacity: 1; transform: translateY(0) scale(1); } }

      /* HERO stats footer line */
      .hero-stats { margin-top: 36px; display: flex; gap: 28px; flex-wrap: wrap; font-size: 13px; color: rgba(255,255,255,0.8); }
      .hero-stats .v { font-family: 'Sora', sans-serif; font-weight: 800; font-size: 18px; color: white; }

      /* MARQUEE TRUST BAR */
      .trust-bar { background: white; color: var(--ink); padding: 14px 0; overflow: hidden; white-space: nowrap; border-top: 1px solid rgba(0,0,0,0.06); border-bottom: 1px solid rgba(0,0,0,0.06); }
      .trust-bar .track { display: inline-block; animation: scroll-l 36s linear infinite; }
      .trust-bar span.item { padding: 0 22px; font-weight: 600; font-size: 14px; }
      @keyframes scroll-l { from { transform: translateX(0); } to { transform: translateX(-50%); } }

      /* LIVE ACTIVITY TICKER */
      .live-ticker { padding: 56px 22px; max-width: 1280px; margin: 0 auto; }
      .live-ticker .head { text-align: center; margin-bottom: 28px; }
      .live-ticker .head .pre { color: var(--turq-light); }
      .live-ticker .head h2 em { font-style: normal; background: var(--grad-zy); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .live-ticker .stage { padding: 22px; background: rgba(20,184,166,0.06); border: 1px solid rgba(94,234,212,0.25); border-radius: var(--r-24); }
      .live-event { padding: 14px 0; border-bottom: 1px dashed rgba(255,255,255,0.08); display: grid; grid-template-columns: 32px 1fr auto; gap: 12px; align-items: center; transition: opacity 0.4s; }
      .live-event:last-child { border-bottom: 0; }
      .live-event .ic { width: 32px; height: 32px; border-radius: 50%; background: var(--grad-cta); display: flex; align-items: center; justify-content: center; font-size: 14px; flex-shrink: 0; }
      .live-event .body .name { font-weight: 700; font-size: 14px; }
      .live-event .body .what { font-size: 12.5px; color: rgba(255,255,255,0.65); margin-top: 2px; }
      .live-event .ago { font-size: 11px; color: rgba(94,234,212,0.85); font-weight: 600; }

      /* PAYMENTS STRIP */
      .pay-strip { background: var(--bg); padding: 28px 22px; border-top: 1px solid rgba(255,255,255,0.06); border-bottom: 1px solid rgba(255,255,255,0.06); }
      .pay-strip .inner { max-width: 1280px; margin: 0 auto; display: flex; align-items: center; justify-content: center; gap: 28px; flex-wrap: wrap; }
      .pay-strip .label { font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 700; color: rgba(255,255,255,0.55); }
      .pay-strip .methods { display: flex; gap: 14px; flex-wrap: wrap; align-items: center; }
      .pay-strip .pm { padding: 6px 14px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); border-radius: var(--r-pill); font-size: 13px; font-weight: 700; color: white; }

      /* SECTION SHARED */
      .section-h { text-align: center; max-width: 760px; margin: 0 auto 48px; }
      .section-h .pre { color: var(--turq-light); }
      .section-h h2 em { font-style: normal; background: var(--grad-zy); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .section-h p { margin-top: 16px; font-size: 17px; color: rgba(255,255,255,0.7); }

      /* FEATURES GRID */
      .features-section { padding: 96px 22px; max-width: 1280px; margin: 0 auto; }
      .features-grid { display: grid; grid-template-columns: 1fr; gap: 18px; }
      @media (min-width: 768px) { .features-grid { grid-template-columns: repeat(2, 1fr); } }
      @media (min-width: 1100px) { .features-grid { grid-template-columns: repeat(4, 1fr); } }
      .feat-card { padding: 32px 28px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: var(--r-24); transition: all 0.4s; }
      .feat-card:hover { transform: translateY(-4px); border-color: rgba(94,234,212,0.4); background: rgba(20,184,166,0.05); }
      .feat-card .ic { width: 52px; height: 52px; border-radius: var(--r-16); background: var(--grad-cta); display: flex; align-items: center; justify-content: center; font-size: 24px; }
      .feat-card .t { font-family: 'Sora', sans-serif; font-weight: 800; font-size: 18px; letter-spacing: -0.02em; margin-top: 18px; }
      .feat-card .d { margin-top: 8px; color: rgba(255,255,255,0.65); font-size: 14px; line-height: 1.55; }

      /* VS COMPETITORS TABLE */
      .vs-section { padding: 96px 22px; max-width: 1280px; margin: 0 auto; border-top: 1px solid rgba(255,255,255,0.05); }
      .vs-table { overflow-x: auto; -webkit-overflow-scrolling: touch; border-radius: var(--r-24); border: 1px solid rgba(255,255,255,0.08); }
      .vs-table table { width: 100%; min-width: 720px; border-collapse: collapse; }
      .vs-table th, .vs-table td { padding: 16px 20px; text-align: left; border-bottom: 1px solid rgba(255,255,255,0.06); font-size: 14px; }
      .vs-table thead th { background: rgba(255,255,255,0.03); font-weight: 700; font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(255,255,255,0.65); }
      .vs-table thead th.zy { color: var(--turq-light); background: rgba(20,184,166,0.1); }
      .vs-table tbody td { color: rgba(255,255,255,0.85); }
      .vs-table tbody td.zy { background: rgba(20,184,166,0.05); }
      .vs-table .check { color: var(--good); font-size: 16px; font-weight: 800; }
      .vs-table .x { color: rgba(255,255,255,0.3); font-size: 16px; }
      .vs-disclaimer { margin-top: 20px; font-size: 11px; color: rgba(255,255,255,0.4); text-align: center; line-height: 1.5; }

      /* ZYMPLO CHALLENGE */
      .challenge { padding: 60px 22px; background: var(--grad-viral); }
      .challenge .inner { max-width: 1100px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 22px; flex-wrap: wrap; }
      .challenge .left { flex: 1; min-width: 260px; }
      .challenge .pre { font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.85); font-weight: 800; }
      .challenge h2 { margin-top: 8px; font-family: 'Sora', sans-serif; font-weight: 900; font-size: clamp(28px, 4.5vw, 48px); letter-spacing: -0.04em; line-height: 1; color: white; }
      .challenge .prize { margin-top: 6px; font-size: 17px; color: rgba(255,255,255,0.9); }
      .challenge .ctas { display: flex; gap: 10px; flex-wrap: wrap; }
      .challenge .ctas a { display: inline-flex; align-items: center; gap: 8px; padding: 12px 20px; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.25); color: white; border-radius: var(--r-pill); font-weight: 700; font-size: 14px; text-decoration: none; backdrop-filter: blur(10px); transition: all 0.2s; }
      .challenge .ctas a:hover { background: rgba(0,0,0,0.5); transform: translateY(-2px); }

      /* 100+ TOOLS MARQUEE */
      .tools { padding: 96px 22px; max-width: 1280px; margin: 0 auto; border-top: 1px solid rgba(255,255,255,0.05); }
      .tools-marquee { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: var(--r-24); padding: 18px 0; overflow: hidden; white-space: nowrap; }
      .tools-marquee .track { display: inline-block; animation: scroll-l 60s linear infinite; }
      .tools-marquee .track + .track { animation-direction: reverse; }
      .tools-marquee span.tool { display: inline-block; padding: 8px 14px; margin: 0 4px; background: rgba(20,184,166,0.08); border: 1px solid rgba(94,234,212,0.2); border-radius: var(--r-pill); font-size: 13px; font-weight: 600; color: var(--paper); }
      .tools-marquee .row { padding: 4px 0; }

      /* SCORE QUIZ */
      .score-quiz { padding: 96px 22px; max-width: 720px; margin: 0 auto; border-top: 1px solid rgba(255,255,255,0.05); }
      .score-quiz .head { text-align: center; }
      .score-quiz .pre { color: var(--turq-light); }
      .quiz-card { margin-top: 36px; padding: 32px 28px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: var(--r-24); }
      .quiz-q { padding: 14px 0; border-bottom: 1px solid rgba(255,255,255,0.06); }
      .quiz-q:last-child { border-bottom: 0; }
      .quiz-q .label { font-weight: 700; font-size: 14px; margin-bottom: 10px; }
      .quiz-q .opts { display: flex; gap: 8px; flex-wrap: wrap; }
      .quiz-q .opt { padding: 8px 14px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.12); color: white; border-radius: var(--r-pill); font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.2s; font-family: inherit; }
      .quiz-q .opt:hover, .quiz-q .opt.sel { background: rgba(20,184,166,0.16); border-color: var(--turq-light); color: var(--turq-light); }
      .quiz-result { margin-top: 22px; padding: 18px; background: rgba(20,184,166,0.1); border: 1px solid rgba(94,234,212,0.4); border-radius: var(--r-16); text-align: center; display: none; }
      .quiz-result.show { display: block; }
      .quiz-result .score-num { font-family: 'Sora', sans-serif; font-weight: 900; font-size: 56px; line-height: 1; background: var(--grad-zy); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .quiz-result .score-label { margin-top: 6px; font-size: 13px; color: rgba(255,255,255,0.85); }
      .quiz-cta { margin-top: 18px; display: inline-block; padding: 12px 22px; background: var(--paper); color: var(--ink); border-radius: var(--r-pill); font-weight: 800; font-size: 14px; text-decoration: none; cursor: pointer; }

      /* TESTIMONIOS · DALL-E + España */
      .test-section { padding: 96px 22px; max-width: 1280px; margin: 0 auto; border-top: 1px solid rgba(255,255,255,0.05); }
      .test-grid { display: grid; grid-template-columns: 1fr; gap: 18px; }
      @media (min-width: 700px) { .test-grid { grid-template-columns: repeat(2, 1fr); } }
      @media (min-width: 1100px) { .test-grid { grid-template-columns: repeat(5, 1fr); } }
      .test-card { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: var(--r-24); overflow: hidden; transition: all 0.3s; cursor: pointer; }
      .test-card:hover { transform: translateY(-4px); border-color: rgba(94,234,212,0.4); box-shadow: 0 24px 60px rgba(0,0,0,0.5); }
      .test-card .img-wrap { aspect-ratio: 1; position: relative; overflow: hidden; }
      .test-card .img-wrap img { width: 100%; height: 100%; object-fit: cover; }
      .test-card .img-wrap::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 50%, rgba(10,11,20,0.7) 100%); }
      .test-card .img-wrap .duration { position: absolute; top: 10px; right: 10px; padding: 4px 10px; background: rgba(0,0,0,0.7); border-radius: var(--r-pill); font-size: 11px; font-weight: 700; backdrop-filter: blur(10px); }
      .test-card .img-wrap .play { position: absolute; bottom: 12px; left: 12px; width: 36px; height: 36px; border-radius: 50%; background: white; color: var(--ink); display: flex; align-items: center; justify-content: center; font-size: 14px; }
      .test-card .body { padding: 18px; }
      .test-card .name { font-family: 'Sora', sans-serif; font-weight: 800; font-size: 16px; }
      .test-card .role { font-size: 12.5px; color: rgba(255,255,255,0.55); margin-top: 2px; }
      .test-card .quote { margin-top: 12px; font-style: italic; font-size: 14px; line-height: 1.45; color: rgba(255,255,255,0.92); }
      .test-card .gain { margin-top: 12px; padding: 6px 12px; background: rgba(34,197,94,0.16); border: 1px solid rgba(34,197,94,0.4); border-radius: var(--r-pill); display: inline-block; font-size: 12px; font-weight: 800; color: var(--good); }
