      .faq-item summary::-webkit-details-marker { display: none; }
      .faq-item summary::after { content: '+'; font-size: 24px; font-weight: 400; color: var(--turq-light); transition: transform 0.3s; }
      .faq-item[open] summary::after { transform: rotate(45deg); }
      .faq-item .ans { padding: 0 22px 18px; color: rgba(255,255,255,0.7); font-size: 15px; line-height: 1.6; }

      /* FINAL */
      .final { padding: 140px 22px 100px; text-align: center; position: relative; overflow: hidden; }
      .final::before { content: ''; position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 80vw; height: 60vh; background: radial-gradient(ellipse 80% 80% at center, rgba(20,184,166,0.25) 0%, transparent 70%); pointer-events: none; }
      .final-img { position: relative; max-width: 760px; margin: 0 auto 48px; aspect-ratio: 16/9; border-radius: var(--r-24); overflow: hidden; box-shadow: 0 40px 100px rgba(0,0,0,0.55), 0 0 80px rgba(20,184,166,0.2); }
