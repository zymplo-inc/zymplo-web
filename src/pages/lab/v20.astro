      /* FAQ */
      .faq { padding: 100px 22px; max-width: 880px; margin: 0 auto; }
      .faq-list { display: flex; flex-direction: column; gap: 8px; }
      .faq-item { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: var(--r-16); overflow: hidden; transition: border-color 0.2s; }
