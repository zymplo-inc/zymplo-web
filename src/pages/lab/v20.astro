      .pcard .badge-pro { position: absolute; top: -12px; right: 28px; padding: 4px 12px; background: var(--grad-zy); color: var(--ink); border-radius: var(--r-pill); font-size: 11px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
