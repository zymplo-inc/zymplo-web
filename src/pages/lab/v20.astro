---
const title = 'Zymplo · Tu trabajo ya vive en WhatsApp. Ahora también tu negocio.';
const description = 'Zymplo cobra por ti, agenda turnos, recuerda pagos y responde clientes. Todo desde el chat que ya usás todos los días.';
const ogImage = 'https://sims.zymplo.com/web/v20-assets/hero-latam.webp';
const A = 'https://sims.zymplo.com/web/v20-assets';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0A0B14" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="https://sims.zymplo.com/brand/isotipo.svg" />
    <link rel="apple-touch-icon" href="https://sims.zymplo.com/brand/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Sora:wght@500;700;800;900&display=swap" />
    <link rel="preload" as="image" href={`${A}/hero-latam.webp`} fetchpriority="high" />

    <style is:inline>
      :root {
        --bg: #0A0B14; --bg-2: #11141F;
        --paper: #FAFBFF; --ink: #0A0B14;
        --turq: #14B8A6; --turq-deep: #0F9488; --turq-light: #5EEAD4; --turq-paler: #CCFBF1;
        --good: #22C55E; --warm: #F59E0B; --hot: #FB923C;
        --grad-zy: linear-gradient(115deg, #14B8A6 0%, #5EEAD4 50%, #CCFBF1 100%);
        --grad-cta: linear-gradient(135deg, #14B8A6 0%, #0F9488 100%);
        --grad-glow: radial-gradient(circle, rgba(20,184,166,0.45) 0%, transparent 70%);
        --r-pill: 999px; --r-24: 24px; --r-16: 16px;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body { font-family: 'Inter', system-ui, sans-serif; background: var(--bg); color: var(--paper); min-height: 100vh; -webkit-font-smoothing: antialiased; line-height: 1.5; overflow-x: hidden; }
      img { max-width: 100%; display: block; }

      .display-l { font-family: 'Sora', sans-serif; font-weight: 800; font-size: clamp(40px, 7vw, 80px); letter-spacing: -0.04em; line-height: 1; }
      .h1 { font-family: 'Sora', sans-serif; font-weight: 800; font-size: clamp(34px, 5vw, 56px); letter-spacing: -0.035em; line-height: 1.1; }
      .h2 { font-family: 'Sora', sans-serif; font-weight: 800; font-size: clamp(28px, 4vw, 44px); letter-spacing: -0.03em; line-height: 1.15; }
      .micro { font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 700; }

      /* PROGRESS BAR */
      .progress { position: fixed; top: 0; left: 0; height: 3px; background: var(--grad-zy); z-index: 999; width: 0%; transition: width 0.05s linear; box-shadow: 0 0 8px var(--turq-light); }

      /* NAV */
      .nav { position: fixed; top: 14px; left: 14px; z-index: 100; padding: 6px 12px 6px 6px; background: rgba(255,255,255,0.05); backdrop-filter: blur(20px) saturate(160%); border: 1px solid rgba(255,255,255,0.12); border-radius: var(--r-pill); font-size: 12px; font-weight: 700; color: var(--paper); text-decoration: none; display: flex; align-items: center; gap: 6px; }
      .nav img { height: 18px; }
      .lab-badge { position: fixed; top: 14px; right: 14px; z-index: 100; padding: 6px 12px; background: rgba(20,184,166,0.18); backdrop-filter: blur(20px); border: 1px solid rgba(94,234,212,0.4); border-radius: var(--r-pill); font-size: 11px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--turq-light); text-decoration: none; }

      /* SCROLL HINT */
      .scroll-hint { position: fixed; bottom: 90px; left: 50%; transform: translateX(-50%); padding: 7px 16px 7px 14px; background: rgba(0,0,0,0.55); backdrop-filter: blur(14px); border: 1px solid rgba(255,255,255,0.12); border-radius: var(--r-pill); color: rgba(255,255,255,0.85); font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; z-index: 50; opacity: 0.9; pointer-events: none; transition: opacity 0.4s; display: inline-flex; align-items: center; gap: 8px; }
      .scroll-hint .arr { animation: bounce-y 1.6s ease-in-out infinite; }
      @keyframes bounce-y { 50% { transform: translateY(4px); } }
      .scroll-hint.hidden { opacity: 0; }

      /* STICKY MOBILE CTA */
      .mobile-cta { position: fixed; bottom: 16px; left: 16px; right: 16px; z-index: 90; display: none; align-items: center; justify-content: center; gap: 10px; padding: 14px 22px; background: var(--grad-cta); color: white; border-radius: var(--r-pill); font-weight: 800; font-size: 15px; text-decoration: none; text-align: center; box-shadow: 0 14px 40px rgba(20,184,166,0.45); }
      .mobile-cta::before { content: '💬'; }
      @media (max-width: 768px) { .mobile-cta { display: flex; } body { padding-bottom: 80px; } .scroll-hint { bottom: 84px; } }

      /* HERO */
      .hero { position: relative; min-height: 100vh; padding: 100px 22px 60px; max-width: 1280px; margin: 0 auto; display: flex; flex-direction: column; justify-content: center; }
      .hero-bg { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
      .hero-bg::before { content: ''; position: absolute; top: -10%; right: -10%; width: 80vw; height: 80vw; background: var(--grad-glow); filter: blur(80px); animation: float-x 20s ease-in-out infinite; opacity: 0.7; }
      .hero-bg::after { content: ''; position: absolute; bottom: -10%; left: -15%; width: 60vw; height: 60vw; background: radial-gradient(circle, rgba(94,234,212,0.25) 0%, transparent 70%); filter: blur(80px); animation: float-y 24s ease-in-out infinite; }
      @keyframes float-x { 50% { transform: translate(40px, -30px); } }
      @keyframes float-y { 50% { transform: translate(-40px, 30px); } }

      .hero-grid { position: relative; z-index: 2; display: grid; grid-template-columns: 1fr; gap: 40px; align-items: center; }
      @media (min-width: 1024px) { .hero-grid { grid-template-columns: 1.1fr 1fr; gap: 64px; } }

      .pill { display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; background: rgba(20,184,166,0.16); border: 1px solid rgba(94,234,212,0.4); border-radius: var(--r-pill); color: var(--turq-light); font-weight: 800; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; }
      .pill .pulse { width: 7px; height: 7px; border-radius: 50%; background: var(--turq-light); box-shadow: 0 0 0 0 var(--turq-light); animation: pulse-soft 2.4s ease-out infinite; }
      @keyframes pulse-soft { 0% { box-shadow: 0 0 0 0 rgba(94,234,212,0.7); } 70% { box-shadow: 0 0 0 12px rgba(94,234,212,0); } 100% { box-shadow: 0 0 0 0 rgba(94,234,212,0); } }

      h1.hero-h { margin-top: 22px; }
      h1.hero-h em { font-style: normal; background: var(--grad-zy); -webkit-background-clip: text; background-clip: text; color: transparent; background-size: 200% 200%; animation: shimmer 6s ease-in-out infinite; }
      @keyframes shimmer { 0%,100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }
      .hero-sub { margin-top: 22px; color: rgba(255,255,255,0.78); max-width: 540px; font-size: clamp(15px, 1.95vw, 19px); line-height: 1.55; font-weight: 500; }

      /* FAKE INPUT TYPED */
      .input-shell { margin-top: 32px; max-width: 540px; }
      .chat-input { display: flex; align-items: center; gap: 10px; padding: 8px 8px 8px 18px; background: rgba(255,255,255,0.05); border: 1.5px solid rgba(255,255,255,0.12); border-radius: var(--r-pill); transition: all 0.3s; backdrop-filter: blur(8px); }
      .chat-input:focus-within, .chat-input:hover { border-color: var(--turq-light); background: rgba(255,255,255,0.08); }
      .chat-input .icon { width: 28px; height: 28px; border-radius: 50%; background: var(--grad-cta); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
      .chat-input .icon img { width: 16px; height: 16px; filter: brightness(0) invert(1); }
      .chat-input .text { flex: 1; min-width: 0; font-size: 15px; color: rgba(255,255,255,0.85); padding: 11px 0; }
      .chat-input .typed { color: var(--paper); font-weight: 500; }
      .chat-input .cursor-blink { display: inline-block; width: 2px; height: 16px; background: var(--turq-light); margin-left: 1px; vertical-align: -3px; animation: blink-c 1s steps(1) infinite; }
      @keyframes blink-c { 50% { opacity: 0; } }
      .chat-input .send-btn { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; background: var(--grad-cta); color: white; border: 0; cursor: pointer; font-size: 19px; flex-shrink: 0; box-shadow: 0 8px 24px rgba(20,184,166,0.45); transition: all 0.2s; text-decoration: none; }
      .chat-input .send-btn:hover { transform: scale(1.08); box-shadow: 0 12px 32px rgba(20,184,166,0.6); }

      .hint-pills { margin-top: 14px; display: flex; gap: 8px; flex-wrap: wrap; }
      .hint-pills .h { padding: 5px 11px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.12); border-radius: var(--r-pill); font-size: 12px; color: rgba(255,255,255,0.7); }

      /* CTAs */
      .cta-row { margin-top: 28px; display: flex; gap: 14px; flex-wrap: wrap; align-items: center; }
      .btn-primary { display: inline-flex; align-items: center; gap: 10px; padding: 17px 30px; background: var(--paper); color: var(--ink); border-radius: var(--r-pill); font-weight: 800; font-size: 15px; text-decoration: none; box-shadow: 0 16px 50px rgba(20,184,166,0.32); transition: all 0.25s cubic-bezier(0.22,1,0.36,1); }
      .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 24px 70px rgba(20,184,166,0.5); }
      .btn-primary::after { content: '→'; transition: transform 0.3s; }
      .btn-primary:hover::after { transform: translateX(4px); }
      .btn-ghost { display: inline-flex; align-items: center; gap: 10px; padding: 17px 26px; color: rgba(255,255,255,0.85); background: transparent; border: 1px solid rgba(255,255,255,0.2); border-radius: var(--r-pill); font-weight: 700; font-size: 15px; text-decoration: none; transition: all 0.25s; }
      .btn-ghost:hover { background: rgba(255,255,255,0.06); color: white; border-color: rgba(255,255,255,0.4); }

      .micro-text { margin-top: 14px; font-size: 13px; color: rgba(255,255,255,0.55); }
      .micro-text::before { content: '✓ '; color: var(--turq-light); font-weight: 800; }

      /* HERO IMAGE · DALL-E generated */
      .hero-img-wrap { position: relative; aspect-ratio: 4/5; max-width: 480px; margin: 0 auto; border-radius: 24px; overflow: hidden; box-shadow: 0 40px 100px rgba(0,0,0,0.55), 0 0 80px rgba(20,184,166,0.18); transform: rotate(-1deg); animation: img-breath 7s ease-in-out infinite; }
      @keyframes img-breath { 50% { transform: rotate(-1deg) translateY(-6px); } }
      .hero-img-wrap img { width: 100%; height: 100%; object-fit: cover; }
      .hero-img-wrap::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 50%, rgba(10,11,20,0.6) 100%); pointer-events: none; }
      .hero-img-bubble { position: absolute; top: 24px; right: 24px; padding: 10px 14px; background: rgba(11,20,26,0.85); backdrop-filter: blur(20px); border: 1px solid rgba(94,234,212,0.4); border-radius: 14px; border-bottom-right-radius: 4px; max-width: 200px; font-size: 13px; line-height: 1.4; color: white; opacity: 0; animation: bubble-pop 0.8s 1.6s cubic-bezier(0.22,1,0.36,1) forwards; }
      .hero-img-bubble strong { color: var(--turq-light); display: block; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 4px; }
      @keyframes bubble-pop { from { opacity: 0; transform: translateY(8px) scale(0.96); } to { opacity: 1; transform: translateY(0) scale(1); } }

      /* AUDIO BUTTON */
      .audio-btn { position: fixed; bottom: 90px; right: 18px; z-index: 60; width: 48px; height: 48px; border-radius: 50%; background: rgba(11,20,26,0.7); backdrop-filter: blur(14px); border: 1px solid rgba(255,255,255,0.15); color: white; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 18px; transition: all 0.25s; }
      .audio-btn:hover { background: rgba(20,184,166,0.25); border-color: var(--turq-light); }
      @media (max-width: 768px) { .audio-btn { display: none; } }

      /* SCROLLY · 8 SCENES */
      .scrolly-shell { position: relative; }
      .scene { position: relative; min-height: 200vh; }
      .scene-pin { position: sticky; top: 0; height: 100vh; display: flex; align-items: center; justify-content: center; padding: 0 22px; overflow: hidden; }
      .scene .pre { color: var(--turq-light); }

      /* S1 · El Caos */
      .s1 .stage { max-width: 1100px; text-align: center; }
      .s1 h2 { font-family: 'Sora', sans-serif; font-weight: 800; font-size: clamp(34px, 6vw, 76px); letter-spacing: -0.04em; line-height: 1.05; margin-top: 28px; }
      .s1 .lines p { padding: 14px 0; }
      .s1 .lines p.dim { color: rgba(255,255,255,0.5); font-weight: 500; font-size: 0.65em; }
      .s1 .word { display: inline-block; opacity: 0; transform: translateY(30px); filter: blur(8px); transition: all 0.7s cubic-bezier(0.22,1,0.36,1); margin-right: 0.16em; }
      .s1 .word.show { opacity: 1; transform: translateY(0); filter: blur(0); }
      .s1 .word.alert { color: var(--hot); }

      /* S2 · WhatsApp es el centro */
      .s2 .stage { max-width: 800px; text-align: center; }
      .s2 .icon-big { width: clamp(160px, 30vw, 280px); height: clamp(160px, 30vw, 280px); margin: 0 auto; background: var(--grad-cta); border-radius: clamp(40px, 8vw, 64px); display: flex; align-items: center; justify-content: center; box-shadow: 0 40px 120px rgba(20,184,166,0.5); animation: icon-pulse 3s ease-in-out infinite; }
      .s2 .icon-big img { width: 60%; height: 60%; filter: brightness(0) invert(1); }
      @keyframes icon-pulse { 50% { transform: scale(1.04); box-shadow: 0 60px 140px rgba(20,184,166,0.7); } }
      .s2 h2 { margin-top: 36px; }

      /* S3 · La Magia · phone with chat */
      .s3 .stage { max-width: 1100px; display: grid; grid-template-columns: 1fr; gap: 32px; align-items: center; }
      @media (min-width: 900px) { .s3 .stage { grid-template-columns: 1fr 1fr; gap: 50px; } }
      .s3 h2 em { font-style: normal; background: var(--grad-zy); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .s3 p.deck { margin-top: 16px; color: rgba(255,255,255,0.7); max-width: 460px; font-size: 17px; line-height: 1.55; }
      .phone-stage { display: flex; justify-content: center; }
      .phone { width: 320px; max-width: 100%; aspect-ratio: 9/19; background: linear-gradient(160deg, #1a1a1d 0%, #0d0e10 100%); border-radius: 44px; padding: 8px; box-shadow: 0 40px 100px rgba(0,0,0,0.55), 0 0 80px rgba(20,184,166,0.18); border: 1.5px solid #2a2a2d; }
      .phone-screen { width: 100%; height: 100%; border-radius: 36px; background: #0B141A; overflow: hidden; display: flex; flex-direction: column; position: relative; }
      .phone-notch { position: absolute; top: 8px; left: 50%; transform: translateX(-50%); width: 110px; height: 28px; background: black; border-radius: 16px; z-index: 10; }
      .wa-top { padding: 38px 14px 10px; background: #1F2C33; display: flex; align-items: center; gap: 10px; }
      .wa-top .av { width: 36px; height: 36px; border-radius: 50%; background: var(--grad-cta); display: flex; align-items: center; justify-content: center; }
      .wa-top .av img { width: 22px; height: 22px; filter: brightness(0) invert(1); }
      .wa-top .id .n { font-size: 14px; font-weight: 700; line-height: 1.1; }
      .wa-top .id .s { font-size: 11px; color: rgba(255,255,255,0.55); margin-top: 2px; display: flex; align-items: center; gap: 4px; }
      .wa-top .id .s::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--good); }
      .wa-body { flex: 1; padding: 14px 10px; display: flex; flex-direction: column; gap: 6px; background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="200" height="200"><defs><pattern id="p" patternUnits="userSpaceOnUse" width="40" height="40"><circle cx="20" cy="20" r="1" fill="rgba(255,255,255,0.04)"/></pattern></defs><rect width="100%" height="100%" fill="%230B141A"/><rect width="100%" height="100%" fill="url(%23p)"/></svg>'); }
      .b { max-width: 80%; padding: 7px 11px 5px; border-radius: 13px; font-size: 13px; line-height: 1.4; opacity: 0; transform: translateY(8px); animation: bub-in 0.45s cubic-bezier(0.22,1,0.36,1) forwards; }
      .b1 { animation-delay: 0.8s; } .b2 { animation-delay: 2.2s; } .b3 { animation-delay: 3.6s; } .b4 { animation-delay: 5.2s; }
      @keyframes bub-in { to { opacity: 1; transform: translateY(0); } }
      .b.bot { align-self: flex-start; background: #1F2C33; color: white; border-bottom-left-radius: 4px; }
      .b.usr { align-self: flex-end; background: var(--turq-deep); color: white; border-bottom-right-radius: 4px; }
      .b strong { font-weight: 700; }
      .b em { font-style: normal; color: var(--turq-light); font-weight: 600; }
      .b .ts { display: block; margin-top: 3px; font-size: 9px; opacity: 0.55; text-align: right; }
      .b.usr .ts::after { content: ' ✓✓'; color: var(--turq-light); }

      /* S4 · Sistema Invisible */
      .s4 .stage { max-width: 1100px; text-align: center; }
      .s4 h2 em { font-style: normal; background: var(--grad-zy); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .flow { margin-top: 56px; display: flex; align-items: center; justify-content: center; gap: 12px; flex-wrap: wrap; }
      .flow-node { padding: 18px 22px; background: rgba(20,184,166,0.08); border: 1px solid rgba(94,234,212,0.3); border-radius: var(--r-16); display: flex; flex-direction: column; align-items: center; gap: 6px; min-width: 140px; transition: all 0.4s; }
      .flow-node:hover { background: rgba(20,184,166,0.16); transform: translateY(-4px); }
      .flow-node .ic { font-size: 32px; }
      .flow-node .l { font-family: 'Sora', sans-serif; font-weight: 700; font-size: 16px; }
      .flow-arrow { color: var(--turq-light); font-size: 24px; opacity: 0.6; }
      @media (max-width: 768px) { .flow-arrow { transform: rotate(90deg); } .flow { flex-direction: column; } }

      /* S5 · Personas reales · DALL-E images grid */
      .s5 .stage { max-width: 1280px; width: 100%; }
      .s5 .head { text-align: center; margin-bottom: 48px; }
      .s5 h2 em { font-style: normal; background: var(--grad-zy); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .oficios-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
      @media (min-width: 600px) { .oficios-grid { grid-template-columns: repeat(3, 1fr); } }
      @media (min-width: 1024px) { .oficios-grid { grid-template-columns: repeat(5, 1fr); } }
      .oficio-card { aspect-ratio: 3/4; border-radius: var(--r-16); overflow: hidden; position: relative; transition: all 0.4s; cursor: pointer; }
      .oficio-card:hover { transform: translateY(-4px); box-shadow: 0 20px 60px rgba(20,184,166,0.25); }
      .oficio-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s; }
      .oficio-card:hover img { transform: scale(1.06); }
      .oficio-card::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, rgba(10,11,20,0.85) 100%); pointer-events: none; }
      .oficio-card .label { position: absolute; bottom: 14px; left: 14px; right: 14px; z-index: 2; }
      .oficio-card .label .n { font-family: 'Sora', sans-serif; font-weight: 700; font-size: 18px; line-height: 1.1; }
      .oficio-card .label .q { margin-top: 4px; font-size: 12px; color: rgba(255,255,255,0.7); line-height: 1.4; opacity: 0; max-height: 0; transition: all 0.3s; }
      .oficio-card:hover .label .q { opacity: 1; max-height: 60px; }

      /* S6 · Resultados Humanos */
      .s6 .stage { max-width: 1100px; text-align: center; }
      .s6 h2 { max-width: 720px; margin: 16px auto 56px; }
      .s6 .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 32px; }
      .s6 .stat .v { font-family: 'Sora', sans-serif; font-weight: 900; font-size: clamp(56px, 10vw, 120px); letter-spacing: -0.05em; line-height: 0.95; background: var(--grad-zy); -webkit-background-clip: text; background-clip: text; color: transparent; font-variant-numeric: tabular-nums; }
      .s6 .stat .l { margin-top: 10px; font-size: 13px; color: rgba(255,255,255,0.55); text-transform: uppercase; letter-spacing: 0.14em; font-weight: 700; }
      .s6 .footnote { margin-top: 36px; font-size: 12px; color: rgba(255,255,255,0.4); }

      /* S7 · Tu Turno */
      .s7 .stage { max-width: 920px; text-align: center; }
      .s7 h2 em { font-style: normal; background: var(--grad-zy); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .s7 .options { margin-top: 36px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; max-width: 540px; margin-left: auto; margin-right: auto; }
      .s7 .opt { padding: 18px 18px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.12); border-radius: var(--r-16); display: flex; align-items: center; gap: 12px; text-decoration: none; color: white; font-weight: 600; font-size: 14.5px; transition: all 0.3s; }
      .s7 .opt:hover { background: rgba(20,184,166,0.12); border-color: var(--turq-light); transform: translateY(-2px); }
      .s7 .opt .ic { font-size: 22px; }

      /* S8 · Onboarding Preview */
