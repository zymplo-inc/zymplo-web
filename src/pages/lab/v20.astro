      .lp-body { flex: 1; padding: 14px 10px; background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="200" height="200"><defs><pattern id="p" patternUnits="userSpaceOnUse" width="40" height="40"><circle cx="20" cy="20" r="1" fill="rgba(255,255,255,0.04)"/></pattern></defs><rect width="100%" height="100%" fill="%230B141A"/><rect width="100%" height="100%" fill="url(%23p)"/></svg>'); display: flex; flex-direction: column; gap: 6px; overflow-y: auto; }
