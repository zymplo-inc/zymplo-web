      /* FLOATING WHATSAPP */
      .float-wa { position: fixed; bottom: 22px; right: 22px; z-index: 80; width: 56px; height: 56px; border-radius: 50%; background: var(--good); display: flex; align-items: center; justify-content: center; color: white; text-decoration: none; box-shadow: 0 14px 40px rgba(34,197,94,0.4); transition: all 0.25s; font-size: 24px; }
      .float-wa::after { content: ''; position: absolute; inset: -4px; border-radius: 50%; border: 2px solid var(--good); opacity: 0; animation: pulse-wa 2.4s ease-out infinite; }
