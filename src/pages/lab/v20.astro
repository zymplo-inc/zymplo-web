    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const $ = (s, c=document) => c.querySelector(s);
      const $$ = (s, c=document) => [...c.querySelectorAll(s)];

      // PROGRESS + HINT
      const prog = $('#prog'); const hint = $('#hint');
      function onScroll() {
        const sy = window.scrollY;
        const sh = document.documentElement.scrollHeight - window.innerHeight;
        prog.style.width = Math.min(100, Math.max(0, sy / sh * 100)) + '%';
        if (sy > 100 && hint) hint.classList.add('hidden');
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // TYPED ROTATION
      const examples = ['Cobrar a Juan 280 mañana', '¿Cuánto entré hoy?', 'Agendar a María mañana 9', '¿Quién no me pagó?', 'Resumen del día'];
      const typedEl = $('#typedText');
      let exIdx = 0, charIdx = 0, deleting = false;
      function tick() {
        if (reduceMotion) { typedEl.textContent = examples[0]; return; }
        const cur = examples[exIdx];
        if (!deleting) {
          charIdx++; typedEl.textContent = cur.slice(0, charIdx);
          if (charIdx === cur.length) { setTimeout(() => { deleting = true; tick(); }, 1700); return; }
          setTimeout(tick, 70 + Math.random() * 60);
        } else {
          charIdx--; typedEl.textContent = cur.slice(0, charIdx);
          if (charIdx === 0) { deleting = false; exIdx = (exIdx + 1) % examples.length; setTimeout(tick, 240); return; }
          setTimeout(tick, 30);
        }
      }
      tick();

      // SCROLLY
      const s1 = $('.scene.s1'); const s1words = $$('.s1 .word');
      function getProgress(scene) { const r = scene.getBoundingClientRect(); const sH = scene.offsetHeight - window.innerHeight; return Math.max(0, Math.min(1, -r.top / sH)); }
      const s6stats = $$('.s6 .stat .v'); const s6anim = new Set();
      function onScrolly() {
        if (reduceMotion) return;
        if (s1) {
          const p = getProgress(s1);
          const showCount = Math.floor(p * (s1words.length + 4));
          s1words.forEach((w, i) => { if (i < showCount) w.classList.add('show'); else w.classList.remove('show'); });
        }
        const s6 = $('.scene.s6');
        if (s6) {
          const r = s6.getBoundingClientRect();
          if (r.top < window.innerHeight * 0.6 && r.bottom > 0 && !s6anim.has('done')) {
            s6anim.add('done');
            s6stats.forEach((v) => {
              const target = parseFloat(v.dataset.target || '0');
              const prefix = v.dataset.prefix || ''; const suffix = v.dataset.suffix || '';
              const decimals = parseInt(v.dataset.decimals ?? '0');
              const dur = 1700; const t0 = performance.now();
              function step(t) {
                const p = Math.min(1, (t - t0) / dur);
                const eased = 1 - Math.pow(1 - p, 3);
                const cur = target * eased;
                v.textContent = prefix + cur.toLocaleString('pt-BR', { minimumFractionDigits: decimals, maximumFractionDigits: decimals }) + suffix;
                if (p < 1) requestAnimationFrame(step);
              }
              requestAnimationFrame(step);
            });
          }
        }
      }
      window.addEventListener('scroll', onScrolly, { passive: true });
      onScrolly();

      // ONBOARDING PREVIEW · S8
      const onbScript = [
        ['bot', 'Hola 👋 Soy Zymplo. Te ayudo a cobrar, organizar y recordar todo desde WhatsApp.'],
        ['bot', '¿Cómo te llamás?'],
        ['usr', 'Carlos'],
        ['bot', 'Prazer Carlos. ¿A qué te dedicás?'],
        ['quicks', ['Servicios', 'Ventas', 'Consultoría', 'Loja']],
        ['usr', 'Servicios'],
        ['bot', 'Vamos a crear tu primer cobro. Probá: <em>"cobrar a Juan 200 mañana"</em>'],
        ['usr', 'cobrar a Juan 200 mañana'],
        ['bot', 'Listo ✨<br/>Cobro armado · recordatorio agendado · cuando Juan pague te aviso.'],
        ['bot', 'Tu primer cobro ya está organizado. Así se siente trabajar con menos caos.'],
      ];
      const onbChat = $('#onbChat');
      let onbStarted = false;
      function startOnb() {
        if (onbStarted) return; onbStarted = true;
        onbScript.forEach((step, i) => {
          setTimeout(() => {
            if (step[0] === 'quicks') {
              const w = document.createElement('div'); w.className = 'quicks';
              step[1].forEach(q => { const c = document.createElement('span'); c.className = 'qr'; c.textContent = q; w.appendChild(c); });
              onbChat.appendChild(w);
            } else {
              const b = document.createElement('div'); b.className = 'b ' + step[0]; b.innerHTML = step[1];
              onbChat.appendChild(b);
              setTimeout(() => b.classList.add('show'), 50);
            }
          }, reduceMotion ? 0 : i * 800);
        });
      }
      const obs = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { startOnb(); obs.disconnect(); } });
      }, { threshold: 0.3 });
      if (onbChat) obs.observe(onbChat);

      // INTERACTIVE DEMO
      const live = $('#livechat'); const lin = $('#liveInput'); const lsend = $('#liveSend');
      function addBub(side, html) {
        const b = document.createElement('div'); b.className = 'b ' + side;
        b.style.cssText = 'opacity: 0; transform: translateY(8px); animation: bub-in 0.4s cubic-bezier(0.22,1,0.36,1) forwards; max-width: 80%; padding: 7px 11px 5px; border-radius: 13px; font-size: 13px; line-height: 1.4;';
        b.style.background = side === 'usr' ? 'var(--turq-deep)' : '#1F2C33';
        b.style.color = 'white';
        b.style.alignSelf = side === 'usr' ? 'flex-end' : 'flex-start';
        b.style[side === 'usr' ? 'borderBottomRightRadius' : 'borderBottomLeftRadius'] = '4px';
        b.innerHTML = html + '<span style="display:block;margin-top:3px;font-size:9px;opacity:0.55;text-align:right;">ahora' + (side === 'usr' ? ' ✓✓' : '') + '</span>';
        live.appendChild(b); live.scrollTop = live.scrollHeight;
      }
      function showTyping() {
        const tp = document.createElement('div'); tp.className = 'typing-dots'; tp.innerHTML = '<span></span><span></span><span></span>';
        live.appendChild(tp); live.scrollTop = live.scrollHeight; return tp;
      }
      function reply(msg) {
        const m = msg.toLowerCase();
        if (/(cu[aá]nto.*entr|resumen|d[ií]a|hoy|este mes|faturament)/.test(m)) {
          return ['📊 Hoy entraron <strong>R$ 1.240 ✨</strong>', 'Pendientes: <em>R$ 680</em> (3 clientes)', '¿Querés que les mande recordatorio?'];
        }
        if (/(cobrar?|cobran)/.test(m)) {
          const monto = m.match(/(\d{2,})/);
          const a = m.match(/(?:cobrar?\s+a?\s+|para\s+)([a-zà-ÿ]+)/i);
          return [
            '💸 Cobro listo para <strong>' + (a ? a[1] : 'tu cliente') + '</strong>' + (monto ? ' · <em>R$ ' + Number(monto[1]).toLocaleString('pt-BR') + '</em>' : ''),
            'Mando un mensaje cordial · con link Pix anexado. <strong>¿Lo envío?</strong>',
          ];
        }
        if (/(agend|reservar|amana|amanha)/.test(m)) {
          return ['📅 Turno agendado · te aviso cuando se acerque.', '¿Querés agregar más detalles?'];
        }
        if (/(qui[eé]n.*no.*pag|inadimplent|debe)/.test(m)) {
          return ['⚠️ <strong>3 clientes</strong> aún no te pagaron:', '· Juan · R$ 200<br/>· Ana · R$ 150<br/>· Marcos · R$ 420', '¿Les envío recordatorio ahora?'];
        }
        return ['Buenísimo · te ayudo. Probá:<br/>· <em>cobrar a Juan 200</em><br/>· <em>¿cuánto entró hoy?</em><br/>· <em>¿quién no me pagó?</em><br/>· <em>resumen del día</em>'];
      }
      function userSend(msg) {
        if (!msg.trim()) return;
        addBub('usr', msg); lin.value = '';
        const tp = showTyping();
        const responses = reply(msg);
        responses.forEach((r, i) => { setTimeout(() => { if (i === 0) tp.remove(); addBub('bot', r); }, reduceMotion ? 0 : 700 + i * 950); });
      }
      lsend && lsend.addEventListener('click', () => userSend(lin.value));
      lin && lin.addEventListener('keydown', (e) => { if (e.key === 'Enter') userSend(lin.value); });
      $$('.qp').forEach((b) => b.addEventListener('click', () => userSend(b.dataset.prompt)));

      // AUDIO TOGGLE
      const audioBtn = $('#audioBtn'); const audio = $('#heroAudio');
      let audioPlaying = false;
      audioBtn && audioBtn.addEventListener('click', async () => {
        try {
          if (!audioPlaying) { await audio.play(); audioBtn.textContent = '🔊'; audioPlaying = true; }
          else { audio.pause(); audioBtn.textContent = '🔇'; audioPlaying = false; }
        } catch (e) { audioBtn.textContent = '🔇'; audioBtn.style.opacity = '0.4'; }
      });
    </script>
  </body>
