---
const title = 'Zymplo · Alive Lab · Variant B';
const description = 'Landing vivo · respira · reacciona. Tu secretaria IA en WhatsApp.';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0A0B14" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="https://sims.zymplo.com/brand/isotipo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Sora:wght@400;500;600;700;800;900&display=swap" />
    <style is:inline>
      :root { --turquesa: #14B8A6; --turquesa-light: #5EEAD4; --turquesa-paler: #CCFBF1; --turquesa-deep: #0B6B62; --ink: #0A0B14; --ink-2: #0F172A; --paper: #FAFBFF; --purple: #623AE6; --warm: #F59E0B; --good: #22C55E; }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: 'Manrope', sans-serif; background: var(--ink); color: white; overflow-x: hidden; cursor: none; }
      @media (max-width: 1023px) { body { cursor: auto; } }

      /* CURSOR SPOTLIGHT */
      .spot { position: fixed; pointer-events: none; z-index: 1; width: 600px; height: 600px; border-radius: 50%; background: radial-gradient(circle, rgba(20,184,166,0.18) 0%, rgba(20,184,166,0.04) 30%, transparent 60%); transform: translate(-50%, -50%); transition: opacity 0.3s; will-change: left, top; opacity: 0; }
      .cursor-dot { position: fixed; pointer-events: none; z-index: 1000; width: 12px; height: 12px; border-radius: 50%; background: var(--turquesa-light); transform: translate(-50%, -50%); transition: width 0.2s, height 0.2s, background 0.2s; box-shadow: 0 0 20px rgba(94,234,212,0.6); will-change: left, top; }
      .cursor-dot.over { width: 40px; height: 40px; background: rgba(94,234,212,0.3); border: 1.5px solid var(--turquesa-light); }
      @media (max-width: 1023px) { .spot, .cursor-dot { display: none; } }

      /* GRID BG · animated dots */
      .grid-bg { position: fixed; inset: 0; z-index: 0; background-image: linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px); background-size: 64px 64px; mask-image: radial-gradient(ellipse 80% 50% at 50% 0%, black 0%, transparent 70%); -webkit-mask-image: radial-gradient(ellipse 80% 50% at 50% 0%, black 0%, transparent 70%); pointer-events: none; }

      /* lab badge */
      .lab-badge { position: fixed; top: 16px; right: 16px; z-index: 100; padding: 6px 12px; background: rgba(255,255,255,0.06); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.15); border-radius: 999px; font-size: 11px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.85); text-decoration: none; transition: all 0.3s; }
      .lab-badge:hover { background: rgba(255,255,255,0.12); color: white; }
      .nav { position: fixed; top: 16px; left: 16px; z-index: 100; display: flex; align-items: center; gap: 8px; padding: 6px 14px 6px 8px; background: rgba(255,255,255,0.04); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.1); border-radius: 999px; text-decoration: none; color: white; font-weight: 800; font-size: 14px; transition: all 0.3s; }
      .nav:hover { background: rgba(255,255,255,0.08); }
      .nav img { height: 22px; }

      /* TICKER · live activity */
      .ticker { position: relative; z-index: 5; margin: 80px auto 0; max-width: 720px; padding: 0 24px; }
      .ticker-shell { display: flex; align-items: center; gap: 14px; padding: 12px 18px; background: rgba(255,255,255,0.04); backdrop-filter: blur(24px); border: 1px solid rgba(255,255,255,0.1); border-radius: 999px; font-size: 13px; }
      .ticker-pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--good); flex-shrink: 0; box-shadow: 0 0 0 0 rgba(34,197,94,0.7); animation: pulse-good 1.5s ease-out infinite; }
      @keyframes pulse-good { 0% { box-shadow: 0 0 0 0 rgba(34,197,94,0.7); } 70% { box-shadow: 0 0 0 10px rgba(34,197,94,0); } 100% { box-shadow: 0 0 0 0 rgba(34,197,94,0); } }
      .ticker-text { flex: 1; color: rgba(255,255,255,0.85); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .ticker-text strong { color: white; font-weight: 700; }
      .ticker-text em { font-style: normal; color: var(--turquesa-light); font-weight: 600; }

      /* HERO */
      .hero { position: relative; z-index: 2; padding: 60px 24px 100px; max-width: 1200px; margin: 0 auto; text-align: center; }
      .h-eyebrow { display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; background: rgba(20,184,166,0.1); border: 1px solid rgba(20,184,166,0.3); border-radius: 999px; font-size: 11px; font-weight: 800; letter-spacing: 0.18em; text-transform: uppercase; color: var(--turquesa-light); }

      h1.alive { font-family: 'Sora', sans-serif; font-weight: 900; letter-spacing: -0.05em; line-height: 0.95; font-size: clamp(48px, 9vw, 124px); margin-top: 22px; }
      h1.alive .grad { background: linear-gradient(115deg, var(--turquesa-light) 0%, var(--turquesa-paler) 30%, white 50%, var(--turquesa-light) 100%); background-size: 250% 250%; -webkit-background-clip: text; background-clip: text; color: transparent; animation: shimmer-alive 4.5s ease-in-out infinite; }
      @keyframes shimmer-alive { 0%,100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }

      .h-sub { margin-top: 24px; font-size: clamp(16px, 2.1vw, 22px); color: rgba(255,255,255,0.7); max-width: 640px; margin-left: auto; margin-right: auto; line-height: 1.45; }

      /* MAGNETIC CTA */
      .h-cta { margin-top: 40px; display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; align-items: center; }
      .btn-mag { position: relative; display: inline-flex; align-items: center; gap: 10px; padding: 18px 32px; background: linear-gradient(135deg, var(--turquesa) 0%, var(--turquesa-light) 100%); color: var(--ink); border-radius: 999px; font-weight: 800; font-size: 16px; text-decoration: none; box-shadow: 0 14px 60px rgba(20,184,166,0.4); transition: transform 0.18s cubic-bezier(0.22,1,0.36,1), box-shadow 0.3s; will-change: transform; }
      .btn-mag::before { content: ''; position: absolute; inset: 0; border-radius: 999px; background: linear-gradient(135deg, var(--turquesa-light) 0%, white 100%); opacity: 0; transition: opacity 0.3s; }
      .btn-mag:hover::before { opacity: 1; }
      .btn-mag span { position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 10px; }
      .btn-mag::after { content: '→'; position: relative; z-index: 1; transition: transform 0.3s; }
      .btn-mag:hover { box-shadow: 0 22px 80px rgba(20,184,166,0.6); }
      .btn-mag:hover::after { transform: translateX(4px); }
      .btn-ghost { display: inline-flex; align-items: center; gap: 10px; padding: 18px 28px; color: rgba(255,255,255,0.85); background: transparent; border: 1px solid rgba(255,255,255,0.2); border-radius: 999px; font-weight: 800; font-size: 16px; text-decoration: none; transition: all 0.25s; }
      .btn-ghost:hover { background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.45); color: white; }

      .micro { margin-top: 16px; font-size: 13px; color: rgba(255,255,255,0.55); display: inline-flex; gap: 18px; flex-wrap: wrap; justify-content: center; }
      .micro span { display: inline-flex; align-items: center; gap: 6px; }
      .micro span::before { content: '✓'; color: var(--turquesa-light); font-weight: 800; }

      /* STATS · count up */
      .stats { position: relative; z-index: 2; padding: 60px 24px; }
      .stats-wrap { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 28px; }
      .stat { text-align: center; padding: 28px 18px; background: rgba(255,255,255,0.025); border: 1px solid rgba(255,255,255,0.06); border-radius: 22px; transition: all 0.4s cubic-bezier(0.22,1,0.36,1); position: relative; overflow: hidden; }
      .stat::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 50% 0%, rgba(20,184,166,0.12) 0%, transparent 60%); opacity: 0; transition: opacity 0.4s; }
      .stat:hover { transform: translateY(-4px); border-color: rgba(94,234,212,0.4); }
      .stat:hover::before { opacity: 1; }
      .stat .v { position: relative; font-family: 'Sora', sans-serif; font-weight: 800; font-size: clamp(34px, 5vw, 56px); letter-spacing: -0.04em; line-height: 1; background: linear-gradient(120deg, var(--turquesa-light), white); -webkit-background-clip: text; background-clip: text; color: transparent; font-variant-numeric: tabular-nums; }
      .stat .l { position: relative; margin-top: 10px; font-size: 12px; color: rgba(255,255,255,0.6); text-transform: uppercase; letter-spacing: 0.12em; font-weight: 700; }

      /* FEATURES · cards hover lift + glow */
      .feats { position: relative; z-index: 2; padding: 100px 24px; max-width: 1280px; margin: 0 auto; }
      .feats-h { text-align: center; margin-bottom: 64px; }
      .feats-h .e { display: inline-block; padding: 4px 10px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.12); border-radius: 999px; font-size: 11px; font-weight: 800; letter-spacing: 0.15em; text-transform: uppercase; color: rgba(255,255,255,0.7); }
      .feats-h h2 { font-family: 'Sora', sans-serif; font-weight: 800; font-size: clamp(34px, 5vw, 60px); letter-spacing: -0.04em; line-height: 1.05; margin-top: 14px; max-width: 720px; margin-left: auto; margin-right: auto; }
      .feats-h h2 em { font-style: normal; background: linear-gradient(120deg, var(--turquesa-light), var(--turquesa-paler)); -webkit-background-clip: text; background-clip: text; color: transparent; }

      .feat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 22px; }
      .fc { position: relative; padding: 32px; background: rgba(255,255,255,0.025); border: 1px solid rgba(255,255,255,0.08); border-radius: 24px; transition: all 0.4s cubic-bezier(0.22,1,0.36,1); overflow: hidden; cursor: none; }
      @media (max-width: 1023px) { .fc { cursor: pointer; } }
      .fc::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at var(--mx, 50%) var(--my, 50%), rgba(94,234,212,0.18) 0%, transparent 50%); opacity: 0; transition: opacity 0.4s; pointer-events: none; }
      .fc:hover { transform: translateY(-6px); border-color: rgba(94,234,212,0.35); box-shadow: 0 22px 60px rgba(0,0,0,0.4), 0 0 80px rgba(20,184,166,0.18); }
      .fc:hover::before { opacity: 1; }
      .fc .ic { position: relative; width: 52px; height: 52px; border-radius: 16px; background: linear-gradient(135deg, var(--turquesa) 0%, var(--purple) 100%); display: flex; align-items: center; justify-content: center; font-size: 24px; }
      .fc .t { position: relative; font-family: 'Sora', sans-serif; font-weight: 700; font-size: 22px; letter-spacing: -0.02em; margin-top: 18px; }
      .fc .d { position: relative; margin-top: 8px; font-size: 14px; color: rgba(255,255,255,0.65); line-height: 1.5; }

      /* TESTIMONIALS · carousel auto-rotate */
      .test { position: relative; z-index: 2; padding: 80px 24px; }
      .test-wrap { max-width: 880px; margin: 0 auto; }
      .test-hd { text-align: center; margin-bottom: 48px; font-size: 13px; color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 0.18em; font-weight: 800; }
      .test-stage { position: relative; min-height: 240px; }
      .testimonial { position: absolute; inset: 0; padding: 36px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 24px; opacity: 0; transform: translateY(20px); transition: opacity 0.6s, transform 0.6s; pointer-events: none; }
      .testimonial.active { opacity: 1; transform: translateY(0); pointer-events: auto; }
      .testimonial .quote { font-family: 'Sora', sans-serif; font-weight: 600; font-size: clamp(20px, 2.4vw, 28px); letter-spacing: -0.025em; line-height: 1.3; }
      .testimonial .who { margin-top: 22px; display: flex; align-items: center; gap: 12px; }
      .testimonial .who .av { width: 48px; height: 48px; border-radius: 50%; background: linear-gradient(135deg, var(--turquesa) 0%, var(--purple) 100%); display: flex; align-items: center; justify-content: center; font-family: 'Sora', sans-serif; font-weight: 800; font-size: 18px; color: white; flex-shrink: 0; }
      .testimonial .who .meta .n { font-weight: 800; font-size: 15px; }
      .testimonial .who .meta .r { font-size: 13px; color: rgba(255,255,255,0.55); margin-top: 2px; }

      /* FINAL CTA */
      .final { position: relative; z-index: 2; padding: 120px 24px 100px; text-align: center; }
      .final h2 { font-family: 'Sora', sans-serif; font-weight: 900; letter-spacing: -0.05em; line-height: 0.95; font-size: clamp(44px, 7vw, 88px); }
      .final h2 .grad { background: linear-gradient(115deg, var(--turquesa-light), var(--turquesa-paler)); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .final p { margin-top: 22px; font-size: clamp(15px, 2vw, 19px); color: rgba(255,255,255,0.7); max-width: 480px; margin-left: auto; margin-right: auto; }
      .final-row { margin-top: 40px; display: inline-flex; align-items: center; gap: 14px; flex-wrap: wrap; justify-content: center; }
      .final-mic { margin-top: 18px; font-size: 13px; color: rgba(255,255,255,0.5); }

      /* footer */
      .ft { position: relative; z-index: 2; padding: 40px 24px; text-align: center; font-size: 12px; color: rgba(255,255,255,0.35); border-top: 1px solid rgba(255,255,255,0.05); }
      .ft a { color: rgba(255,255,255,0.55); text-decoration: none; margin: 0 10px; }
      .ft a:hover { color: white; }

      @media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; } .spot, .cursor-dot { display: none !important; } body { cursor: auto !important; } }
    </style>
  </head>
  <body>
    <div class="spot" id="spot"></div>
    <div class="cursor-dot" id="cdot"></div>
    <div class="grid-bg"></div>

    <a class="nav" href="/lab/"><img src="https://sims.zymplo.com/brand/isotipo.svg" alt="Zymplo" />← Lab</a>
    <a class="lab-badge" href="/lab/">B · Alive</a>

    <div class="ticker">
      <div class="ticker-shell">
        <span class="ticker-pulse"></span>
        <span class="ticker-text" id="ticker"><strong>Diego</strong> acaba de cobrar <em>₲ 850.000</em> · São Paulo · hace 12s</span>
      </div>
    </div>

    <main class="hero">
      <span class="h-eyebrow">⚡ EN VIVO · 13 PAÍSES</span>
      <h1 class="alive">Cobrá. Sin perseguir.<br/><span class="grad">La IA hace todo.</span></h1>
      <p class="h-sub">Tu secretaria IA dentro de WhatsApp. Cobra · factura · agenda · organiza. Sin app · sin signup · sin fricción.</p>

      <div class="h-cta">
        <a class="btn-mag" id="btn-mag" href="https://wa.me/595981970735?text=Quiero%20probar%20Zymplo"><span>Empezar gratis</span></a>
        <a class="btn-ghost" href="#feats">Ver cómo funciona</a>
      </div>
      <div class="micro"><span>Sin app</span><span>Sin registro</span><span>Gratis para siempre</span></div>
    </main>

    <section class="stats">
      <div class="stats-wrap">
        <div class="stat"><div class="v" data-target="47280000" data-prefix="$ " data-suffix="M" data-divisor="1000000" data-decimals="2">$ 0M</div><div class="l">cobrados este mes</div></div>
        <div class="stat"><div class="v" data-target="12847" data-decimals="0">0</div><div class="l">personas activas</div></div>
        <div class="stat"><div class="v" data-target="13" data-decimals="0">0</div><div class="l">países</div></div>
        <div class="stat"><div class="v" data-target="847" data-decimals="0">0</div><div class="l">se sumaron hoy</div></div>
      </div>
    </section>

    <section class="feats" id="feats">
      <div class="feats-h">
        <span class="e">⚡ qué hace zé</span>
        <h2>Todo lo que <em>odiás hacer</em>.<br/>Sin que lo pidas.</h2>
      </div>
      <div class="feat-grid">
        <div class="fc"><div class="ic">💸</div><div class="t">Cobra sin perseguir</div><div class="d">Detecta facturas vencidas. Manda recordatorios calientes que cobran. Te avisa cuando entró la plata.</div></div>
        <div class="fc"><div class="ic">🧾</div><div class="t">Facturá hablando</div><div class="d">"Hacé factura a Pablo por 850.000". Listo. NFS-e · CFDI · DIAN · AFIP · todo según tu país.</div></div>
        <div class="fc"><div class="ic">📅</div><div class="t">Agenda en tu cabeza</div><div class="d">"Recordame mañana 9 ir al taller". Zé te avisa. No olvidás nada. Nunca más.</div></div>
        <div class="fc"><div class="ic">📊</div><div class="t">Resumen al toque</div><div class="d">"¿Cómo voy este mes?". Te muestra entró · falta · gastaste. En segundos. Sin abrir nada.</div></div>
        <div class="fc"><div class="ic">🌎</div><div class="t">13 países · 3 idiomas</div><div class="d">PT · ES · EN. Tu moneda · tus impuestos · tu jerga local. Sin reaprender nada.</div></div>
        <div class="fc"><div class="ic">⚡</div><div class="t">24/7 sin parar</div><div class="d">Zé no duerme · no se enferma · no se va de vacaciones. Trabaja por vos siempre.</div></div>
      </div>
    </section>

    <section class="test">
      <div class="test-wrap">
        <div class="test-hd">⭐ Gente como vos</div>
        <div class="test-stage" id="test-stage">
          <div class="testimonial active"><div class="quote">"En 3 días me organizó las cobranzas que tenía atrasadas hace 4 meses. Cobré ₲ 6 millones que ya daba por perdidos."</div><div class="who"><div class="av">D</div><div class="meta"><div class="n">Diego · Eletricista</div><div class="r">São Paulo · Brasil</div></div></div></div>
          <div class="testimonial"><div class="quote">"Le hablo como a un amigo. Me hace las facturas, me cobra, me recuerda. No vuelvo a un Excel nunca más."</div><div class="who"><div class="av">L</div><div class="meta"><div class="n">Luana · Cabeleireira</div><div class="r">Belo Horizonte · Brasil</div></div></div></div>
          <div class="testimonial"><div class="quote">"Es como tener un secretario · pero sin pagarle sueldo · sin que falte · sin que me pida vacaciones."</div><div class="who"><div class="av">R</div><div class="meta"><div class="n">Raimundo · Encanador</div><div class="r">Recife · Brasil</div></div></div></div>
        </div>
      </div>
    </section>

    <section class="final">
      <h2>Empezá hoy.<br/><span class="grad">Sin fricción.</span></h2>
      <p>Abrí WhatsApp. Mandá un mensaje. Empezá a recuperar tu tiempo.</p>
      <div class="final-row">
        <a class="btn-mag" href="https://wa.me/595981970735?text=Quiero%20probar%20Zymplo"><span>Probar gratis ahora</span></a>
      </div>
      <div class="final-mic">Gratis para siempre · empezás en menos de 10 segundos · funciona desde WhatsApp</div>
    </section>

    <footer class="ft">
      © 2026 Zymplo · <a href="/lab/">Lab</a> · <a href="/">Landing actual</a> · <a href="/lab/cinematic/">Variant A</a> · <a href="/lab/conversational/">Variant C</a>
    </footer>

    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const isMobile = window.matchMedia('(max-width: 1023px)').matches;

      // CURSOR + SPOTLIGHT
      const spot = document.getElementById('spot');
      const cdot = document.getElementById('cdot');
      let mx = window.innerWidth / 2, my = window.innerHeight / 2;
      let sx = mx, sy = my;
      if (!reduceMotion && !isMobile) {
        document.addEventListener('mousemove', (e) => { mx = e.clientX; my = e.clientY; if (cdot) { cdot.style.left = mx + 'px'; cdot.style.top = my + 'px'; } if (spot) { spot.style.opacity = '1'; } });
        document.addEventListener('mouseleave', () => { if (spot) spot.style.opacity = '0'; });
        function loopSpot() {
          sx += (mx - sx) * 0.08;
          sy += (my - sy) * 0.08;
          if (spot) { spot.style.left = sx + 'px'; spot.style.top = sy + 'px'; }
          requestAnimationFrame(loopSpot);
        }
        loopSpot();
        document.querySelectorAll('a, button, .fc').forEach((el) => {
          el.addEventListener('mouseenter', () => cdot && cdot.classList.add('over'));
          el.addEventListener('mouseleave', () => cdot && cdot.classList.remove('over'));
        });
      }

      // MAGNETIC CTA
      const mag = document.getElementById('btn-mag');
      if (mag && !reduceMotion && !isMobile) {
        mag.addEventListener('mousemove', (e) => {
          const r = mag.getBoundingClientRect();
          const x = e.clientX - r.left - r.width / 2;
          const y = e.clientY - r.top - r.height / 2;
          mag.style.transform = `translate(${x * 0.18}px, ${y * 0.18}px)`;
        });
        mag.addEventListener('mouseleave', () => { mag.style.transform = ''; });
      }

      // FEATURE CARD glow follow
      document.querySelectorAll('.fc').forEach((c) => {
        c.addEventListener('mousemove', (e) => {
          const r = c.getBoundingClientRect();
          c.style.setProperty('--mx', ((e.clientX - r.left) / r.width) * 100 + '%');
          c.style.setProperty('--my', ((e.clientY - r.top) / r.height) * 100 + '%');
        });
      });

      // STATS counter on viewport
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            const v = e.target.querySelector('.v');
            if (!v) return;
            const target = parseFloat(v.dataset.target || '0');
            const prefix = v.dataset.prefix || '';
            const suffix = v.dataset.suffix || '';
            const divisor = parseFloat(v.dataset.divisor || '1');
            const decimals = parseInt(v.dataset.decimals || '0');
            const dur = 1800; const t0 = performance.now();
            function step(t) {
              const p = Math.min(1, (t - t0) / dur);
              const eased = 1 - Math.pow(1 - p, 3);
              const cur = (target / divisor) * eased;
              v.textContent = prefix + cur.toFixed(decimals) + suffix;
              if (p < 1) requestAnimationFrame(step);
            }
            requestAnimationFrame(step);
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.4 });
      document.querySelectorAll('.stat').forEach((s) => io.observe(s));

      // LIVE TICKER · rotates
      const tickerMsgs = [
        '<strong>Diego</strong> acaba de cobrar <em>₲ 850.000</em> · São Paulo · hace 12s',
        '<strong>Luana</strong> facturó <em>R$ 320</em> en NFS-e · BH · hace 24s',
        '<strong>María</strong> programó <em>3 recordatorios</em> · CDMX · hace 38s',
        '<strong>Pablo</strong> cobró <em>$ 4.200 ARS</em> por MercadoPago · BA · hace 51s',
        '<strong>John</strong> sent <em>$ 320 USD</em> via Zelle · Miami · 1m ago',
        '<strong>Carmen</strong> emitió <em>CFDI 4.0</em> · Guadalajara · hace 1m',
        '<strong>Sofía</strong> cobró <em>S/ 180</em> por Yape · Lima · hace 2m',
        '<strong>Andrés</strong> facturó <em>€ 240</em> · Valencia · hace 2m',
      ];
      let ti = 0;
      const tickerEl = document.getElementById('ticker');
      function rotateTicker() {
        ti = (ti + 1) % tickerMsgs.length;
        if (tickerEl) {
          tickerEl.style.opacity = '0';
          setTimeout(() => { tickerEl.innerHTML = tickerMsgs[ti]; tickerEl.style.opacity = '1'; }, 280);
        }
      }
      tickerEl && (tickerEl.style.transition = 'opacity 0.3s');
      setInterval(rotateTicker, 3200);

      // TESTIMONIALS auto-rotate
      const testEls = document.querySelectorAll('.testimonial');
      let trotIdx = 0;
      function rotateTest() {
        testEls[trotIdx].classList.remove('active');
        trotIdx = (trotIdx + 1) % testEls.length;
        testEls[trotIdx].classList.add('active');
      }
      setInterval(rotateTest, 4500);
    </script>
  </body>
</html>
