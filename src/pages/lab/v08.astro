---
const title = 'Zymplo · Glassmorph Lab · V08';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0F172A" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="https://sims.zymplo.com/brand/isotipo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Sora:wght@600;700;800;900&display=swap" />
    <style is:inline>
      :root { --turq: #14B8A6; --turq-light: #5EEAD4; --turq-paler: #CCFBF1; --pink: #FB7185; --gold: #F59E0B; --purple: #A78BFA; --paper: #FAFBFF; }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: 'Inter', sans-serif; color: var(--paper); min-height: 100vh; overflow-x: hidden; background: linear-gradient(135deg, #0F172A 0%, #1E1B4B 50%, #14B8A6 100%); position: relative; }

      /* aurora blobs */
      .aurora { position: fixed; inset: -10%; pointer-events: none; z-index: 0; }
      .a-blob { position: absolute; border-radius: 50%; filter: blur(80px); will-change: transform; }
      .a1 { top: 0%; left: 5%; width: 60vw; height: 60vw; background: radial-gradient(circle, rgba(94,234,212,0.6) 0%, transparent 60%); animation: drift1 18s ease-in-out infinite; }
      .a2 { top: 30%; right: 0%; width: 55vw; height: 55vw; background: radial-gradient(circle, rgba(167,139,250,0.55) 0%, transparent 60%); animation: drift2 22s ease-in-out infinite; }
      .a3 { bottom: -10%; left: 30%; width: 50vw; height: 50vw; background: radial-gradient(circle, rgba(251,113,133,0.45) 0%, transparent 60%); animation: drift3 24s ease-in-out infinite; }
      @keyframes drift1 { 50% { transform: translate(40px, -30px); } }
      @keyframes drift2 { 50% { transform: translate(-50px, 40px); } }
      @keyframes drift3 { 50% { transform: translate(30px, -40px); } }

      .nav-back { position: fixed; top: 14px; left: 14px; z-index: 100; padding: 6px 12px 6px 6px; background: rgba(255,255,255,0.08); backdrop-filter: blur(20px) saturate(160%); border: 1px solid rgba(255,255,255,0.18); border-radius: 999px; font-size: 12px; font-weight: 700; color: var(--paper); text-decoration: none; display: flex; align-items: center; gap: 6px; }
      .nav-back img { height: 18px; }
      .lab-badge { position: fixed; top: 14px; right: 14px; z-index: 100; padding: 6px 12px; background: rgba(255,255,255,0.08); backdrop-filter: blur(20px) saturate(160%); border: 1px solid rgba(255,255,255,0.18); border-radius: 999px; font-size: 11px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--paper); text-decoration: none; }

      .hero { position: relative; z-index: 2; padding: 80px 20px; max-width: 1280px; margin: 0 auto; text-align: center; }

      .pill { display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; background: rgba(255,255,255,0.08); backdrop-filter: blur(20px) saturate(160%); -webkit-backdrop-filter: blur(20px) saturate(160%); border: 1px solid rgba(255,255,255,0.18); border-radius: 999px; font-size: 11px; font-weight: 800; letter-spacing: 0.18em; text-transform: uppercase; color: var(--turq-paler); }
      .pill .pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--turq-light); box-shadow: 0 0 12px var(--turq-light); animation: pulse 2s infinite; }
      @keyframes pulse { 50% { opacity: 0.5; transform: scale(1.3); } }

      h1 { font-family: 'Sora', sans-serif; font-weight: 900; font-size: clamp(48px, 9vw, 124px); letter-spacing: -0.05em; line-height: 0.94; margin-top: 24px; }
      h1 .grad { background: linear-gradient(115deg, var(--turq-light), white, var(--turq-paler)); -webkit-background-clip: text; background-clip: text; color: transparent; }

      .sub { margin-top: 24px; font-size: clamp(16px, 2vw, 21px); color: rgba(255,255,255,0.78); max-width: 640px; margin-left: auto; margin-right: auto; line-height: 1.5; font-weight: 500; }

      .glass-card { margin: 48px auto 0; max-width: 900px; padding: 36px; background: rgba(255,255,255,0.07); backdrop-filter: blur(28px) saturate(180%); -webkit-backdrop-filter: blur(28px) saturate(180%); border: 1px solid rgba(255,255,255,0.18); border-radius: 28px; box-shadow: 0 20px 80px rgba(0,0,0,0.25); position: relative; overflow: hidden; }
      .glass-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.5), transparent); }

      .cta-row { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; }
      .btn-glass-primary { display: inline-flex; align-items: center; gap: 10px; padding: 18px 32px; background: rgba(94,234,212,0.18); backdrop-filter: blur(16px); border: 1px solid rgba(94,234,212,0.45); border-radius: 999px; color: white; font-weight: 800; font-size: 16px; text-decoration: none; box-shadow: 0 12px 40px rgba(94,234,212,0.25); transition: all 0.3s; }
      .btn-glass-primary:hover { background: rgba(94,234,212,0.3); box-shadow: 0 20px 60px rgba(94,234,212,0.4); transform: translateY(-2px); }
      .btn-glass-primary::after { content: '→'; }
      .btn-glass-ghost { display: inline-flex; align-items: center; gap: 10px; padding: 18px 28px; background: rgba(255,255,255,0.06); backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,0.16); border-radius: 999px; color: white; font-weight: 700; font-size: 15px; text-decoration: none; transition: all 0.3s; }
      .btn-glass-ghost:hover { background: rgba(255,255,255,0.12); }

      .micro { margin-top: 20px; font-size: 13px; color: rgba(255,255,255,0.6); display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
      .micro span::before { content: '✓ '; color: var(--turq-light); font-weight: 800; }

      .stats-glass { margin-top: 24px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
      @media (min-width: 700px) { .stats-glass { grid-template-columns: repeat(4, 1fr); } }
      .sg { padding: 18px; background: rgba(255,255,255,0.05); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.12); border-radius: 18px; }
      .sg .v { font-family: 'Sora', sans-serif; font-weight: 800; font-size: clamp(24px, 3vw, 32px); letter-spacing: -0.02em; background: linear-gradient(120deg, var(--turq-light), white); -webkit-background-clip: text; background-clip: text; color: transparent; font-variant-numeric: tabular-nums; }
      .sg .l { margin-top: 6px; font-size: 11px; color: rgba(255,255,255,0.6); text-transform: uppercase; letter-spacing: 0.12em; font-weight: 700; }

      .feats { padding: 80px 20px; max-width: 1280px; margin: 0 auto; position: relative; z-index: 2; }
      .feats h2 { font-family: 'Sora', sans-serif; font-weight: 800; font-size: clamp(32px, 5vw, 56px); letter-spacing: -0.04em; text-align: center; margin-bottom: 48px; }
      .feats h2 em { font-style: normal; background: linear-gradient(120deg, var(--turq-light), var(--turq-paler)); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .feat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px; }
      .glf { padding: 28px; background: rgba(255,255,255,0.06); backdrop-filter: blur(24px) saturate(180%); border: 1px solid rgba(255,255,255,0.14); border-radius: 22px; transition: all 0.4s; position: relative; overflow: hidden; }
      .glf::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.45), transparent); }
      .glf:hover { transform: translateY(-4px); background: rgba(255,255,255,0.1); border-color: rgba(94,234,212,0.4); box-shadow: 0 20px 60px rgba(20,184,166,0.18); }
      .glf .ic { width: 48px; height: 48px; border-radius: 14px; background: linear-gradient(135deg, var(--turq) 0%, var(--purple) 100%); display: flex; align-items: center; justify-content: center; font-size: 22px; box-shadow: 0 8px 24px rgba(20,184,166,0.35); }
      .glf .t { font-family: 'Sora', sans-serif; font-weight: 700; font-size: 20px; letter-spacing: -0.02em; margin-top: 18px; }
      .glf .d { margin-top: 8px; font-size: 14px; color: rgba(255,255,255,0.7); line-height: 1.5; }

      .footer { padding: 32px 20px; text-align: center; font-size: 12px; color: rgba(255,255,255,0.5); position: relative; z-index: 2; }
      .footer a { color: rgba(255,255,255,0.75); text-decoration: none; margin: 0 8px; }
      .footer a:hover { color: white; }

      @media (prefers-reduced-motion: reduce) { .a-blob { animation: none !important; } }
    </style>
  </head>
  <body>
    <div class="aurora">
      <div class="a-blob a1"></div>
      <div class="a-blob a2"></div>
      <div class="a-blob a3"></div>
    </div>

    <a class="nav-back" href="/lab/"><img src="https://sims.zymplo.com/brand/isotipo.svg" alt="Zymplo" />← Lab</a>
    <a class="lab-badge" href="/lab/">08 · Glassmorph</a>

    <main class="hero">
      <span class="pill"><span class="pulse"></span>EN VIVO · 13 PAÍSES</span>
      <h1>Cobrá. Sin perseguir.<br/><span class="grad">La IA hace todo.</span></h1>
      <p class="sub">Tu secretaria IA dentro de WhatsApp. Cobra · factura · agenda · organiza. Sin app · sin signup · sin fricción.</p>

      <div class="glass-card">
        <div class="cta-row">
          <a class="btn-glass-primary" href="https://wa.me/595981970735?text=Quiero%20probar%20Zymplo">Empezar gratis</a>
          <a class="btn-glass-ghost" href="#feats">Ver cómo funciona</a>
        </div>
        <div class="micro"><span>Sin app</span><span>Sin registro</span><span>Gratis para siempre</span></div>

        <div class="stats-glass">
          <div class="sg"><div class="v">$ 47.28M</div><div class="l">cobrados / mes</div></div>
          <div class="sg"><div class="v">12.847</div><div class="l">activos hoy</div></div>
          <div class="sg"><div class="v">13</div><div class="l">países</div></div>
          <div class="sg"><div class="v">847</div><div class="l">se sumaron hoy</div></div>
        </div>
      </div>
    </main>

    <section class="feats" id="feats">
      <h2>Todo lo que <em>odiás hacer</em>.<br/>Sin que lo pidas.</h2>
      <div class="feat-grid">
        <div class="glf"><div class="ic">💸</div><div class="t">Cobra sin perseguir</div><div class="d">Detecta facturas vencidas. Manda recordatorios calientes que cobran. Te avisa cuando entró la plata.</div></div>
        <div class="glf"><div class="ic">🧾</div><div class="t">Facturá hablando</div><div class="d">"Hacé factura a Pablo por 850.000". Listo. NFS-e · CFDI · DIAN · AFIP · todo según tu país.</div></div>
        <div class="glf"><div class="ic">📅</div><div class="t">Agenda en tu cabeza</div><div class="d">"Recordame mañana 9 ir al taller". Llega el aviso. Punto. Nunca olvidás nada.</div></div>
        <div class="glf"><div class="ic">📊</div><div class="t">Resumen al toque</div><div class="d">"¿Cómo voy este mes?". Te muestra entró · falta · gastaste. En segundos. Sin abrir nada.</div></div>
        <div class="glf"><div class="ic">🌎</div><div class="t">13 países · 3 idiomas</div><div class="d">PT · ES · EN. Tu moneda · tus impuestos · tu jerga local. Sin reaprender nada.</div></div>
        <div class="glf"><div class="ic">⚡</div><div class="t">24/7 sin parar</div><div class="d">Zé no duerme · no se enferma · no se va de vacaciones. Trabaja por vos siempre.</div></div>
      </div>
    </section>

    <footer class="footer">
      © 2026 Zymplo · Glassmorphism Edition · <a href="/lab/">Lab</a> · <a href="/">Landing</a> · <a href="/lab/v09/">V09 →</a>
    </footer>
  </body>
</html>
