---
const title = 'Zymplo · Login';
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>{title}</title>
  <meta name="description" content="Acceso a tu cuenta Zymplo">
  <link rel="icon" href="/brand/isotipo.svg">
  <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png">
  <link rel="stylesheet" href="/brand/brand-guidelines/brand-tokens.css">
  <style>
    body { font-family: Manrope, system-ui, sans-serif; background: #FAFBFF; color: #0A0B14; margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 24px; }
    .card { max-width: 420px; width: 100%; background: white; border-radius: 16px; padding: 32px; box-shadow: 0 4px 24px rgba(10,11,20,0.06); }
    .iso { width: 56px; height: 56px; margin: 0 auto 16px; display: block; }
    h1 { color: #14B8A6; font-size: 24px; margin: 0 0 8px; text-align: center; }
    p.sub { color: #475569; text-align: center; margin: 0 0 24px; }
    label { font-weight: 600; font-size: 14px; display: block; margin-bottom: 6px; }
    input[type=tel], input[type=email] { width: 100%; box-sizing: border-box; padding: 12px 14px; border: 1px solid #E2E8F0; border-radius: 10px; font-size: 16px; font-family: inherit; }
    input:focus { outline: 2px solid #14B8A6; border-color: #14B8A6; }
    button { width: 100%; background: #14B8A6; color: white; border: none; padding: 14px; font-size: 16px; font-weight: 700; border-radius: 10px; margin-top: 16px; cursor: pointer; font-family: inherit; }
    button:hover { background: #0F9488; }
    button:disabled { background: #94A3B8; cursor: not-allowed; }
    .footer { text-align: center; color: #94A3B8; font-size: 12px; margin-top: 24px; }
    .footer a { color: #14B8A6; text-decoration: none; }
    .msg { padding: 12px; border-radius: 8px; margin-top: 12px; font-size: 14px; display: none; }
    .msg.ok { background: #D1FAE5; color: #065F46; display: block; }
    .msg.err { background: #FEE2E2; color: #991B1B; display: block; }
  </style>
</head>
<body>
  <div class="card">
    <img class="iso" src="/brand/isotipo.svg" alt="Zymplo">
    <h1>Bienvenido</h1>
    <p class="sub">Te mandamos un link a tu WhatsApp · 1 tap y entrás</p>
    <form id="login-form">
      <label for="phone">WhatsApp</label>
      <input type="tel" id="phone" name="phone" placeholder="+595981970735" required pattern="\+?[0-9]{8,15}">
      <button type="submit" id="submit-btn">Mandame el link</button>
      <div id="msg" class="msg"></div>
    </form>
    <div class="footer">
      <a href="/">← Volver</a>
    </div>
  </div>

  <script>
    const form = document.getElementById('login-form');
    const msg = document.getElementById('msg');
    const btn = document.getElementById('submit-btn');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btn.disabled = true;
      btn.textContent = 'Mandando...';
      msg.className = 'msg';
      msg.textContent = '';
      const phone = document.getElementById('phone').value.trim().replace(/\s+/g, '').replace(/^\+/, '');
      try {
        const r = await fetch('https://magic.zymplo.com/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ wa_id: phone })
        });
        if (r.ok) {
          msg.className = 'msg ok';
          msg.textContent = 'Listo · revisá tu WhatsApp · te llegó un mensaje del bot Zymplo con el link';
          btn.textContent = 'Link enviado ✓';
        } else {
          msg.className = 'msg err';
          msg.textContent = 'Error · probá de nuevo en unos segundos';
          btn.disabled = false;
          btn.textContent = 'Mandame el link';
        }
      } catch (err) {
        msg.className = 'msg err';
        msg.textContent = 'Sin conexión · revisá internet y reintentá';
        btn.disabled = false;
        btn.textContent = 'Mandame el link';
      }
    });
  </script>
</body>
</html>
