---
import '../styles/tokens.css';
import { getCountry, type CountrySlug, COUNTRY_SLUGS, EU_SLUGS } from '@data/countries';
import { getDict } from '@i18n/index';
import LangSwitcher from '@components/LangSwitcher/LangSwitcher.tsx';
import CookieBanner from '@components/CookieBanner/CookieBanner.tsx';
import Footer from '@components/Footer/Footer.astro';

interface Props { slug: CountrySlug; title?: string; description?: string }
const { slug, title, description } = Astro.props;
const country = getCountry(slug)!;
const dict = getDict(slug);
const isEU = EU_SLUGS.includes(slug);

const pageTitle = title ?? `Zymplo ${country.flag} — ${dict.hero.eyebrow}`;
const pageDesc = description ?? dict.hero.subline;
const canonical = `https://zymplo.com/${slug}/`;
---
<!doctype html>
<html lang={country.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/x-icon" href="https://sims.zymplo.com/brand/favicon.ico" />
    <link rel="apple-touch-icon" href="https://sims.zymplo.com/brand/apple-touch-icon.png" />

    {COUNTRY_SLUGS.map((s) => (
      <link rel="alternate" hreflang={getCountry(s)!.locale} href={`https://zymplo.com/${s}/`} />
    ))}
    <link rel="alternate" hreflang="x-default" href="https://zymplo.com/" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://sims.zymplo.com/brand/og-default.png" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: "Zymplo",
      applicationCategory: "BusinessApplication",
      operatingSystem: "WhatsApp",
      offers: { "@type": "Offer", price: "0", priceCurrency: country.currency.code },
    })} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="font-body bg-paper text-ink">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:bg-ink focus:text-paper focus:px-3 focus:py-2 focus:rounded">Skip to content</a>

    <header class="sticky top-0 z-40 backdrop-blur bg-paper/80 border-b border-ink/5">
      <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href={`/${slug}/`} class="flex items-center gap-2">
          <img src="https://sims.zymplo.com/brand/isotipo.svg" alt="Zymplo" class="h-7 w-7" />
          <span class="font-display font-bold text-xl tracking-tighter">zymplo</span>
        </a>
        <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-slate">
          <a href="#features">{dict.nav.product}</a>
          <a href="#pricing">{dict.nav.pricing}</a>
          <a href="#">{dict.nav.integrations}</a>
          <a href="#">{dict.nav.resources}</a>
        </nav>
        <div class="flex items-center gap-3">
          <LangSwitcher client:load currentSlug={slug} />
          <a href="#cta" class="hidden sm:inline-flex bg-turquesa hover:bg-turquesa-dark text-white font-semibold text-sm px-4 py-2 rounded-full transition">{dict.nav.cta}</a>
        </div>
      </div>
    </header>

    <main id="main"><slot /></main>

    <Footer slug={slug} />

    {isEU && <CookieBanner client:idle />}
  </body>
</html>
