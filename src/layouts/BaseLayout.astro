---
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Zymplo é o assistente operacional dos microempreendedores brasileiros. Direto no WhatsApp. Capta clientes, organiza serviços e responde em segundos.',
  ogImage = '/og-image.png',
  noindex = false,
} = Astro.props;

const fullTitle = title === 'Zymplo' ? 'Zymplo · Assistente operacional MEI no WhatsApp' : `${title} · Zymplo`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://zymplo.com').toString();
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site ?? 'https://zymplo.com').toString()} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Zymplo" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site ?? 'https://zymplo.com').toString()} />

    <meta name="theme-color" content="#14B8A6" />
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
