# Zymplo · CF Pages _headers · R100 web-speed + security hardening
# Updated 2026-05-25

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  Content-Security-Policy: default-src 'self' https:; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https:;
  X-DNS-Prefetch-Control: on

# Static assets · 1 year cache
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=86400

/isotipo.svg
  Cache-Control: public, max-age=86400

/manifest.webmanifest
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json

# Images · long cache
/*.svg
  Cache-Control: public, max-age=86400

/*.png
  Cache-Control: public, max-age=2592000

/*.webp
  Cache-Control: public, max-age=2592000

/*.jpg
  Cache-Control: public, max-age=2592000

# Videos · medium cache
/videos/*
  Cache-Control: public, max-age=2592000

# Machine-readable AI files · short cache (frequent updates expected)
/llms.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8

/pricing.md
  Cache-Control: public, max-age=3600
  Content-Type: text/markdown; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=3600

# HTML pages · short cache (content updates)
/*.html
  Cache-Control: public, max-age=60, must-revalidate

# JSON-LD endpoint · medium cache
/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8

# Deep links · .well-known (T7a MVP)
/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=3600

/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600
