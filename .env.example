# Zymplo web · environment variables (zymplo.com)
# Copy to `.env` and fill in real values · NEVER commit `.env` (gitignored).

# === Tracking Pixels (CRM-14) ===
# TikTok Pixel ID · obtenido en https://ads.tiktok.com/i18n/pixel/manage
# Ejemplo: PUBLIC_TIKTOK_PIXEL_ID=C9XXXXXXXXXXX
PUBLIC_TIKTOK_PIXEL_ID=

# Meta (Facebook) Pixel ID · obtenido en Meta Events Manager
# Ejemplo: PUBLIC_META_PIXEL_ID=1234567890123456
PUBLIC_META_PIXEL_ID=

# Google Ads Conversion ID · obtenido en Google Ads → Tools → Measurement → Conversions
# Ejemplo: PUBLIC_GOOGLE_ADS_ID=AW-12345678
PUBLIC_GOOGLE_ADS_ID=
